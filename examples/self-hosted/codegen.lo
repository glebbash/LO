fn CodeGenerator::codegen_fn_call(
    &self,
    ctx: &ExprContext,
    instrs: &Vec(WasmInstr),
    fn_index: u32,
    receiver_arg: &?CodeExpr,
    args: &Vec(CodeExpr),
) {
    let fn_info = self.registry.functions.at!(fn_index)

    if receiver_arg != null {
        self.codegen(ctx, instrs, *receiver_arg)
    }
    for arg in args.iter!() {
        self.codegen(ctx, instrs, arg)
    }

    instrs.push!(WasmInstr::Call(
        self.wasm_module.arena.new!(WasmInstrCall { fn_index: fn_info.wasm_fn_index }),
    ))
}

