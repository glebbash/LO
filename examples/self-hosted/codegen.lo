@include("./common.lo")
@include("./wasm.lo")

// temporary container for compiled instructions
type CompiledExpr = &Vec(WasmInstr)

type VarInfo = enum (&void) {
    Local(&VarInfoLocal),
    Global(&VarInfoGlobal),
    Const(&VarInfoConst),
    PayloadlessEnum(&VarInfoPayloadlessEnum),
    Stored(&VarInfoStored),
    StructValueField(&VarInfoStructValueField),
}

type VarInfoLocal = struct {
    local_index: u32,
    var_type_id: TypeId,
}

type VarInfoGlobal = struct {
    global_index: u32,
    var_type_id: TypeId,
}

type VarInfoConst = struct {
    const_def: &ConstDef,
}

type VarInfoPayloadlessEnum = struct {
    variant_tag_value: i32,
    variant_type_id: TypeId,
}

type VarInfoStored = struct {
    address_instrs: CompiledExpr,
    offset: u32,
    var_type_id: TypeId,
}

type VarInfoStructValueField = struct {
    lhs_instrs: CompiledExpr,
    drops_before: u32,
    drops_after: u32,
    var_type_id: TypeId,
}

type Scope = struct {
    kind: ScopeKind,
    deferred_exprs: &Vec(CompiledExpr),
    expr_id_offset: u32,
}

fn Scope::new(scope_kind: ScopeKind): Scope {
    return Scope {
        kind: scope_kind,
        deferred_exprs: Vec::new!<CompiledExpr>(),
        expr_id_offset: 0,
    }
}

type ExprContext = struct {
    module_id: ModuleId,
    fn_index: &?u32,
    addr_local_index: &?u32,
}

fn ExprContext::new(module_id: u32, fn_index: &?u32): &ExprContext {
    return heap::new!(ExprContext {
        module_id: module_id,
        fn_index: fn_index,
        addr_local_index: null,
    })
}

type CodegenModuleInfo = struct {
    scope_stack: &Vec(Scope),
    ctx: ExprContext,
}

type CodeGenerator = struct {
    // context
    registry: &Registry,

    // state
    wasm_fn_types: &Vec(WasmFnType),

    // output
    wasm_module: &WasmModule,
}

fn CodeGenerator::new(registry: &Registry): &CodeGenerator {
    return heap::new!(CodeGenerator {
        registry: registry,
        wasm_fn_types: Vec::new!<WasmFnType>(),
        wasm_module: WasmModule::new(),
    })
}

fn CodeGenerator::codegen_all(&self) {
    // TODO: port

    let fn_imports_count = 0
    for fn_info in self.registry.functions.iter!() {
        if match FnSource::Host(_) = fn_info.source {
            fn_imports_count += 1
        }
    }

    let wasm_import_fn_index = 0
    let wasm_fn_index = fn_imports_count
    for fn_index in 0..self.registry.functions.len {
        let fn_info = self.registry.functions.at!(fn_index)

        let wasm_fn_type = WasmFnType {
            inputs: Vec::new!<WasmType>(),
            outputs: Vec::new!<WasmType>(),
        }
        for input_type in fn_info.type_.inputs.iter!() {
            self.lower_type(self.get_type(input_type), wasm_fn_type.inputs)
        }
        self.lower_type(
            self.get_type(fn_info.type_.output),
            wasm_fn_type.outputs,
        )

        let fn_type_index = self.wasm_fn_types.len
        for existing_type_index in 0..self.wasm_fn_types.len {
            let existing_fn_type = self.wasm_fn_types.get!(existing_type_index)

            // TODO: port
            // if wasm_fn_type == existing_fn_type {
            //     fn_type_index = existing_type_index
            // }
        }
        if fn_type_index == self.wasm_fn_types.len {
            self.wasm_fn_types.push!(wasm_fn_type)
        }

        if match FnSource::Guest(_) = fn_info.source {
            self.wasm_module.functions.push!(fn_type_index)
            self.wasm_module.function_names.push!(WasmFnNameItem {
                fn_index: wasm_fn_index,
                fn_name: String::from_str(fn_info.name),
            })

            fn_info.wasm_fn_index = wasm_fn_index

            wasm_fn_index += 1
        } else if match FnSource::Host(_) = fn_info.source {
            // TODO: port
        } else {
            @unreachable()
        }

        for export_name in fn_info.exported_as.iter!() {
            self.wasm_module.exports.push!(WasmExport {
                export_type: WasmExportType::Func,
                export_name: export_name.clone(),
                exported_item_index: fn_info.wasm_fn_index,
            })
        }
    }

    // TODO: port

    for fn_info in self.registry.functions.iter!() {
        match FnSource::Guest(guest_info) = fn_info.source else {
            continue
        }

        let ctx = ExprContext::new(guest_info.module_id, ref!(guest_info.lo_fn_index))
        let wasm_expr = WasmExpr { instrs: Vec::new!<WasmInstr>() }

        // TODO: port

        self.codegen_code_block(ctx, wasm_expr.instrs, guest_info.body)

        // TODO: port

        let wasm_locals = Vec::new!<WasmLocals>()

        // TODO: port locals other than params

        self.wasm_module.codes.push!(WasmFn {
            locals: wasm_locals,
            expr: wasm_expr,
        })

        // emit debug info for local names
        if true {
            let local_names_item = WasmLocalNameItem {
                fn_index: fn_info.wasm_fn_index,
                locals: Vec::new!<WasmLocalInfo>(),
            }

            for local_id in fn_info.locals_ids.iter!() {
                let local_def = self.registry.locals.at!(local_id)

                if local_def.local_name != null {
                    let _ = self.push_wasm_dbg_name_section_locals(
                        local_names_item.locals,
                        local_def.wasm_local_index,
                        self.get_type(local_def.local_type_id),
                        *local_def.local_name,
                    )
                }
            }

            self.wasm_module.local_names.push!(local_names_item)
        }
    }

    // TODO: port

    self.wasm_module.types.append!(self.wasm_fn_types)
}

fn CodeGenerator::codegen_code_block(
    &self,
    ctx: &ExprContext,
    instrs: &Vec(WasmInstr),
    block: &CodeBlock,
) {
    for expr in block.exprs.iter!() {
        self.codegen(ctx, instrs, expr)
    }

    // TODO: port

    let expr_info = self.get_expr_info(ctx, block.block_expr_id, block.loc)
    let block_info = self.registry.block_info.get!(expr_info)

    if block_info.needs_explicit_trap {
        instrs.push!(WasmInstr::Unreachable)
    }
}

fn CodeGenerator::codegen(
    &self,
    ctx: &ExprContext,
    instrs: &Vec(WasmInstr),
    expr: CodeExpr,
) {
    // TODO: port

    if match CodeExpr::IntLiteral(int) = expr {
        // TODO: port proper

        instrs.push!(WasmInstr::I32Const(
            // TODO: use arena allocation attached to WasmModule
            heap::new!(WasmInstrI32Const { value: int.value as i32 }),
        ))

        return
    }

    // TODO: port

    if match CodeExpr::Return(return_expr) = expr {
        if return_expr.expr != null {
            self.codegen(ctx, instrs, *return_expr.expr)
        }

        self.emit_deferred_for_return(ctx, instrs)
        instrs.push!(WasmInstr::Return)
        return
    }

    if match CodeExpr::InfixOp(infix_op) = expr {
        let expr_info = self.get_expr_info(ctx, infix_op.id, infix_op.loc)
        let op_info = self.registry.binary_op_info.at!(expr_info)

        // TODO: port short-circuiting AND and OR
        // TODO: port compound assignment

        self.codegen(ctx, instrs, infix_op.lhs)
        self.codegen(ctx, instrs, infix_op.rhs)
        instrs.push!(WasmInstr::BinaryOp(
            // TODO: use arena allocation attached to WasmModule
            heap::new!(WasmInstrBinaryOp { kind: op_info.op_kind }),
        ))

        return
    }

    if match CodeExpr::Ident(_) = expr {
        let var = self.var_from_expr(ctx, expr)
        self.codegen_var_get(ctx, instrs, var)
        return
    }

    // TODO: port

    todo!()
}

