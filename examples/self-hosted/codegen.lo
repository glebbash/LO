fn CodeGenerator::codegen_var_set(&self, ctx: &ExprContext, instrs: &Vec(WasmInstr), var: VarInfo) {
    if match VarInfo::Local(local) = var {
        self.codegen_local_set(instrs, self.get_type(local.var_type_id), local.local_index)
        return
    }

    // TODO: port

    todo!()
}

fn CodeGenerator::codegen_local_set(&self, instrs: &Vec(WasmInstr), local_type: Type, local_index: u32) {
    let i = Typer::count_primitive_components(self.registry, local_type)
    while i > 0 {
        i = i - 1
        instrs.push!(WasmInstr::LocalSet(
            self.wasm_module.arena.new!(WasmInstrLocalSet { local_index: local_index + i }),
        ))
    }
}

