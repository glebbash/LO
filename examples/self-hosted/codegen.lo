fn Codegen::codegen_default_value(&self, ctx: &ExprContext, instrs: &Vec(WasmInstr), value_type: Type) {
    if match Type::Never(_) = value_type {
        return
    }
    if match Type::Void(_) = value_type {
        return
    }

    if match Type::Bool(_) = value_type {
        instrs.push!(WasmInstr::I32Const(self.wasm_module.arena.new!(WasmInstrI32Const { value: 0 as i32 })))
        return
    }
    if match Type::U8(_) = value_type {
        instrs.push!(WasmInstr::I32Const(self.wasm_module.arena.new!(WasmInstrI32Const { value: 0 as i32 })))
        return
    }
    if match Type::U32(_) = value_type {
        instrs.push!(WasmInstr::I32Const(self.wasm_module.arena.new!(WasmInstrI32Const { value: 0 as i32 })))
        return
    }
    if match Type::I32(_) = value_type {
        instrs.push!(WasmInstr::I32Const(self.wasm_module.arena.new!(WasmInstrI32Const { value: 0 as i32 })))
        return
    }
    if match Type::Null(_) = value_type {
        instrs.push!(WasmInstr::I32Const(self.wasm_module.arena.new!(WasmInstrI32Const { value: 0 as i32 })))
        return
    }
    if match Type::Pointer(_) = value_type {
        instrs.push!(WasmInstr::I32Const(self.wasm_module.arena.new!(WasmInstrI32Const { value: 0 as i32 })))
        return
    }

    if match Type::U64(_) = value_type {
        instrs.push!(WasmInstr::I64Const(self.wasm_module.arena.new!(WasmInstrI64Const { value: 0i64 })))
        return
    }

    if match Type::Struct(struct_type) = value_type {
        let struct_def = self.registry.structs.at!(struct_type.struct_index)
        for &field in struct_def.fields.iter!() {
            self.codegen_default_value(ctx, instrs, self.get_type(field.field_type_id))
        }
        return
    }

    // TODO: port Enum

    if match Type::Result(result) = value_type {
        self.codegen_default_value(ctx, instrs, self.get_type(result.ok))
        self.codegen_default_value(ctx, instrs, self.get_type(result.err))
        return
    }

    if match Type::Seg(seg) = value_type {
        let ptr_type = Type::Pointer(heap::new!(PointerType {
            pointee: seg.item,
            is_sequence: false,
            is_nullable: false,
        }))
        self.codegen_default_value(ctx, instrs, ptr_type)
        self.codegen_default_value(ctx, instrs, Type::U32)
        return
    }

    if match Type::Container(ctr) = value_type {
        self.codegen_default_value(ctx, instrs, self.get_type(ctr.container))
        return
    }

    // TODO: port
    todo!()
}

fn Codegen::lower_type(&self, type_: Type, wasm_types: &Vec(WasmType)) {
    if match Type::Never(_) = type_ {
        return
    }
    if match Type::Void(_) = type_ {
        return
    }

    // TODO: port

    if match Type::Bool(_) = type_ {
        wasm_types.push!(WasmType::I32)
        return
    }

    if match Type::U8(_) = type_ {
        wasm_types.push!(WasmType::I32)
        return
    }

    if match Type::U16(_) = type_ {
        wasm_types.push!(WasmType::I32)
        return
    }

    if match Type::U32(_) = type_ {
        wasm_types.push!(WasmType::I32)
        return
    }

    if match Type::I32(_) = type_ {
        wasm_types.push!(WasmType::I32)
        return
    }

    if match Type::Pointer(_) = type_ {
        wasm_types.push!(WasmType::I32)
        return
    }

    if match Type::U64(_) = type_ {
        wasm_types.push!(WasmType::I64)
        return
    }

    if match Type::Seg(seg) = type_ {
        let ptr_type = Type::Pointer(heap::new!(PointerType {
            pointee: seg.item,
            is_sequence: false,
            is_nullable: false,
        }))
        self.lower_type(Type::U32, wasm_types)
        self.lower_type(ptr_type, wasm_types)
        return
    }

    if match Type::Struct(struct_type) = type_ {
        let struct_def = self.registry.structs.at!(struct_type.struct_index)
        for &field in struct_def.fields.iter!() {
            self.lower_type(self.get_type(field.field_type_id), wasm_types)
        }
        return
    }

    // TODO: port Enum

    if match Type::Result(result) = type_ {
        self.lower_type(self.get_type(result.ok), wasm_types)
        self.lower_type(self.get_type(result.err), wasm_types)
        return
    }

    if match Type::Container(ctr) = type_ {
        self.lower_type(self.get_type(ctr.container), wasm_types)
        return
    }

    // TODO: port

    todo!()
}

fn Codegen::enter_scope(&self, ctx: &ExprContext, scope_type: ScopeKind) {
    let module = self.module_info.at!(ctx.module_id)

    self.init_scope_from_parent_and_push(module.scope_stack, scope_type)
}

fn Codegen::exit_scope(&self, ctx: &ExprContext) {
    self.module_info.at!(ctx.module_id).scope_stack.pop()
}

fn Codegen::current_scope(&self, ctx: &ExprContext): &Scope {
    let module = self.module_info.at!(ctx.module_id)

    return module.scope_stack.at!(module.scope_stack.len - 1)
}

fn Codegen::init_scope_from_parent_and_push(&self, scope_stack: &Vec(Scope), scope_type: ScopeKind) {
    let new_scope = Scope::new(scope_type)
    if scope_stack.len > 0 {
        let parent = scope_stack.at!(scope_stack.len - 1)
        new_scope.expr_id_offset = parent.expr_id_offset
    }
    scope_stack.push!(new_scope)
}

fn Codegen::push_wasm_dbg_name_section_locals(
    &self,
    output: &Vec(WasmLocalInfo),
    local_index: u32,
    local_type: Type,
    local_name: str,
): u32 {
    if match Type::Never(_) = local_type {
        return local_index // skip
    }
    if match Type::Void(_) = local_type {
        return local_index // skip
    }

    // TODO: port

    if match Type::Bool(_) = local_type {
        output.push!(WasmLocalInfo {
            local_index: local_index,
            local_name: String::from_str(local_name),
        })
        return local_index + 1
    }

    if match Type::U8(_) = local_type {
        output.push!(WasmLocalInfo {
            local_index: local_index,
            local_name: String::from_str(local_name),
        })
        return local_index + 1
    }

    if match Type::U32(_) = local_type {
        output.push!(WasmLocalInfo {
            local_index: local_index,
            local_name: String::from_str(local_name),
        })
        return local_index + 1
    }

    if match Type::I32(_) = local_type {
        output.push!(WasmLocalInfo {
            local_index: local_index,
            local_name: String::from_str(local_name),
        })
        return local_index + 1
    }

    if match Type::U64(_) = local_type {
        output.push!(WasmLocalInfo {
            local_index: local_index,
            local_name: String::from_str(local_name),
        })
        return local_index + 1
    }

    if match Type::Pointer(_) = local_type {
        output.push!(WasmLocalInfo {
            local_index: local_index,
            local_name: String::from_str(local_name),
        })
        return local_index + 1
    }

    if match Type::Struct(struct_type) = local_type {
        let struct_def = self.registry.structs.at!(struct_type.struct_index)
        for &field in struct_def.fields.iter!() {
            let field_local_name = String::new_in(self.registry.error_arena, 16)
            do field_local_name.push_str(it) with (local_name, ".", field.field_name)

            local_index = self.push_wasm_dbg_name_section_locals(
                output,
                local_index,
                self.get_type(field.field_type_id),
                field_local_name.as_str(),
            )
        }
        return local_index
    }

    // TODO: port Enum

    if match Type::Result(result) = local_type {
        let ok_local_name = String::new_in(self.registry.error_arena, 16)
        do ok_local_name.push_str(it) with (local_name, "#ok")

        local_index = self.push_wasm_dbg_name_section_locals(
            output,
            local_index,
            self.get_type(result.ok),
            ok_local_name.as_str(),
        )

        let err_local_name = String::new_in(self.registry.error_arena, 16)
        do err_local_name.push_str(it) with (local_name, "#err")

        local_index = self.push_wasm_dbg_name_section_locals(
            output,
            local_index,
            self.get_type(result.err),
            err_local_name.as_str(),
        )

        return local_index
    }

    if match Type::Seg(seg) = local_type {
        let ptr_type = Type::Pointer(heap::new!(PointerType {
            pointee: seg.item,
            is_sequence: false,
            is_nullable: false,
        }))

        let len_local_name = String::new_in(self.registry.error_arena, 16)
        do len_local_name.push_str(it) with (local_name, ".len")

        local_index = self.push_wasm_dbg_name_section_locals(
            output,
            local_index,
            Type::U32,
            len_local_name.as_str(),
        )

        let ptr_local_name = String::new_in(self.registry.error_arena, 16)
        do ptr_local_name.push_str(it) with (local_name, ".ptr")

        local_index = self.push_wasm_dbg_name_section_locals(
            output,
            local_index,
            ptr_type,
            ptr_local_name.as_str(),
        )

        return local_index
    }

    if match Type::Container(ctr) = local_type {
        return self.push_wasm_dbg_name_section_locals(
            output,
            local_index,
            self.get_type(ctr.container),
            local_name,
        )
    }

    // TODO: port

    todo!()
}

fn Codegen::get_expr_type(&self, ctx: &ExprContext, expr: CodeExpr): Type {
    let scope = self.current_scope(ctx)
    let type_id = self.registry.get_expr_type(scope.expr_id_offset, expr)
    if type_id == null {
        self.registry.reporter.abort_due_to_compiler_bug("Untyped code expression", expr.loc())
    }
    return self.get_type(*type_id)
}

fn Codegen::get_type_expr_value(&self, ctx: &ExprContext, expr: TypeExpr): Type {
    let type_id = self.get_expr_info(ctx, expr.id(), expr.loc())
    return self.get_type(type_id)
}

fn Codegen::get_expr_info(
    &self,
    ctx: &ExprContext,
    expr_id: u32,
    expr_loc: Loc,
): ExprId {
    let scope = self.current_scope(ctx)
    let expr_info = self.registry.get_expr_info(scope.expr_id_offset, expr_id)
    if expr_info == null {
        self.registry.reporter.abort_due_to_compiler_bug("Untyped expression", expr_loc)
    }

    return *expr_info
}

fn Codegen::get_type(&self, type_id: u32): Type {
    return self.registry.get_type(type_id)
}

fn Codegen::get_cast_instr(casted_from: Type, casted_to: Type): Result(WasmInstr, &VoidError) {
    let to_is_wide = false
    if match Type::I64(_) = casted_to {
        to_is_wide = true
    }
    if match Type::U64(_) = casted_to {
        to_is_wide = true
    }

    if to_is_wide {
        if match Type::I8(_) = casted_from {
            return Ok(WasmInstr::I64ExtendI32s)
        }
        if match Type::I16(_) = casted_from {
            return Ok(WasmInstr::I64ExtendI32s)
        }
        if match Type::I32(_) = casted_from {
            return Ok(WasmInstr::I64ExtendI32s)
        }

        if match Type::U8(_) = casted_from {
            return Ok(WasmInstr::I64ExtendI32u)
        }
        if match Type::U16(_) = casted_from {
            return Ok(WasmInstr::I64ExtendI32u)
        }
        if match Type::U32(_) = casted_from {
            return Ok(WasmInstr::I64ExtendI32u)
        }
    }

    let to_is_narrow = false
    if match Type::I8(_) = casted_to {
        to_is_narrow = true
    }
    if match Type::U8(_) = casted_to {
        to_is_narrow = true
    }
    if match Type::I16(_) = casted_to {
        to_is_narrow = true
    }
    if match Type::U16(_) = casted_to {
        to_is_narrow = true
    }
    if match Type::I32(_) = casted_to {
        to_is_narrow = true
    }
    if match Type::U32(_) = casted_to {
        to_is_narrow = true
    }

    if to_is_narrow {
        if match Type::I64(_) = casted_from {
            return Ok(WasmInstr::I32WrapI64)
        }
        if match Type::U64(_) = casted_from {
            return Ok(WasmInstr::I32WrapI64)
        }
    }

    return Err(VoidError::VALUE)
}
