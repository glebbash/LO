@include("./common.lo")
@include("./wasm.lo")

// temporary container for compiled instructions
type CompiledExpr = &Vec(WasmInstr)

type VarInfo = enum (&void) {
    Local(&VarInfoLocal),
    Global(&VarInfoGlobal),
    Const(&VarInfoConst),
    PayloadlessEnum(&VarInfoPayloadlessEnum),
    Stored(&VarInfoStored),
    StructValueField(&VarInfoStructValueField),
}

type VarInfoLocal = struct {
    local_index: u32,
    var_type_id: TypeId,
}

type VarInfoGlobal = struct {
    global_index: u32,
    var_type_id: TypeId,
}

type VarInfoConst = struct {
    const_def: &ConstDef,
}

type VarInfoPayloadlessEnum = struct {
    variant_tag_value: i32,
    variant_type_id: TypeId,
}

type VarInfoStored = struct {
    address_instrs: CompiledExpr,
    offset: u32,
    var_type_id: TypeId,
}

type VarInfoStructValueField = struct {
    lhs_instrs: CompiledExpr,
    drops_before: u32,
    drops_after: u32,
    var_type_id: TypeId,
}

type Scope = struct {
    kind: ScopeKind,
    deferred_exprs: &Vec(CompiledExpr),
    expr_id_offset: u32,
}

fn Scope::new(scope_kind: ScopeKind): Scope {
    return Scope {
        kind: scope_kind,
        deferred_exprs: Vec::new!<CompiledExpr>(),
        expr_id_offset: 0,
    }
}

type ExprContext = struct {
    module_id: ModuleId,
    fn_index: &?u32,
    addr_local_index: &?u32,
}

fn ExprContext::new(module_id: u32, fn_index: &?u32): &ExprContext {
    return heap::new!(ExprContext {
        module_id: module_id,
        fn_index: fn_index,
        addr_local_index: null,
    })
}

type CodegenModuleInfo = struct {
    scope_stack: &Vec(Scope),
    ctx: ExprContext,
}

type Codegen = struct {
    // context
    registry: &Registry,

    // state
    wasm_fn_types: &Vec(WasmFnType),
    module_info: &Vec(CodegenModuleInfo),

    // output
    wasm_module: &WasmModule,
}

fn Codegen::new(registry: &Registry): &Codegen {
    return heap::new!(Codegen {
        registry: registry,
        wasm_fn_types: Vec::new!<WasmFnType>(),
        module_info: Vec::new!<CodegenModuleInfo>(),
        wasm_module: WasmModule::new(),
    })
}

fn Codegen::codegen_all(&self) {
    for module in self.registry.modules.iter!() {
        self.module_info.push!(CodegenModuleInfo {
            scope_stack: Vec::new!<Scope>(),
            ctx: *ExprContext::new(module.id, null),
        })

        self.module_info.at!(self.module_info.len - 1) \
            .scope_stack.push!(Scope::new(ScopeKind::Global))
    }

    let fn_imports_count = 0
    for fn_info in self.registry.functions.iter!() {
        if match FnSource::Host(_) = fn_info.source {
            fn_imports_count += 1
        }
    }

    // resolve wasm fn indicies and populate type, import and export sections
    let wasm_import_fn_index = 0
    let wasm_fn_index = fn_imports_count
    for fn_index in 0..self.registry.functions.len {
        let fn_info = self.registry.functions.at!(fn_index)

        let wasm_fn_type = WasmFnType {
            inputs: Vec::new!<WasmType>(),
            outputs: Vec::new!<WasmType>(),
        }
        for input_type in fn_info.type_.inputs.iter!() {
            self.lower_type(self.get_type(input_type), wasm_fn_type.inputs)
        }
        self.lower_type(
            self.get_type(fn_info.type_.output),
            wasm_fn_type.outputs,
        )

        let fn_type_index = self.wasm_fn_types.len
        for existing_type_index in 0..self.wasm_fn_types.len {
            let existing_fn_type = self.wasm_fn_types.get!(existing_type_index)

            if wasm_fn_type.equals(existing_fn_type) {
                fn_type_index = existing_type_index
            }
        }
        if fn_type_index == self.wasm_fn_types.len {
            self.wasm_fn_types.push!(wasm_fn_type)
        }

        if match FnSource::Guest(_) = fn_info.source {
            self.wasm_module.functions.push!(fn_type_index)
            self.wasm_module.function_names.push!(WasmFnNameItem {
                fn_index: wasm_fn_index,
                fn_name: String::from_str(fn_info.name),
            })

            fn_info.wasm_fn_index = wasm_fn_index

            wasm_fn_index += 1
        } else if match FnSource::Host(host_info) = fn_info.source {
            fn_info.wasm_fn_index = wasm_import_fn_index

            self.wasm_module.imports.push!(WasmImport {
                module_name: host_info.module_name.clone(),
                item_name: String::from_str(host_info.external_fn_name),
                item_desc: WasmImportDesc::Func(self.wasm_module.arena.new!(WasmImportDescFn {
                    type_index: fn_type_index,
                })),
            })
            wasm_import_fn_index += 1
        } else {
            @unreachable()
        }

        for export_name in fn_info.exported_as.iter!() {
            self.wasm_module.exports.push!(WasmExport {
                export_type: WasmExportType::Func,
                export_name: export_name.clone(),
                exported_item_index: fn_info.wasm_fn_index,
            })
        }
    }

    // build global initializers and update global indices
    let wasm_global_index = 0
    for global_index in 0..self.registry.globals.len {
        let global = self.registry.globals.at!(global_index)
        global.wasm_global_index = wasm_global_index

        let wasm_types = Vec::new!<WasmType>()
        self.lower_type(self.get_type(global.type_id), wasm_types)

        let instrs = Vec::new!<WasmInstr>()
        self.codegen(&self.module_info.at!(global.module_id).ctx, instrs, global.value)

        for i in 0..wasm_types.len {
            let wasm_type = wasm_types.get!(i)
            let instr = instrs.get!(i)

            let initial_value = WasmExpr { instrs: Vec::new!<WasmInstr>() }
            initial_value.instrs.push!(instr)

            self.wasm_module.globals.push!(WasmGlobal {
                mutable: true,
                value_type: wasm_type,
                initial_value: initial_value,
            })
        }

        wasm_global_index += wasm_types.len
    }

    // build function codes
    for fn_info in self.registry.functions.iter!() {
        match FnSource::Guest(guest_info) = fn_info.source else {
            continue
        }

        let ctx = ExprContext::new(guest_info.module_id, ref!(guest_info.lo_fn_index))
        let wasm_expr = WasmExpr { instrs: Vec::new!<WasmInstr>() }

        self.enter_scope(ctx, ScopeKind::Function)

        self.codegen_code_block(ctx, wasm_expr.instrs, guest_info.body)

        self.exit_scope(ctx)

        let wasm_locals_flat = Vec::new!<WasmType>()

        for i in fn_info.params.len..fn_info.locals_ids.len {
            let local_id = fn_info.locals_ids.get!(i)
            let local_def = self.registry.locals.at!(local_id)
            self.lower_type(self.get_type(local_def.local_type_id), wasm_locals_flat)
        }

        let wasm_locals = Vec::new!<WasmLocals>()

        for wasm_local_type in wasm_locals_flat.iter!() {
            if wasm_locals.len > 0u32 {
                let last = wasm_locals.at!(wasm_locals.len - 1u32)
                if last.value_type == wasm_local_type {
                    last.count += 1u32
                    continue
                }
            }
            wasm_locals.push!(WasmLocals {
                count: 1u32,
                value_type: wasm_local_type,
            })
        }

        self.wasm_module.codes.push!(WasmFn {
            locals: wasm_locals,
            expr: wasm_expr,
        })

        // emit debug info for local names
        if true {
            let local_names_item = WasmLocalNameItem {
                fn_index: fn_info.wasm_fn_index,
                locals: Vec::new!<WasmLocalInfo>(),
            }

            for local_id in fn_info.locals_ids.iter!() {
                let local_def = self.registry.locals.at!(local_id)

                if local_def.local_name != null {
                    let _ = self.push_wasm_dbg_name_section_locals(
                        local_names_item.locals,
                        local_def.wasm_local_index,
                        self.get_type(local_def.local_type_id),
                        *local_def.local_name,
                    )
                }
            }

            self.wasm_module.local_names.push!(local_names_item)
        }
    }

    // patch @data_size values in globals
    let data_size_instr = WasmInstr::I32Const(
        self.wasm_module.arena.new!(WasmInstrI32Const { value: self.registry.data_size as i32 }),
    )
    for &global in self.registry.globals.iter!() {
        match CodeExpr::IntrinsicCall(intrinsic) = global.value else {
            continue
        }

        if !intrinsic.fn_name.repr.equals("data_size") {
            continue
        }

        self.wasm_module.globals.at!(global.wasm_global_index) \
            .initial_value.instrs.set!(0, data_size_instr)
    }

    // TODO: port

    if self.registry.memory_info != null {
        let memory = *self.registry.memory_info

        let min = 0
        if memory.min_pages != null {
            min = *memory.min_pages
        }

        let limits = WasmLimits {
            min: min,
            max: null,
        }

        if memory.imported_from != null {
            self.wasm_module.imports.push!(WasmImport {
                module_name: (*memory.imported_from).clone(),
                item_name: String::from_str("memory"),
                item_desc: WasmImportDesc::Memory(self.wasm_module.arena.new!(limits)),
            })
        } else {
            self.wasm_module.memories.push!(limits)
        }

        if memory.exported {
            self.wasm_module.exports.push!(WasmExport {
                export_type: WasmExportType::Mem,
                export_name: String::from_str("memory"),
                exported_item_index: 0,
            })
        }
    }

    self.wasm_module.datas.append!(self.registry.datas)
    self.wasm_module.types.append!(self.wasm_fn_types)
}

fn Codegen::codegen_code_block(
    &self,
    ctx: &ExprContext,
    instrs: &Vec(WasmInstr),
    block: &CodeBlock,
) {
    for expr in block.exprs.iter!() {
        self.codegen(ctx, instrs, expr)
    }

    // TODO: port

    let expr_info = self.get_expr_info(ctx, block.block_expr_id, block.loc)
    let block_info = self.registry.block_info.get!(expr_info)

    if block_info.needs_explicit_trap {
        instrs.push!(WasmInstr::Unreachable)
    }
}

fn Codegen::codegen(
    &self,
    ctx: &ExprContext,
    instrs: &Vec(WasmInstr),
    expr: CodeExpr,
) {
    // TODO: port

    if match CodeExpr::NullLiteral(_) = expr {
        instrs.push!(WasmInstr::I32Const(
            self.wasm_module.arena.new!(WasmInstrI32Const { value: 0 as i32 }),
        ))
        return
    }

    if match CodeExpr::IntLiteral(int) = expr {
        let is_wide = Typer::is_wide_int(self.get_expr_type(ctx, expr))
        if is_wide.ok {
            instrs.push!(WasmInstr::I64Const(
                self.wasm_module.arena.new!(WasmInstrI64Const { value: int.value as i64 }),
            ))
        } else {
            instrs.push!(WasmInstr::I32Const(
                self.wasm_module.arena.new!(WasmInstrI32Const { value: int.value as i32 }),
            ))
        }

        return
    }

    if match CodeExpr::BoolLiteral(bool_literal) = expr {
        let value = 0 as i32
        if bool_literal.value {
            value = 1 as i32
        }
        instrs.push!(WasmInstr::I32Const(
            self.wasm_module.arena.new!(WasmInstrI32Const { value: value }),
        ))
        return
    }

    if match CodeExpr::CharLiteral(char_literal) = expr {
        instrs.push!(WasmInstr::I32Const(
            self.wasm_module.arena.new!(WasmInstrI32Const { value: char_literal.value as i32 }),
        ))
        return
    }

    if match CodeExpr::StringLiteral(str_literal) = expr {
        let expr_info = self.get_expr_info(ctx, str_literal.id, str_literal.loc)
        let stored_bytes = self.registry.stored_bytes.at!(expr_info)

        instrs.push!(WasmInstr::I32Const(
            self.wasm_module.arena.new!(WasmInstrI32Const { value: stored_bytes.info.ptr as i32 }),
        ))
        instrs.push!(WasmInstr::I32Const(
            self.wasm_module.arena.new!(WasmInstrI32Const { value: stored_bytes.info.len as i32 }),
        ))
        return
    }

    if match CodeExpr::StructLiteral(struct_literal) = expr {
        for field in struct_literal.body.fields.iter!() {
            self.codegen(ctx, instrs, field.value)
        }
        return
    }

    if match CodeExpr::ArrayLiteral(array_literal) = expr {
        let expr_info = self.get_expr_info(ctx, array_literal.id, array_literal.loc)
        let stored_bytes = self.registry.stored_bytes.at!(expr_info)

        instrs.push!(WasmInstr::I32Const(
            self.wasm_module.arena.new!(WasmInstrI32Const { value: stored_bytes.info.ptr as i32 }),
        ))
        instrs.push!(WasmInstr::I32Const(
            self.wasm_module.arena.new!(WasmInstrI32Const { value: stored_bytes.info.len as i32 }),
        ))
        return
    }

    if match CodeExpr::ResultLiteral(result_literal) = expr {
        match Type::Result(result) = self.get_expr_type(ctx, expr) else {
            @unreachable()
        }

        if result_literal.is_ok {
            if result_literal.value != null {
                self.codegen(ctx, instrs, *result_literal.value)
            }

            // error value
            instrs.push!(WasmInstr::I32Const(
                self.wasm_module.arena.new!(WasmInstrI32Const { value: 0 as i32 }),
            ))

            return
        }

        self.codegen_default_value(ctx, instrs, self.get_type(result.ok))
        self.codegen(ctx, instrs, *result_literal.value)

        return
    }

    if match CodeExpr::Let(let_expr) = expr {
        if let_expr.is_inline {
            // was handled in typer
            return
        }

        let var_type = self.get_expr_type(ctx, let_expr.value)

        if let_expr.name.repr.equals("_") {
            self.codegen(ctx, instrs, let_expr.value)

            for i in 0..Typer::count_primitive_components(self.registry, var_type) {
                instrs.push!(WasmInstr::Drop)
            }
            return
        }

        let local = self.get_local_info(ctx, let_expr.name.id, let_expr.name.loc)
        self.codegen(ctx, instrs, let_expr.value)
        self.codegen_local_set(instrs, self.get_type(local.var_type_id), local.local_index)
        return
    }

    if match CodeExpr::Fn(_) = expr {
        // nested fn, nothing to emit here
        return
    }

    // TODO: port

    if match CodeExpr::Return(return_expr) = expr {
        if return_expr.expr != null {
            self.codegen(ctx, instrs, *return_expr.expr)
        }

        self.emit_deferred_for_return(ctx, instrs)
        instrs.push!(WasmInstr::Return)
        return
    }

    if match CodeExpr::InfixOp(infix_op) = expr {
        let expr_info = self.get_expr_info(ctx, infix_op.id, infix_op.loc)
        let op_info = self.registry.binary_op_info.at!(expr_info)

        // short-circuiting AND
        if infix_op.op_tag == InfixOpTag::And {
            self.codegen(ctx, instrs, infix_op.lhs)
            instrs.push!(WasmInstr::BlockStart(
                self.wasm_module.arena.new!(WasmInstrBlockStart {
                    block_kind: WasmBlockKind::If,
                    block_type: WasmBlockType::SingleOut(
                        self.wasm_module.arena.new!(WasmBlockTypeSingleOut {
                            out_type: WasmType::I32,
                        }),
                    ),
                }),
            ))
            self.codegen(ctx, instrs, infix_op.rhs)
            instrs.push!(WasmInstr::Else)
            instrs.push!(WasmInstr::I32Const(self.wasm_module.arena.new!(WasmInstrI32Const { value: 0 as i32 })))
            instrs.push!(WasmInstr::BlockEnd)
            return
        }

        // short-circuiting OR
        if infix_op.op_tag == InfixOpTag::Or {
            self.codegen(ctx, instrs, infix_op.lhs)
            instrs.push!(WasmInstr::BlockStart(
                self.wasm_module.arena.new!(WasmInstrBlockStart {
                    block_kind: WasmBlockKind::If,
                    block_type: WasmBlockType::SingleOut(
                        self.wasm_module.arena.new!(WasmBlockTypeSingleOut {
                            out_type: WasmType::I32,
                        }),
                    ),
                }),
            ))
            instrs.push!(WasmInstr::I32Const(self.wasm_module.arena.new!(WasmInstrI32Const { value: 1 as i32 })))
            instrs.push!(WasmInstr::Else)
            self.codegen(ctx, instrs, infix_op.rhs)
            instrs.push!(WasmInstr::BlockEnd)
            return
        }

        if op_info.is_compound_assignment {
            let var = self.var_from_expr(ctx, infix_op.lhs).unwrap!()

            self.codegen_var_set_prepare(instrs, var)
            self.codegen_var_get(ctx, instrs, var)
            self.codegen(ctx, instrs, infix_op.rhs)
            instrs.push!(WasmInstr::BinaryOp(
                self.wasm_module.arena.new!(WasmInstrBinaryOp { kind: op_info.op_kind }),
            ))
            self.codegen_var_set(ctx, instrs, var)
            return
        }

        self.codegen(ctx, instrs, infix_op.lhs)
        self.codegen(ctx, instrs, infix_op.rhs)
        instrs.push!(WasmInstr::BinaryOp(
            self.wasm_module.arena.new!(WasmInstrBinaryOp { kind: op_info.op_kind }),
        ))

        return
    }

    if match CodeExpr::Ident(_) = expr {
        let var = self.var_from_expr(ctx, expr).unwrap!()
        self.codegen_var_get(ctx, instrs, var)
        return
    }

    if match CodeExpr::FieldAccess(_) = expr {
        let var = self.var_from_expr(ctx, expr).unwrap!()
        self.codegen_var_get(ctx, instrs, var)
        return
    }

    if match CodeExpr::Paren(paren) = expr {
        self.codegen(ctx, instrs, paren.expr)
        return
    }

    if match CodeExpr::Sizeof(sizeof_expr) = expr {
        let type_ = self.get_type_expr_value(ctx, sizeof_expr.type_expr)
        let type_layout = ref!(TypeLayout::new())
        Typer::get_type_layout(self.registry, type_, type_layout)

        instrs.push!(WasmInstr::I32Const(
            self.wasm_module.arena.new!(WasmInstrI32Const { value: type_layout.byte_size as i32 }),
        ))
        return
    }

    if match CodeExpr::PrefixOp(prefix_op) = expr {
        if prefix_op.op_tag == PrefixOpTag::Dereference {
            let var = self.var_from_expr(ctx, expr).unwrap!()
            self.codegen_var_get(ctx, instrs, var)
            return
        }

        if prefix_op.op_tag == PrefixOpTag::Positive {
            self.codegen(ctx, instrs, prefix_op.expr)
            return
        }

        if prefix_op.op_tag == PrefixOpTag::Not {
            self.codegen(ctx, instrs, prefix_op.expr)

            let operand_type = self.get_expr_type(ctx, prefix_op.expr)
            let wasm_components = Vec::new!<WasmType>()
            self.lower_type(operand_type, wasm_components)

            if wasm_components.get!(0) == WasmType::I32 {
                instrs.push!(WasmInstr::UnaryOp(
                    self.wasm_module.arena.new!(WasmInstrUnaryOp { kind: WasmUnaryOpKind::I32_EQZ }),
                ))
            } else if wasm_components.get!(0) == WasmType::I64 {
                instrs.push!(WasmInstr::UnaryOp(
                    self.wasm_module.arena.new!(WasmInstrUnaryOp { kind: WasmUnaryOpKind::I64_EQZ }),
                ))
            } else {
                // TODO: port F32/F64
                todo!()
            }

            return
        }

        if prefix_op.op_tag == PrefixOpTag::Negative {
            let operand_type = self.get_expr_type(ctx, prefix_op.expr)

            if match CodeExpr::IntLiteral(int) = prefix_op.expr {
                let is_wide = Typer::is_wide_int(operand_type)
                if is_wide.ok {
                    instrs.push!(WasmInstr::I64Const(
                        self.wasm_module.arena.new!(WasmInstrI64Const { value: -(int.value as i64) }),
                    ))
                } else {
                    instrs.push!(WasmInstr::I32Const(
                        self.wasm_module.arena.new!(WasmInstrI32Const { value: -(int.value as i32) }),
                    ))
                }
                return
            }

            let wasm_components = Vec::new!<WasmType>()
            self.lower_type(operand_type, wasm_components)

            if wasm_components.get!(0) == WasmType::I32 {
                instrs.push!(WasmInstr::I32Const(self.wasm_module.arena.new!(WasmInstrI32Const { value: 0 as i32 })))
                self.codegen(ctx, instrs, prefix_op.expr)
                instrs.push!(WasmInstr::BinaryOp(
                    self.wasm_module.arena.new!(WasmInstrBinaryOp { kind: WasmBinaryOpKind::I32_SUB }),
                ))
            } else if wasm_components.get!(0) == WasmType::I64 {
                instrs.push!(WasmInstr::I64Const(self.wasm_module.arena.new!(WasmInstrI64Const { value: 0i64 })))
                self.codegen(ctx, instrs, prefix_op.expr)
                instrs.push!(WasmInstr::BinaryOp(
                    self.wasm_module.arena.new!(WasmInstrBinaryOp { kind: WasmBinaryOpKind::I64_SUB }),
                ))
            } else {
                // TODO: port F32/F64
                todo!()
            }

            return
        }

        // TODO: port
        todo!()
    }

    if match CodeExpr::Cast(cast) = expr {
        self.codegen(ctx, instrs, cast.expr)

        let castee_type = self.get_expr_type(ctx, cast.expr)
        let casted_to_type = self.get_type_expr_value(ctx, cast.casted_to)

        let cast_instr = Codegen::get_cast_instr(castee_type, casted_to_type)
        if cast_instr.err as u32 == 0 {
            instrs.push!(cast_instr.ok)
        }

        return
    }

    if match CodeExpr::Assign(assign) = expr {
        let var = self.var_from_expr(ctx, assign.lhs).unwrap!()

        self.codegen_var_set_prepare(instrs, var)
        self.codegen(ctx, instrs, assign.rhs)
        self.codegen_var_set(ctx, instrs, var)

        return
    }

    if match CodeExpr::FnCall(call) = expr {
        let expr_info = self.get_expr_info(ctx, call.id, call.loc)
        let call_info = self.registry.call_info.at!(expr_info)

        if match CallInfoValue::FnCall(fn_index) = call_info.value {
            self.codegen_fn_call(ctx, instrs, fn_index, null, call.args.items)
            return
        }

        // TODO: port
        todo!()
    }

    if match CodeExpr::MethodCall(method_call) = expr {
        let expr_info = self.get_expr_info(ctx, method_call.id, method_call.loc)
        let call_info = self.registry.call_info.at!(expr_info)

        if match CallInfoValue::FnCall(fn_index) = call_info.value {
            self.codegen_fn_call(ctx, instrs, fn_index, ref!(method_call.lhs), method_call.args.items)
            return
        }

        // TODO: port
        todo!()
    }

    if match CodeExpr::InlineFnCall(call) = expr {
        self.codegen_inline_fn_call(ctx, instrs, call.id, call.fn_name.loc)
        return
    }

    if match CodeExpr::InlineFnMethodCall(call) = expr {
        self.codegen_inline_fn_call(ctx, instrs, call.id, call.field_name.loc)
        return
    }

    if match CodeExpr::IntrinsicCall(call) = expr {
        // TODO: port

        if call.fn_name.repr.equals("unreachable") {
            instrs.push!(WasmInstr::Unreachable)
            return
        }

        if call.fn_name.repr.equals("memory_size") {
            instrs.push!(WasmInstr::MemorySize)
            return
        }

        if call.fn_name.repr.equals("memory_grow") {
            for arg in call.args.items.iter!() {
                self.codegen(ctx, instrs, arg)
            }

            instrs.push!(WasmInstr::MemoryGrow)
            return
        }

        if call.fn_name.repr.equals("memory_copy") {
            for arg in call.args.items.iter!() {
                self.codegen(ctx, instrs, arg)
            }

            instrs.push!(WasmInstr::MemoryCopy)
            return
        }

        if call.fn_name.repr.equals("data_size") {
            // placeholder, will be patched later
            instrs.push!(WasmInstr::I32Const(
                self.wasm_module.arena.new!(WasmInstrI32Const { value: 0 as i32 }),
            ))
            return
        }

        if call.fn_name.repr.equals("seg") {
            for arg in call.args.items.iter!() {
                self.codegen(ctx, instrs, arg)
            }
            return
        }

        // TODO: port
    }

    if match CodeExpr::If(if_expr) = expr {
        if match IfCond::Expr(cond_expr) = if_expr.cond {
            self.codegen(ctx, instrs, *cond_expr)

            // `if` condition runs outside of then_branch's scope
            // TODO: port
        }

        // TODO: port

        instrs.push!(WasmInstr::BlockStart(
            self.wasm_module.arena.new!(WasmInstrBlockStart {
                block_kind: WasmBlockKind::If,
                block_type: WasmBlockType::NoOut,
            }),
        ))

        self.codegen_code_block(ctx, instrs, &if_expr.then_block)

        // TODO: port

        if match ElseBlock::Else(else_block) = if_expr.else_block {
            instrs.push!(WasmInstr::Else)
            self.codegen_code_block(ctx, instrs, else_block)
        }
        if match ElseBlock::ElseIf(code_expr) = if_expr.else_block {
            instrs.push!(WasmInstr::Else)
            self.codegen(ctx, instrs, *code_expr)
        }

        instrs.push!(WasmInstr::BlockEnd)
        return
    }

    if match CodeExpr::While(while_expr) = expr {
        instrs.push!(WasmInstr::BlockStart(
            self.wasm_module.arena.new!(WasmInstrBlockStart {
                block_kind: WasmBlockKind::Block,
                block_type: WasmBlockType::NoOut,
            }),
        ))
        instrs.push!(WasmInstr::BlockStart(
            self.wasm_module.arena.new!(WasmInstrBlockStart {
                block_kind: WasmBlockKind::Loop,
                block_type: WasmBlockType::NoOut,
            }),
        ))

        if while_expr.cond != null {
            self.codegen(ctx, instrs, *while_expr.cond)

            instrs.push!(WasmInstr::UnaryOp(
                self.wasm_module.arena.new!(WasmInstrUnaryOp { kind: WasmUnaryOpKind::I32_EQZ }),
            ))
            instrs.push!(WasmInstr::BranchIf(
                self.wasm_module.arena.new!(WasmInstrBranchIf { label_index: 1 }),
            ))
        }

        self.enter_scope(ctx, ScopeKind::Loop)
        self.codegen_code_block(ctx, instrs, &while_expr.body)
        self.exit_scope(ctx)

        // implicit continue
        instrs.push!(WasmInstr::Branch(
            self.wasm_module.arena.new!(WasmInstrBranch { label_index: 0 }),
        ))

        instrs.push!(WasmInstr::BlockEnd)
        instrs.push!(WasmInstr::BlockEnd)
        return
    }

    if match CodeExpr::For(for_expr) = expr {
        let item_local = self.get_local_info(ctx, for_expr.item.id, for_expr.item.loc)
        let item_type_id = item_local.var_type_id

        self.enter_scope(ctx, ScopeKind::ForLoop)

        let counter_type_id = item_type_id
        let counter_local_index = 0
        let range_end_local_index = 0
        let item_local_index = u32::MAX
        let step = 1 as i32

        if match ForExprIterator::Range(range) = for_expr.iterator {
            counter_type_id = item_local.var_type_id
            counter_local_index = item_local.local_index

            range_end_local_index = self.define_unnamed_local(ctx, counter_type_id)

            self.codegen(ctx, instrs, range.start)
            instrs.push!(WasmInstr::LocalSet(
                self.wasm_module.arena.new!(WasmInstrLocalSet { local_index: counter_local_index }),
            ))

            self.codegen(ctx, instrs, range.end)
            instrs.push!(WasmInstr::LocalSet(
                self.wasm_module.arena.new!(WasmInstrLocalSet { local_index: range_end_local_index }),
            ))
        }

        if match ForExprIterator::Segment(segment) = for_expr.iterator {
            counter_type_id = self.registry.intern_type(Type::U32)
            range_end_local_index = self.define_unnamed_local(ctx, counter_type_id)

            if for_expr.ref_only {
                match Type::Pointer(ptr) = self.get_type(item_type_id) else {
                    @unreachable()
                }

                let item_layout = ref!(TypeLayout::new())
                Typer::get_type_layout(self.registry, self.get_type(ptr.pointee), item_layout)
                step = item_layout.byte_size as i32

                counter_local_index = item_local.local_index
            } else {
                let item_layout = ref!(TypeLayout::new())
                Typer::get_type_layout(self.registry, self.get_type(item_type_id), item_layout)
                step = item_layout.byte_size as i32

                counter_local_index = self.define_unnamed_local(ctx, counter_type_id)

                item_local_index = item_local.local_index
            }

            self.codegen(ctx, instrs, segment.expr)

            // needed:
            // ```
            // counter = segment.ptr
            // range_end = segment.ptr + (segment.len * item_size)
            // ```
            //
            // which is done like this to save on locals:
            // ```
            // counter, range_end = segment
            // range_end = counter + (range_end * item_size)
            // ```
            instrs.push!(WasmInstr::LocalSet(
                self.wasm_module.arena.new!(WasmInstrLocalSet { local_index: range_end_local_index }),
            ))
            instrs.push!(WasmInstr::LocalSet(
                self.wasm_module.arena.new!(WasmInstrLocalSet { local_index: counter_local_index }),
            ))
            instrs.push!(WasmInstr::LocalGet(
                self.wasm_module.arena.new!(WasmInstrLocalGet { local_index: range_end_local_index }),
            ))
            instrs.push!(WasmInstr::I32Const(
                self.wasm_module.arena.new!(WasmInstrI32Const { value: step }),
            ))
            instrs.push!(WasmInstr::BinaryOp(
                self.wasm_module.arena.new!(WasmInstrBinaryOp { kind: WasmBinaryOpKind::I32_MUL }),
            ))
            instrs.push!(WasmInstr::LocalGet(
                self.wasm_module.arena.new!(WasmInstrLocalGet { local_index: counter_local_index }),
            ))
            instrs.push!(WasmInstr::BinaryOp(
                self.wasm_module.arena.new!(WasmInstrBinaryOp { kind: WasmBinaryOpKind::I32_ADD }),
            ))
            instrs.push!(WasmInstr::LocalSet(
                self.wasm_module.arena.new!(WasmInstrLocalSet { local_index: range_end_local_index }),
            ))
        }

        instrs.push!(WasmInstr::BlockStart(
            self.wasm_module.arena.new!(WasmInstrBlockStart {
                block_kind: WasmBlockKind::Block,
                block_type: WasmBlockType::NoOut,
            }),
        ))

        instrs.push!(WasmInstr::BlockStart(
            self.wasm_module.arena.new!(WasmInstrBlockStart {
                block_kind: WasmBlockKind::Loop,
                block_type: WasmBlockType::NoOut,
            }),
        ))

        // break if counter is equal to end
        instrs.push!(WasmInstr::LocalGet(
            self.wasm_module.arena.new!(WasmInstrLocalGet { local_index: counter_local_index }),
        ))
        instrs.push!(WasmInstr::LocalGet(
            self.wasm_module.arena.new!(WasmInstrLocalGet { local_index: range_end_local_index }),
        ))
        let is_wide_result = Typer::is_wide_int(self.get_type(counter_type_id))
        if is_wide_result.ok {
            // TODO: port
            todo!()
        } else {
            instrs.push!(WasmInstr::BinaryOp(
                self.wasm_module.arena.new!(WasmInstrBinaryOp { kind: WasmBinaryOpKind::I32_EQ }),
            ))
        }
        instrs.push!(WasmInstr::BranchIf(
            self.wasm_module.arena.new!(WasmInstrBranchIf { label_index: 1 }),
        ))

        instrs.push!(WasmInstr::BlockStart(
            self.wasm_module.arena.new!(WasmInstrBlockStart {
                block_kind: WasmBlockKind::Block,
                block_type: WasmBlockType::NoOut,
            }),
        ))

        // item = load item_type at counter
        if item_local_index != u32::MAX {
            let address_instrs = Vec::new!<WasmInstr>()
            address_instrs.push!(WasmInstr::LocalGet(
                self.wasm_module.arena.new!(WasmInstrLocalGet { local_index: counter_local_index }),
            ))

            self.codegen_var_get(ctx, instrs, VarInfo::Stored(heap::new!(VarInfoStored {
                address_instrs: address_instrs,
                offset: 0,
                var_type_id: item_type_id,
            })))

            self.codegen_local_set(instrs, self.get_type(item_type_id), item_local_index)
        }

        self.codegen_code_block(ctx, instrs, &for_expr.body)

        instrs.push!(WasmInstr::BlockEnd)

        // increment counter
        instrs.push!(WasmInstr::LocalGet(
            self.wasm_module.arena.new!(WasmInstrLocalGet { local_index: counter_local_index }),
        ))
        if is_wide_result.ok {
            // TODO: port
            todo!()
        } else {
            instrs.push!(WasmInstr::I32Const(
                self.wasm_module.arena.new!(WasmInstrI32Const { value: step }),
            ))
            instrs.push!(WasmInstr::BinaryOp(
                self.wasm_module.arena.new!(WasmInstrBinaryOp { kind: WasmBinaryOpKind::I32_ADD }),
            ))
        }
        self.codegen_local_set(instrs, self.get_type(counter_type_id), counter_local_index)

        // implicit continue
        instrs.push!(WasmInstr::Branch(
            self.wasm_module.arena.new!(WasmInstrBranch { label_index: 0 }),
        ))

        instrs.push!(WasmInstr::BlockEnd)

        instrs.push!(WasmInstr::BlockEnd)

        self.exit_scope(ctx)
        return
    }

    if match CodeExpr::Break(break_expr) = expr {
        let expr_info = self.get_expr_info(ctx, break_expr.id, break_expr.loc)
        let break_info = self.registry.breaks.at!(expr_info)

        instrs.push!(WasmInstr::Branch(
            self.wasm_module.arena.new!(WasmInstrBranch { label_index: break_info.label_index }),
        ))
        return
    }

    if match CodeExpr::Continue(continue_expr) = expr {
        let expr_info = self.get_expr_info(ctx, continue_expr.id, continue_expr.loc)
        let break_info = self.registry.breaks.at!(expr_info)

        instrs.push!(WasmInstr::Branch(
            self.wasm_module.arena.new!(WasmInstrBranch { label_index: break_info.label_index }),
        ))
        return
    }

    if match CodeExpr::Defer(defer_expr) = expr {
        // find first non-inline-fn scope
        let scope_stack = self.module_info.at!(ctx.module_id).scope_stack
        let scope_to_defer = scope_stack.at!(scope_stack.len - 1)
        for i in 0..scope_stack.len {
            let scope = scope_stack.at!(scope_stack.len - 1 - i)
            if scope.kind != ScopeKind::InlineFn {
                scope_to_defer = scope
                break
            }
        }

        let expr_instrs = Vec::new!<WasmInstr>()
        self.codegen(ctx, expr_instrs, defer_expr.expr)
        scope_to_defer.deferred_exprs.push!(expr_instrs)

        return
    }

    if match CodeExpr::Catch(catch_expr) = expr {
        self.codegen_catch(
            ctx,
            instrs,
            catch_expr.lhs,
            catch_expr.ok_bind_id,
            catch_expr.error_bind.id,
            ref!(catch_expr.catch_body),
        )
        return
    }

    // TODO: port

    todo!()
}

fn Codegen::codegen_match_header(&self) {
    todo!()
}

fn Codegen::codegen_fn_call(
    &self,
    ctx: &ExprContext,
    instrs: &Vec(WasmInstr),
    fn_index: u32,
    receiver_arg: &?CodeExpr,
    args: &Vec(CodeExpr),
) {
    let fn_info = self.registry.functions.at!(fn_index)

    if receiver_arg != null {
        self.codegen(ctx, instrs, *receiver_arg)
    }
    for arg in args.iter!() {
        self.codegen(ctx, instrs, arg)
    }

    instrs.push!(WasmInstr::Call(
        self.wasm_module.arena.new!(WasmInstrCall { fn_index: fn_info.wasm_fn_index }),
    ))
}

fn Codegen::codegen_inline_fn_call(
    &self,
    ctx: &ExprContext,
    instrs: &Vec(WasmInstr),
    call_expr_id: ExprId,
    loc: Loc,
) {
    let call_info_id = self.get_expr_info(ctx, call_expr_id, loc)
    let call_info = self.registry.inline_call_info.at!(call_info_id)
    let inline_fn_def = self.registry.inline_fns.get!(call_info.inline_fn_index)
    match FnExprValue::Body(body) = inline_fn_def.value else {
        @unreachable()
    }

    self.enter_scope(ctx, ScopeKind::InlineFn)

    self.current_scope(ctx).expr_id_offset = call_info.inner_expr_id_offset

    self.codegen_code_block(ctx, instrs, body)

    self.exit_scope(ctx)
}

fn Codegen::codegen_catch(
    &self,
    ctx: &ExprContext,
    instrs: &Vec(WasmInstr),
    expr: CodeExpr,
    ok_bind_id: ExprId,
    err_bind_id: ExprId,
    catch_body: &?CodeBlock,
) {
    self.enter_scope(ctx, ScopeKind::Block) // enter catch scope

    // put result on the stack
    self.codegen(ctx, instrs, expr)

    // pop error
    let err_local = self.get_local_info(ctx, err_bind_id, expr.loc())
    self.codegen_local_set(instrs, self.get_type(err_local.var_type_id), err_local.local_index)

    // pop ok
    let ok_local = self.get_local_info(ctx, ok_bind_id, expr.loc())
    self.codegen_local_set(instrs, self.get_type(ok_local.var_type_id), ok_local.local_index)

    // cond: error != 0
    self.codegen_local_get(instrs, self.get_type(err_local.var_type_id), err_local.local_index)

    let in_out_type_index = self.get_block_inout_type(Vec::new!<Type>(), self.get_type(ok_local.var_type_id))
    instrs.push!(WasmInstr::BlockStart(self.wasm_module.arena.new!(WasmInstrBlockStart {
        block_kind: WasmBlockKind::If,
        block_type: WasmBlockType::InOut(self.wasm_module.arena.new!(WasmBlockTypeInOut {
            type_index: in_out_type_index,
        })),
    })))

    // catch error
    if catch_body != null {
        self.codegen_code_block(ctx, instrs, catch_body)
    } else {
        // TODO: port
        todo!()
    }

    instrs.push!(WasmInstr::Else)

    // no error, push ok value
    self.codegen_local_get(instrs, self.get_type(ok_local.var_type_id), ok_local.local_index)

    instrs.push!(WasmInstr::BlockEnd)

    self.exit_scope(ctx) // exit catch scope
}

fn Codegen::get_block_inout_type(&self, inputs: &Vec(Type), output: Type): u32 {
    let inout_fn_type = WasmFnType {
        inputs: Vec::new!<WasmType>(),
        outputs: Vec::new!<WasmType>(),
    }
    for input in inputs.iter!() {
        self.lower_type(input, inout_fn_type.inputs)
    }
    self.lower_type(output, inout_fn_type.outputs)

    for type_index in 0..self.wasm_fn_types.len {
        let fn_type = self.wasm_fn_types.get!(type_index)
        if fn_type.equals(inout_fn_type) {
            return type_index
        }
    }

    self.wasm_fn_types.push!(inout_fn_type)
    return self.wasm_fn_types.len - 1
}

fn Codegen::var_from_expr(&self, ctx: &ExprContext, expr: CodeExpr): Result(VarInfo, &VoidError) {
    // TODO: port

    if match CodeExpr::Paren(paren) = expr {
        return self.var_from_expr(ctx, paren.expr)
    }

    if match CodeExpr::Ident(var_name) = expr {
        let expr_info = self.get_expr_info(ctx, var_name.id, var_name.loc)
        let value_info = self.registry.value_info.at!(expr_info)

        // TODO: port

        if value_info.kind == ValueKind::Local {
            let local = self.registry.locals.at!(value_info.col_index)

            return Ok(VarInfo::Local(heap::new!(VarInfoLocal {
                local_index: local.wasm_local_index,
                var_type_id: local.local_type_id,
            })))
        }

        if value_info.kind == ValueKind::Global {
            let global = self.registry.globals.at!(value_info.col_index)

            return Ok(VarInfo::Global(heap::new!(VarInfoGlobal {
                global_index: global.wasm_global_index,
                var_type_id: global.type_id,
            })))
        }

        if value_info.kind == ValueKind::Const {
            let const_def = self.registry.constants.at!(value_info.col_index)

            return Ok(VarInfo::Const(heap::new!(VarInfoConst {
                const_def: const_def,
            })))
        }

        todo!()
    }

    if match CodeExpr::PrefixOp(prefix_op) = expr {
        if prefix_op.op_tag == PrefixOpTag::Dereference {
            let addr_type = self.get_expr_type(ctx, prefix_op.expr)

            match Type::Pointer(ptr) = addr_type else {
                @unreachable()
            }

            let address_instrs = Vec::new!<WasmInstr>()
            self.codegen(ctx, address_instrs, prefix_op.expr)

            return Ok(VarInfo::Stored(heap::new!(VarInfoStored {
                address_instrs: address_instrs,
                offset: 0,
                var_type_id: ptr.pointee,
            })))
        }

        todo!()
    }

    if match CodeExpr::FieldAccess(field_access) = expr {
        let lhs_type = self.get_expr_type(ctx, field_access.lhs)

        let field = Typer::get_struct_field_info(self.registry, lhs_type, field_access) \
            .unwrap!()

        if match Type::Pointer(ptr) = lhs_type {
            if !ptr.is_sequence {
                let address_instrs = Vec::new!<WasmInstr>()
                self.codegen(ctx, address_instrs, field_access.lhs)

                return Ok(VarInfo::Stored(heap::new!(VarInfoStored {
                    address_instrs: address_instrs,
                    offset: field.byte_offset,
                    var_type_id: field.field_type_id,
                })))
            }
        }

        let lhs_var_result = self.var_from_expr(ctx, field_access.lhs)
        if lhs_var_result.err as u32 == 0 {
            let var = lhs_var_result.ok

            if match VarInfo::Global(global) = var {
                return Ok(VarInfo::Global(heap::new!(VarInfoGlobal {
                    global_index: global.global_index + field.field_index,
                    var_type_id: field.field_type_id,
                })))
            }

            if match VarInfo::Local(local) = var {
                return Ok(VarInfo::Local(heap::new!(VarInfoLocal {
                    local_index: local.local_index + field.field_index,
                    var_type_id: field.field_type_id,
                })))
            }

            if match VarInfo::Stored(stored) = var {
                return Ok(VarInfo::Stored(heap::new!(VarInfoStored {
                    address_instrs: stored.address_instrs,
                    offset: stored.offset + field.byte_offset,
                    var_type_id: field.field_type_id,
                })))
            }

            if match VarInfo::StructValueField(struct_value_field) = var {
                let struct_components_count = Typer::count_primitive_components(self.registry, lhs_type)
                let field_components_count = Typer::count_primitive_components(self.registry, self.get_type(field.field_type_id))

                return Ok(VarInfo::StructValueField(heap::new!(VarInfoStructValueField {
                    lhs_instrs: struct_value_field.lhs_instrs,
                    drops_before: struct_value_field.drops_before + struct_components_count - field.field_index - field_components_count,
                    drops_after: struct_value_field.drops_after + field.field_index,
                    var_type_id: field.field_type_id,
                })))
            }

            // others are handled as struct values, fall through
        }

        let struct_components_count = Typer::count_primitive_components(self.registry, lhs_type)
        let field_components_count = Typer::count_primitive_components(self.registry, self.get_type(field.field_type_id))

        let lhs_instrs = Vec::new!<WasmInstr>()
        self.codegen(ctx, lhs_instrs, field_access.lhs)

        return Ok(VarInfo::StructValueField(heap::new!(VarInfoStructValueField {
            lhs_instrs: lhs_instrs,
            drops_before: struct_components_count - field.field_index - field_components_count,
            drops_after: field.field_index,
            var_type_id: field.field_type_id,
        })))
    }

    return Err(VoidError::VALUE)
}

fn Codegen::codegen_var_get(
    &self,
    ctx: &ExprContext,
    instrs: &Vec(WasmInstr),
    var: VarInfo,
) {
    if match VarInfo::Local(local) = var {
        self.codegen_local_get(instrs, self.get_type(local.var_type_id), local.local_index)
        return
    }

    if match VarInfo::Global(global) = var {
        for i in 0..Typer::count_primitive_components(self.registry, self.get_type(global.var_type_id)) {
            instrs.push!(WasmInstr::GlobalGet(
                self.wasm_module.arena.new!(WasmInstrGlobalGet { global_index: global.global_index + i }),
            ))
        }
        return
    }

    if match VarInfo::Const(const_var) = var {
        self.enter_scope(ctx, ScopeKind::InlineFn)
        self.current_scope(ctx).expr_id_offset = const_var.const_def.inner_expr_id_offset

        self.codegen(ctx, instrs, const_var.const_def.expr)

        self.exit_scope(ctx)
        return
    }

    if match VarInfo::Stored(stored) = var {
        let loads = Vec::new!<WasmInstr>()
        self.codegen_load_or_store(loads, self.get_type(stored.var_type_id), stored.offset, false)

        if loads.len == 0 {
            return
        }

        instrs.push_all!(stored.address_instrs.iter!())

        if loads.len > 1 {
            let addr_local_index = self.create_or_get_addr_local(ctx)
            instrs.push!(WasmInstr::LocalSet(
                self.wasm_module.arena.new!(WasmInstrLocalSet { local_index: addr_local_index }),
            ))

            loads.reverse()
            for load in loads.iter!() {
                instrs.push!(WasmInstr::LocalGet(
                    self.wasm_module.arena.new!(WasmInstrLocalGet { local_index: addr_local_index }),
                ))
                instrs.push!(load)
            }
        } else {
            instrs.append!(loads)
        }

        return
    }

    if match VarInfo::StructValueField(struct_value_field) = var {
        let var_type = self.get_type(struct_value_field.var_type_id)

        instrs.push_all!(struct_value_field.lhs_instrs.iter!())
        for i in 0..struct_value_field.drops_before {
            instrs.push!(WasmInstr::Drop)
        }

        if struct_value_field.drops_after > 0 {
            let local_index = self.define_unnamed_local(ctx, struct_value_field.var_type_id)

            self.codegen_local_set(instrs, var_type, local_index)
            for i in 0..struct_value_field.drops_after {
                instrs.push!(WasmInstr::Drop)
            }
            self.codegen_local_get(instrs, var_type, local_index)
        }

        return
    }

    // TODO: port

    todo!()
}

fn Codegen::codegen_local_get(
    &self,
    instrs: &Vec(WasmInstr),
    local_type: Type,
    local_index: u32,
) {
    for i in 0..Typer::count_primitive_components(self.registry, local_type) {
        instrs.push!(WasmInstr::LocalGet(
            self.wasm_module.arena.new!(WasmInstrLocalGet { local_index: local_index + i }),
        ))
    }
}

fn Codegen::codegen_var_set_prepare(&self, instrs: &Vec(WasmInstr), var: VarInfo) {
    if match VarInfo::Stored(stored) = var {
        if Typer::count_primitive_components(self.registry, self.get_type(stored.var_type_id)) == 0 {
            return
        }

        instrs.push_all!(stored.address_instrs.iter!())
    }
}

fn Codegen::codegen_var_set(&self, ctx: &ExprContext, instrs: &Vec(WasmInstr), var: VarInfo) {
    if match VarInfo::Local(local) = var {
        self.codegen_local_set(instrs, self.get_type(local.var_type_id), local.local_index)
        return
    }

    if match VarInfo::Global(global) = var {
        let i = Typer::count_primitive_components(self.registry, self.get_type(global.var_type_id))
        while i > 0 {
            i = i - 1
            instrs.push!(WasmInstr::GlobalSet(
                self.wasm_module.arena.new!(WasmInstrGlobalSet { global_index: global.global_index + i }),
            ))
        }
        return
    }

    if match VarInfo::Stored(stored) = var {
        let stores = Vec::new!<WasmInstr>()
        self.codegen_load_or_store(stores, self.get_type(stored.var_type_id), stored.offset, true)

        if stores.len > 1 {
            let tmp_value_local_index = self.define_unnamed_local(ctx, stored.var_type_id)
            self.codegen_local_set(instrs, self.get_type(stored.var_type_id), tmp_value_local_index)

            let addr_local_index = self.create_or_get_addr_local(ctx)
            instrs.push!(WasmInstr::LocalSet(
                self.wasm_module.arena.new!(WasmInstrLocalSet { local_index: addr_local_index }),
            ))

            stores.reverse()
            for i in 0..stores.len {
                instrs.push!(WasmInstr::LocalGet(
                    self.wasm_module.arena.new!(WasmInstrLocalGet { local_index: addr_local_index }),
                ))
                instrs.push!(WasmInstr::LocalGet(
                    self.wasm_module.arena.new!(WasmInstrLocalGet { local_index: tmp_value_local_index + i }),
                ))
                instrs.push!(stores.get!(i))
            }
        } else {
            instrs.append!(stores)
        }

        return
    }

    // TODO: port

    todo!()
}

fn Codegen::codegen_local_set(&self, instrs: &Vec(WasmInstr), local_type: Type, local_index: u32) {
    let i = Typer::count_primitive_components(self.registry, local_type)
    while i > 0 {
        i = i - 1
        instrs.push!(WasmInstr::LocalSet(
            self.wasm_module.arena.new!(WasmInstrLocalSet { local_index: local_index + i }),
        ))
    }
}

fn Codegen::codegen_load_or_store(
    &self,
    instrs: &Vec(WasmInstr),
    pointee_type: Type,
    offset: u32,
    is_store: bool,
) {
    if match Type::Never(_) = pointee_type {
        return // noop
    }
    if match Type::Void(_) = pointee_type {
        return // noop
    }

    if match Type::Bool(_) = pointee_type {
        if is_store {
            instrs.push!(WasmInstr::Store(self.wasm_module.arena.new!(WasmInstrStore {
                kind: WasmStoreKind::I32_8,
                align: 0,
                offset: offset,
            })))
        } else {
            instrs.push!(WasmInstr::Load(self.wasm_module.arena.new!(WasmInstrLoad {
                kind: WasmLoadKind::I32U8,
                align: 0,
                offset: offset,
            })))
        }
        return
    }

    if match Type::U8(_) = pointee_type {
        if is_store {
            instrs.push!(WasmInstr::Store(self.wasm_module.arena.new!(WasmInstrStore {
                kind: WasmStoreKind::I32_8,
                align: 0,
                offset: offset,
            })))
        } else {
            instrs.push!(WasmInstr::Load(self.wasm_module.arena.new!(WasmInstrLoad {
                kind: WasmLoadKind::I32U8,
                align: 0,
                offset: offset,
            })))
        }
        return
    }

    if match Type::Null(_) = pointee_type {
        if is_store {
            instrs.push!(WasmInstr::Store(self.wasm_module.arena.new!(WasmInstrStore {
                kind: WasmStoreKind::I32,
                align: 0,
                offset: offset,
            })))
        } else {
            instrs.push!(WasmInstr::Load(self.wasm_module.arena.new!(WasmInstrLoad {
                kind: WasmLoadKind::I32,
                align: 0,
                offset: offset,
            })))
        }
        return
    }

    if match Type::U32(_) = pointee_type {
        if is_store {
            instrs.push!(WasmInstr::Store(self.wasm_module.arena.new!(WasmInstrStore {
                kind: WasmStoreKind::I32,
                align: 0,
                offset: offset,
            })))
        } else {
            instrs.push!(WasmInstr::Load(self.wasm_module.arena.new!(WasmInstrLoad {
                kind: WasmLoadKind::I32,
                align: 0,
                offset: offset,
            })))
        }
        return
    }

    if match Type::Pointer(_) = pointee_type {
        if is_store {
            instrs.push!(WasmInstr::Store(self.wasm_module.arena.new!(WasmInstrStore {
                kind: WasmStoreKind::I32,
                align: 0,
                offset: offset,
            })))
        } else {
            instrs.push!(WasmInstr::Load(self.wasm_module.arena.new!(WasmInstrLoad {
                kind: WasmLoadKind::I32,
                align: 0,
                offset: offset,
            })))
        }
        return
    }

    if match Type::Seg(seg) = pointee_type {
        let ptr_type = Type::Pointer(heap::new!(PointerType {
            pointee: seg.item,
            is_sequence: true,
            is_nullable: false,
        }))
        self.codegen_load_or_store(instrs, Type::U32, offset + 4, is_store)
        self.codegen_load_or_store(instrs, ptr_type, offset, is_store)
        return
    }

    if match Type::Struct(struct_type) = pointee_type {
        let struct_def = self.registry.structs.at!(struct_type.struct_index)

        for i in 0..struct_def.fields.len {
            let struct_field = struct_def.fields.get!(struct_def.fields.len - 1 - i)
            self.codegen_load_or_store(
                instrs,
                self.get_type(struct_field.field_type_id),
                offset + struct_field.byte_offset,
                is_store,
            )
        }
        return
    }

    // TODO: port Enum

    if match Type::U64(_) = pointee_type {
        if is_store {
            instrs.push!(WasmInstr::Store(self.wasm_module.arena.new!(WasmInstrStore {
                kind: WasmStoreKind::I64,
                align: 0,
                offset: offset,
            })))
        } else {
            instrs.push!(WasmInstr::Load(self.wasm_module.arena.new!(WasmInstrLoad {
                kind: WasmLoadKind::I64,
                align: 0,
                offset: offset,
            })))
        }
        return
    }

    if match Type::Result(result) = pointee_type {
        let ok = self.get_type(result.ok)
        let err = self.get_type(result.err)

        let ok_layout = ref!(TypeLayout::new())
        Typer::get_type_layout(self.registry, ok, ok_layout)

        self.codegen_load_or_store(instrs, err, offset + ok_layout.byte_size, is_store)
        self.codegen_load_or_store(instrs, ok, offset, is_store)
        return
    }

    if match Type::Container(ctr) = pointee_type {
        self.codegen_load_or_store(instrs, self.get_type(ctr.container), offset, is_store)
        return
    }

    // TODO: port
    todo!()
}

fn Codegen::get_local_info(&self, ctx: &ExprContext, bind_id: ExprId, bind_loc: Loc): VarInfoLocal {
    let expr_info = self.get_expr_info(ctx, bind_id, bind_loc)
    let value_info = self.registry.value_info.at!(expr_info)
    let local_info = self.registry.locals.at!(value_info.col_index)

    return VarInfoLocal {
        local_index: local_info.wasm_local_index,
        var_type_id: local_info.local_type_id,
    }
}

fn Codegen::define_unnamed_local(&self, ctx: &ExprContext, local_type_id: TypeId): u32 {
    return self.registry.add_local(*ctx.fn_index, null, local_type_id)
}

fn Codegen::create_or_get_addr_local(&self, ctx: &ExprContext): u32 {
    if ctx.addr_local_index != null {
        return *ctx.addr_local_index
    }

    let addr_local_index = self.define_unnamed_local(ctx, self.registry.intern_type(Type::U32))

    return addr_local_index
}

