// TODO: implement module

type Type = enum (&?void) {
    Never(&?void),
    Null(&?void),
    Void(&?void),
    Bool(&?void),
    U8(&?void),
    I8(&?void),
    U16(&?void),
    I16(&?void),
    U32(&?void),
    I32(&?void),
    U64(&?void),
    I64(&?void),
    F32(&?void),
    F64(&?void),
    Pointer(&PointerType),
    Struct(&StructType),
    Enum(&EnumType),
    Seg(&SegType),
    Result(&ResultType),
    Container(&ContainerType),
}

fn Type::to_str(self): Result(str, VoidError) {
    return Ok("") // TODO: implement
}

type PointerType = struct {
    pointee: TypeId,
    is_sequence: bool,
    is_nullable: bool,
}

type StructType = struct {
    struct_index: u32,
}

type EnumType = struct {
    enum_index: u32,
}

type SegType = struct {
    item: TypeId,
}

type ResultType = struct {
    ok: TypeId,
    err: TypeId,
}

type ContainerType = struct {
    container: TypeId,
    items: &Vec(TypeId),
}

type ScopeKind = enum {
    Global,
    Function,
    Block,
    Loop,
    ForLoop,
    InlineFn,
}

type TySymbolKind = enum {
    TypeAlias,
    Struct,
    Enum,

    Local,
    Global,
    Const,

    InlineFn,
    Function,
    EnumConstructor,
}

type TySymbol = struct {
    ctx_id: u32,
    name: str,
    kind: TySymbolKind,
    col_index: u32,
    loc: Loc,
}

type TyContext = struct {
    module_id: u32,
    id: u32,
    parent: &?TyContext,
    kind: ScopeKind,
    fn_index: &?u32,
    expr_id_offset: u32,
    symbols: &Vec(TySymbol),
    symbols_lookup: &Map(&str, u32),

    inline_fn_call_loc: &?Loc,
    is_expr_referenced: bool,
}

fn TyContext::add_symbol(&self, symbol: TySymbol) {
    // TODO: implement the following:
    // self.symbols_lookup.insert(symbol.name, self.symbols.len)

    self.symbols.push!(symbol)
}

type TyModuleInfo = struct {
    ctx: &TyContext,
}

type Typer = struct {
    // context
    registry: &Registry,
    reporter: &Reporter,

    // state
    contexts: StableVec(TyContext),
    module_info: &Vec(TyModuleInfo),
    type_aliases: &Vec(TypeId),
    allocated_strings: &Vec(String),
    forbid_memory_loc: &?Loc,
    autodefine_memory: bool,
}

fn Typer::new(registry: &Registry): &Typer {
    return heap::new!(Typer {
        registry: registry,
        reporter: registry.reporter,

        contexts: StableVec::new!<TyContext>(),
        module_info: Vec::new!<TyModuleInfo>(),
        type_aliases: Vec::new!<TypeId>(),
        allocated_strings: Vec::new!<String>(),
        forbid_memory_loc: null,
        autodefine_memory: false,
    })
}

fn Typer::type_all(&self) {
    let global_ctx = self.contexts.push!(TyContext {
        module_id: u32::MAX, // global scope has no module
        id: 0,
        parent: null,
        kind: ScopeKind::Global,
        fn_index: null,
        expr_id_offset: 0,
        symbols: Vec::new!<TySymbol>(),
        symbols_lookup: Map::new!<&str, u32>(),

        inline_fn_call_loc: null,
        is_expr_referenced: false,
    })

    self.module_info.reserve(self.registry.modules.len)
    for module in self.registry.modules.iter!() {
        let module_ctx = self.child_ctx(global_ctx, ScopeKind::Global)
        module_ctx.module_id = module.id

        self.module_info.push!(TyModuleInfo { ctx: module_ctx })
    }

    self.extend_expr_info_storage(self.registry.expr_id_count)

    self.add_builtin_type(global_ctx, Type::Never(null))
    self.add_builtin_type(global_ctx, Type::Void(null))
    self.add_builtin_type(global_ctx, Type::Bool(null))
    self.add_builtin_type(global_ctx, Type::U8(null))
    self.add_builtin_type(global_ctx, Type::I8(null))
    self.add_builtin_type(global_ctx, Type::U16(null))
    self.add_builtin_type(global_ctx, Type::I16(null))
    self.add_builtin_type(global_ctx, Type::U32(null))
    self.add_builtin_type(global_ctx, Type::I32(null))
    self.add_builtin_type(global_ctx, Type::F32(null))
    self.add_builtin_type(global_ctx, Type::U64(null))
    self.add_builtin_type(global_ctx, Type::I64(null))
    self.add_builtin_type(global_ctx, Type::F64(null))

    for module_id in self.registry.module_import_order.iter!() {
        self.collect_own_symbols(self.module_info.get!(module_id).ctx)
    }

    for module_id in self.registry.module_import_order.iter!() {
        self.collect_included_symbols(self.module_info.get!(module_id).ctx)
    }

    for module_id in self.registry.module_import_order.iter!() {
        self.build_type_def_values(self.module_info.get!(module_id).ctx)
    }

    self.resolve_struct_layouts()

    self.resolve_str_literal_type()

    for module_id in self.registry.module_import_order.iter!() {
        self.process_top_level_exprs(self.module_info.get!(module_id).ctx)
    }

    self.type_fns()

    self.run_delayed_actions()
}

fn Typer::collect_own_symbols(&self, ctx: &TyContext) {
    let module = self.registry.modules.get!(ctx.module_id)

    for expr in module.parser.ast.iter!() {
        if match TopLevelExpr::Intrinsic(_) = expr {
            continue // skip, not interested
        }

        if match TopLevelExpr::Type(_) = expr {
            continue // TODO: implement
        }

        if match TopLevelExpr::Fn(fn_def) = expr {
            if fn_def.is_inline {
                continue // TODO: implement
            }

            let _ = self.define_symbol(
                ctx,
                fn_def.decl.fn_name.repr,
                TySymbolKind::Function,
                fn_def.decl.fn_name.loc,
            )

            if match FnExprValue::Body(body) = fn_def.value {
                let exported_as = Vec::new!<String>()
                if fn_def.exported {
                    exported_as.push!(String::from_str(fn_def.decl.fn_name.repr))
                }

                self.registry.functions.push!(FnInfo {
                    name: fn_def.decl.fn_name.repr,
                    type_: FnType {
                        inputs: Vec::new!<TypeId>(),
                        output: self.intern_type(Type::Void(null)),
                    },
                    params: Vec::new!<FnParameter>(),
                    source: FnSource::Guest(heap::new!(FnSourceGuest {
                        module_id: module.id,
                        lo_fn_index: self.registry.functions.len,
                        body: body,
                    })),
                    exported_as: exported_as,
                    locals_ids: Vec::new!<u32>(),
                    wasm_fn_index: u32::MAX, // placeholder
                    wasm_locals_count: 0,
                    definition_loc: fn_def.decl.fn_name.loc,
                })
            }

            if match FnExprValue::ImportFrom(body) = fn_def.value {
                continue // TODO: implement
            }
        }

        // TODO: implement
    }
}

