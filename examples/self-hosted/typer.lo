}

type StructFieldInfo = struct {
    field_type_id: TypeId,
    field_index: u32,
    byte_offset: u32,
    loc: &?Loc,
}

fn Typer::get_struct_field_info(
    registry: &Registry,
    lhs_type: Type,
    field_access: &FieldAccessExpr,
): Result(StructFieldInfo, &Error) {
    if match Type::Pointer(ptr) = lhs_type {
        if !ptr.is_sequence {
            lhs_type = registry.get_type(ptr.pointee)
        }
    }

    // TODO: port Container/Seg/Result/Enum special cases

    match Type::Struct(struct_type) = lhs_type else {
        let message = String::from_str_in(registry.error_arena, "Cannot get field '")
        do message.push_str(it) with (
            field_access.field_name.repr,
            "' on non struct: ",
            registry.fmt(lhs_type),
        )

        return Err(registry.error_arena.new!(Error {
            message: message,
            loc: field_access.field_name.loc,
        }))
    }

    let struct_def = registry.structs.at!(struct_type.struct_index)

    for &field in struct_def.fields.iter!() {
        if field.field_name.equals(field_access.field_name.repr) {
            return Ok(StructFieldInfo {
                field_type_id: field.field_type_id,
                field_index: field.field_index,
                byte_offset: field.byte_offset,
                loc: ref!(field.loc),
            })
        }
    }

    let message = String::from_str_in(registry.error_arena, "Unknown field `")
    do message.push_str(it) with (
        field_access.field_name.repr,
        "` in struct `",
        struct_def.struct_name,
        "`",
    )

    return Err(registry.error_arena.new!(Error {
        message: message,
        loc: field_access.field_name.loc,
    }))
}

fn Typer::resolve_str_literal_type(&self) {
    // fallback
    self.registry.str_literal_type_id = heap::new!(
        self.intern_type(Type::Seg(heap::new!(SegType {
            item: self.intern_type(Type::U8),
        }))),
    )

    let slt_def = null as &?TypeExpr

    for module_id in self.registry.module_import_order.iter!() {
        let ctx = self.module_info.get!(module_id).ctx
        let module = self.registry.modules.get!(module_id)

        for expr in module.parser.ast.iter!() {
            if match TopLevelExpr::Intrinsic(intrinsic) = expr {
                if !intrinsic.fn_name.repr.equals("str_literal_type") {
                    continue
                }

                if intrinsic.type_args.len != 1 || intrinsic.args.items.len != 0 {
                    self.report_error(self.registry.error_arena.new!(Error {
                        message: String::from_str_in(
                            self.registry.error_arena,
                            "Invalid call, expected signature: @<T>str_literal_type()",
                        ),
                        loc: intrinsic.fn_name.loc,
                    }))
                    continue
                }

                if slt_def != null {
                    let message = String::from_str_in(
                        self.registry.error_arena,
                        "Cannot redefine str literal type, first defined at ",
                    )
                    message.push_str(
                        (*slt_def).loc().to_string_in(self.registry.error_arena, self.registry).as_str(),
                    )

                    self.report_error(self.registry.error_arena.new!(Error {
                        message: message,
                        loc: intrinsic.fn_name.loc,
                    }))
                    continue
                }
                slt_def = heap::new!(intrinsic.type_args.get!(0))

                let type_id_result = self.build_type(ctx, *slt_def)
                if type_id_result.err as u32 != 0 {
                    self.report_error(type_id_result.err)
                } else {
                    let type_id = type_id_result.ok
                    let slt_components = self.get_primitives(self.get_type(type_id))

                    let expected_components = Vec::new!<Type>()
                    expected_components.push!(Type::U32)
                    expected_components.push!(Type::U32)

                    if !Typer::is_noop_cast(slt_components, expected_components) {
                        self.report_error(self.registry.error_arena.new!(Error {
                            message: String::from_str_in(
                                self.registry.error_arena,
                                "str literal type must be compatible with (u32, u32)",
                            ),
                            loc: (*slt_def).loc(),
                        }))
                    }

                    self.registry.str_literal_type_id = heap::new!(type_id)
                }
            }
        }
    }
}

fn Typer::process_top_level_exprs(&self, ctx: &TyContext) {
    let module = self.registry.modules.get!(ctx.module_id)

    for expr in module.parser.ast.iter!() {
        if match TopLevelExpr::TypeDef(_) = expr {
            continue // skip, processed in previous passes
        }

        if match TopLevelExpr::Fn(fn_def) = expr {
            if fn_def.is_inline {
                continue // skip, processed in pass_collect_all_symbols
            }

            let symbol = self.get_symbol(ctx, fn_def.decl.fn_name.repr)
            if symbol == null {
                @unreachable()
            }
            if symbol.kind != TySymbolKind::Function {
                continue
            }

            self.resolve_fn_signature(ctx, fn_def.decl, symbol.col_index)
        }

        if match TopLevelExpr::Let(let_expr) = expr {
            let symbol = self.get_symbol(ctx, let_expr.name.repr)
            if symbol == null {
                @unreachable()
            }

            // TODO: port

            let value_type_id = self.type_code_expr_and_load(ctx, let_expr.value) catch err {
                self.report_error(err)
                continue
            }

            if let_expr.is_inline {
                let const_def = self.registry.constants.at!(symbol.col_index)
                const_def.type_id = value_type_id

                // TODO: port inspection

                continue
            }

            if symbol.kind != TySymbolKind::Global {
                continue
            }

            let global = self.registry.globals.at!(symbol.col_index)
            global.type_id = value_type_id

            // TODO: port inspection
        }

        if match TopLevelExpr::Intrinsic(intrinsic) = expr {
            if intrinsic.fn_name.repr.equals("use_memory") {
                if self.registry.memory_info != null {
                    let existing_memory = *self.registry.memory_info

                    let message = String::from_str_in(
                        self.registry.error_arena,
                        "Cannot redefine memory, first defined at ",
                    )
                    message.push_str(
                        existing_memory.loc.to_string_in(self.registry.error_arena, self.registry).as_str(),
                    )

                    self.report_error(self.registry.error_arena.new!(Error {
                        message: message,
                        loc: intrinsic.loc,
                    }))
                    continue
                }

                if intrinsic.type_args.len != 0 {
                    self.report_error(bad_signature(self.registry.error_arena, intrinsic.fn_name))
                }

                let memory = heap::new!(MemoryInfo {
                    min_pages: null,
                    data_start: null,
                    exported: false,
                    imported_from: null,
                    loc: intrinsic.loc,
                })

                for arg in intrinsic.args.items.iter!() {
                    if match CodeExpr::Ident(ident) = arg {
                        if ident.repr.equals("exported") {
                            memory.exported = true
                            continue
                        }
                    }

                    match CodeExpr::Assign(assign) = arg else {
                        self.report_error(bad_signature(self.registry.error_arena, intrinsic.fn_name))
                        continue
                    }

                    match CodeExpr::Ident(key) = assign.lhs else {
                        self.report_error(bad_signature(self.registry.error_arena, intrinsic.fn_name))
                        continue
                    }

                    if key.repr.equals("data_start") {
                        let const_result = self.get_const_value_or_err(ctx, assign.rhs)

                        let is_bad = true
                        if const_result.err as u32 == 0 {
                            if match CodeExpr::IntLiteral(int_lit) = const_result.ok {
                                if int_lit.tag == null {
                                    memory.data_start = heap::new!(int_lit.value as u32)
                                    self.registry.data_size = int_lit.value as u32
                                    is_bad = false
                                }
                            }
                        }

                        if is_bad {
                            self.report_error(bad_signature(self.registry.error_arena, intrinsic.fn_name))
                        }

                        continue
                    }

                    if key.repr.equals("min_pages") {
                        let const_result = self.get_const_value_or_err(ctx, assign.rhs)

                        let is_bad = true
                        if const_result.err as u32 == 0 {
                            if match CodeExpr::IntLiteral(int_lit) = const_result.ok {
                                if int_lit.tag == null {
                                    memory.min_pages = heap::new!(int_lit.value as u32)
                                    is_bad = false
                                }
                            }
                        }

                        if is_bad {
                            self.report_error(bad_signature(self.registry.error_arena, intrinsic.fn_name))
                        }

                        continue
                    }

                    if key.repr.equals("import_from") {
                        match CodeExpr::StringLiteral(str_expr) = assign.rhs else {
                            self.report_error(bad_signature(self.registry.error_arena, intrinsic.fn_name))
                            continue
                        }

                        memory.imported_from = heap::new!(str_expr.value.clone())
                        continue
                    }

                    self.report_error(bad_signature(self.registry.error_arena, intrinsic.fn_name))
                }

                if self.forbid_memory_loc != null {
                    let message = String::from_str_in(
                        self.registry.error_arena,
                        "Cannot both forbid and define a memory, forbidden at ",
                    )
                    message.push_str(
                        (*self.forbid_memory_loc).to_string_in(self.registry.error_arena, self.registry).as_str(),
                    )

                    self.report_error(self.registry.error_arena.new!(Error {
                        message: message,
                        loc: intrinsic.fn_name.loc,
                    }))
                    continue
                }

                self.registry.memory_info = memory

                continue

                fn bad_signature(arena: &Arena, fn_name: IdentExpr): &Error {
                    let message = String::from_str_in(arena, "Invalid call, expected signature: @")
                    do message.push_str(it) with (
                        fn_name.repr,
                        "([min_pages = <u32>, data_start = <u32>, exported, import_from = <str-literal>])",
                    )

                    return arena.new!(Error {
                        message: message,
                        loc: fn_name.loc,
                    })
                }
            }

            // TODO: port
            continue
        }

        // TODO: port
    }
}

fn Typer::resolve_fn_signature(&self, ctx: &TyContext, fn_decl: FnDeclExpr, fn_index: u32) {
    let fn_info = self.registry.functions.at!(fn_index)

    let self_type_id = self.get_fn_self_type(ctx, fn_decl.fn_name, fn_decl.params) catch err {
        self.report_error(err)
        return
    }

    if fn_decl.return_type != null {
        let type_id = self.build_type(ctx, *fn_decl.return_type) catch err {
            self.report_error(err)
            return
        }

        fn_info.type_.output = type_id
    }

    for &fn_param in fn_decl.params.iter!() {
        if fn_param.param_name.repr.equals("_") {
            self.report_error(self.registry.error_arena.new!(Error {
                message: String::from_str_in(
                    self.registry.error_arena,
                    "Invalid fn param name `_` is not allowed here",
                ),
                loc: fn_param.param_name.loc,
            }))
        }

        let param_type_id = self.get_fn_param_type(ctx, fn_param, self_type_id, false) catch err {
            self.report_error(err)
            continue
        }

        fn_info.type_.inputs.push!(param_type_id)

        fn_info.params.push!(FnParameter {
            param_name: &fn_param.param_name,
            param_type_id: param_type_id,
        })
    }
}

fn Typer::get_fn_param_type(
    &self,
    ctx: &TyContext,
    fn_param: &FnParam,
    self_type_id: &?TypeId,
    infer_allowed: bool,
): Result(TypeId, &Error) {
    // TODO: port infer params

    if match FnParamType::Self(_) = fn_param.param_type {
        return Ok(*self_type_id)
    }

    if match FnParamType::SelfRef(_) = fn_param.param_type {
        return Ok(self.intern_type(Type::Pointer(heap::new!(PointerType {
            pointee: *self_type_id,
            is_sequence: false,
            is_nullable: false,
        }))))
    }

    if match FnParamType::Type(param_type) = fn_param.param_type {
        return self.build_type(ctx, param_type.expr)
    }

    todo!()
}

fn Typer::get_fn_self_type(
    &self,
    ctx: &TyContext,
    fn_name: IdentExpr,
    fn_params: &Vec(FnParam),
): Result(&?TypeId, &Error) {
    let has_self_param = false
    for fn_param in fn_params.iter!() {
        let is_self_param = false
        if match FnParamType::Self(_) = fn_param.param_type {
            is_self_param = true
        }
        if match FnParamType::SelfRef(_) = fn_param.param_type {
            is_self_param = true
        }
        if !is_self_param {
            continue
        }

        has_self_param = true

        if fn_name.parts.len == 1 {
            return Err(self.registry.error_arena.new!(Error {
                message: String::from_str_in(
                    self.registry.error_arena,
                    "Cannot use self param in non-method function",
                ),
                loc: fn_param.loc,
            }))
        }
    }
    if !has_self_param {
        return Ok(null)
    }

    let fn_module = self.registry.modules.get!(fn_name.loc.module_id)

    let self_type_loc = fn_name.parts.get!(0)
    self_type_loc.end_pos = fn_name.parts.get!(fn_name.parts.len - 2).end_pos

    let self_type_name = self_type_loc.read_span(fn_module.source)

    // this workaround is needed because `seg` itself is not a valid type
    if self_type_name.equals("seg") {
        return Ok(ref!(self.intern_type(Type::Seg(heap::new!(SegType {
            item: self.intern_type(Type::Never),
        })))))
    }

    // this workaround is needed because `Result` itself is not a valid type
    if self_type_name.equals("Result") {
        return Ok(ref!(self.intern_type(Type::Result(heap::new!(ResultType {
            ok: self.intern_type(Type::Never),
            err: self.intern_type(Type::Never),
        })))))
    }

    let self_type_id = self.get_type_id_or_err(ctx, self_type_name, self_type_loc)?

    return Ok(ref!(self_type_id))
}

fn Typer::type_fns(&self) {
    for fn_index in 0..self.registry.functions.len {
        match FnSource::Guest(fn_info) = self.registry.functions.get!(fn_index).source else {
            continue
        }

        let module_ctx = self.module_info.get!(fn_info.module_id).ctx
        self.type_fn(module_ctx, fn_index)
    }
}

fn Typer::type_fn(&self, parent_ctx: &TyContext, fn_index: u32) {
    let fn_def = self.registry.functions.at!(fn_index)

    match FnSource::Guest(fn_info) = fn_def.source else {
        return
    }

    let ctx = self.child_ctx(parent_ctx, ScopeKind::Function)
    ctx.fn_index = &fn_info.lo_fn_index

    for param in fn_def.params.iter!() {
        let _ = self.define_local(
            ctx,
            &param.param_name.repr,
            param.param_type_id,
            param.param_name.loc,
            param.param_name.id,
            true,
        )
    }

    let _ = self.type_code_block(ctx, fn_info.body, true)
}

fn Typer::run_delayed_actions(&self) {
    // TODO: port
}

fn Typer::alloc_str(&self, value: String): str {
    let str_ref = value.as_str()
    self.allocated_strings.push!(value)
    return str_ref
}

// defines nested fn symbols, bodies are typed later, see `type_code_block`.
fn Typer::collect_nested_fns(&self, ctx: &TyContext, exprs: &Vec(CodeExpr)) {
    for expr in exprs.iter!() {
        if match CodeExpr::Fn(fn_def) = expr {
            match FnExprValue::Body(body) = fn_def.value else {
                @unreachable()
            }

            let _ = self.define_symbol(
                ctx,
                fn_def.decl.fn_name.repr,
                TySymbolKind::Function,
                fn_def.decl.fn_name.loc,
            )

            let parent_fn_name = self.registry.functions.at!(*ctx.fn_index).name
            let full_fn_name = String::from_str(parent_fn_name)
            full_fn_name.push_str("/")
            full_fn_name.push_str(fn_def.decl.fn_name.repr)

            let fn_index = self.registry.functions.len
            self.registry.functions.push!(FnInfo {
                name: self.alloc_str(full_fn_name),
                type_: FnType {
                    inputs: Vec::new!<TypeId>(),
                    output: self.intern_type(Type::Void),
                },
                params: Vec::new!<FnParameter>(),
                source: FnSource::Guest(heap::new!(FnSourceGuest {
                    module_id: ctx.module_id,
                    lo_fn_index: fn_index,
                    body: body,
                })),
                exported_as: Vec::new!<String>(),
                locals_ids: Vec::new!<u32>(),
                wasm_fn_index: u32::MAX, // placeholder
                wasm_locals_count: 0,
                definition_loc: fn_def.decl.fn_name.loc,
            })
        }
    }

    for expr in exprs.iter!() {
        if match CodeExpr::Fn(fn_def) = expr {
            let symbol = self.get_symbol(ctx, fn_def.decl.fn_name.repr)
            if symbol == null {
                @unreachable()
            }
            if symbol.kind != TySymbolKind::Function {
                continue
            }

            self.resolve_fn_signature(ctx, fn_def.decl, symbol.col_index)
        }
    }
}

fn Typer::type_code_block(
    &self,
    ctx: &TyContext,
    block: &CodeBlock,
    void_only: bool,
): Type {
    self.collect_nested_fns(ctx, block.exprs)

    let diverges = false
    let diverges_naturally = false

    for expr in block.exprs.iter!() {
        if match CodeExpr::Fn(_) = expr {
            continue // skip as this is a declaration and not a code expression
        }

        if diverges {
            // TODO: port
        }

        let type_id = self.type_code_expr_and_load(ctx, expr) catch err {
            self.report_error(err)
            continue
        }

        let expr_type = self.get_type(type_id)

        if Typer::count_primitive_components(self.registry, expr_type) > 0 && void_only {
            // TODO: port
        }

        if expr_type.equals(Type::Never) {
            diverges = true
            diverges_naturally = diverges_naturally || Typer::is_naturally_divergent(expr)
        }
    }

    // typed after this block's own variables are declared so it errors
    // in `get_value_info` with a "forbidden access" error instead of "unknown variable"
    for expr in block.exprs.iter!() {
        if match CodeExpr::Fn(fn_def) = expr {
            let symbol = self.get_symbol(ctx, fn_def.decl.fn_name.repr)
            self.type_fn(ctx, symbol.col_index)
        }
    }

    if !diverges_naturally && !diverges && ctx.kind == ScopeKind::Function {
        let fn_info = self.registry.functions.get!(*ctx.fn_index)

        // TODO: port
    }

    self.store_expr_info(ctx, block.block_expr_id, self.registry.block_info.len)
    self.registry.block_info.push!(BlockInfo {
        needs_explicit_trap: void_only && diverges && !diverges_naturally,
    })

    if diverges {
        return Type::Never
    }

    return Type::Void
}

fn Typer::type_code_expr_and_load(&self, ctx: &TyContext, expr: CodeExpr): Result(TypeId, &Error) {
    self.type_code_expr(ctx, expr)?

    let type_id = self.load_type(ctx, expr)
    if type_id == null {
        self.reporter.abort_due_to_compiler_bug(
            "Expression should only return ok if it stored a type",
            expr.loc(),
        )
    }

    return Ok(*type_id)
}

// TODO: port
fn Typer::type_code_expr(&self, ctx: &TyContext, expr: CodeExpr): Result(void, &Error) {
    // TODO: port

    if match CodeExpr::IntLiteral(int_literal) = expr {
        // TODO: port the full version
        self.store_type(ctx, int_literal.id, Type::U32)

        return Ok()
    }

    // TODO: port

    if match CodeExpr::Ident(ident) = expr {
        let value_info = self.get_value_info(ctx, *ident)?
        self.registry.value_info.push!(value_info)

        self.store_expr_info(ctx, ident.id, self.registry.value_info.len - 1)
        return Ok()
    }

    // TODO: port

    if match CodeExpr::BoolLiteral(bool_literal) = expr {
        self.store_type(ctx, bool_literal.id, Type::Bool)
        return Ok()
    }

    if match CodeExpr::NullLiteral(null_literal) = expr {
        self.store_type(ctx, null_literal.id, Type::Null)
        return Ok()
    }

    if match CodeExpr::StringLiteral(str_literal) = expr {
        self.process_memory_op(str_literal.loc)

        let bytes_info = self.process_const_string(str_literal.value.as_str())

        self.store_expr_info(ctx, str_literal.id, self.registry.stored_bytes.len)
        self.registry.stored_bytes.push!(StoredExprBytes {
            info: bytes_info,
            expr_type_id: *self.registry.str_literal_type_id,
        })

        return Ok()
    }

    if match CodeExpr::StructLiteral(struct_literal) = expr {
        for field in struct_literal.body.fields.iter!() {
            self.report_if_err!(self.type_code_expr(ctx, field.value))
        }

        let symbol = self.get_symbol(ctx, struct_literal.struct_name.repr)
        if symbol == null {
            let message = String::from_str_in(self.registry.error_arena, "Unknown struct: ")
            message.push_str(struct_literal.struct_name.repr)

            return Err(self.registry.error_arena.new!(Error {
                message: message,
                loc: struct_literal.loc,
            }))
        }
        if symbol.kind != TySymbolKind::Struct {
            let message = String::from_str_in(
                self.registry.error_arena,
                "Struct name expected, got symbol ",
            )
            message.push_str(struct_literal.struct_name.repr)

            return Err(self.registry.error_arena.new!(Error {
                message: message,
                loc: struct_literal.loc,
            }))
        }
        let struct_index = symbol.col_index

        // TODO: port inspection

        self.store_type(ctx, struct_literal.id, Type::Struct(heap::new!(StructType {
            struct_index: struct_index,
        })))

        let struct_def = self.registry.structs.at!(struct_index)

        for field_index in 0..struct_literal.body.fields.len {
            let field_literal = struct_literal.body.fields.get!(field_index)

            if field_index >= struct_def.fields.len {
                self.report_error(self.registry.error_arena.new!(Error {
                    message: String::from_str_in(self.registry.error_arena, "Excess field values"),
                    loc: field_literal.key_loc,
                }))
                continue
            }
            let struct_field = struct_def.fields.get!(field_index)

            if !field_literal.key.equals(struct_field.field_name) {
                let message = String::from_str_in(
                    self.registry.error_arena,
                    "Unexpected struct field name, expecting: `",
                )
                do message.push_str(it) with (struct_field.field_name, "`")

                self.report_error(self.registry.error_arena.new!(Error {
                    message: message,
                    loc: field_literal.key_loc,
                }))
            }

            let field_value_type_id = self.load_type(ctx, field_literal.value)
            if field_value_type_id == null {
                continue
            }
            let field_value_type = self.get_type(*field_value_type_id)

            if !self.is_type_compatible(self.get_type(struct_field.field_type_id), field_value_type) {
                let message = String::from_str_in(
                    self.registry.error_arena,
                    "Invalid type for struct field ",
                )
                do message.push_str(it) with (
                    struct_literal.struct_name.repr,
                    ".",
                    struct_field.field_name,
                    ", expected: ",
                    self.registry.fmt(self.get_type(struct_field.field_type_id)),
                    ", got: ",
                    self.registry.fmt(field_value_type),
                )

                self.report_error(self.registry.error_arena.new!(Error {
                    message: message,
                    loc: field_literal.value.loc(),
                }))
            }

            // TODO: port inspection
        }

        // TODO: port missing struct fields check

        return Ok()
    }

    if match CodeExpr::ArrayLiteral(array_literal) = expr {
        self.process_memory_op(array_literal.loc)

        let item_type_id = self.build_type(ctx, array_literal.item_type)?
        let item_type = self.get_type(item_type_id)

        let bytes = Vec::new!<u8>()

        for item_expr in array_literal.items.iter!() {
            let current_item_type_id_result = self.type_code_expr_and_load(ctx, item_expr)
            if current_item_type_id_result.err as u32 != 0 {
                self.report_error(current_item_type_id_result.err)
                continue
            }
            let current_item_type = self.get_type(current_item_type_id_result.ok)

            if !self.is_type_compatible(item_type, current_item_type) {
                let message = String::from_str_in(
                    self.registry.error_arena,
                    "Unexpected array element type: ",
                )
                message.push_str(self.registry.fmt(current_item_type))
                message.push_str(", expected: ")
                message.push_str(self.registry.fmt(item_type))

                self.report_error(self.registry.error_arena.new!(Error {
                    message: message,
                    loc: item_expr.loc(),
                }))
            }

            self.report_if_err!(self.push_const_expr_bytes(bytes, item_expr, item_type))
        }

        let bytes_info = self.append_data(bytes.iter!())

        // seg.len is an amount of elements, not total byte size
        bytes_info.len = array_literal.items.len

        self.store_expr_info(ctx, array_literal.id, self.registry.stored_bytes.len)
        self.registry.stored_bytes.push!(StoredExprBytes {
            info: bytes_info,
            expr_type_id: self.intern_type(Type::Seg(heap::new!(SegType { item: item_type_id }))),
        })

        return Ok()
    }

    if match CodeExpr::Let(let_expr) = expr {
        self.type_code_expr(ctx, let_expr.value) catch err {
            self.report_error(err)
            self.store_type(ctx, let_expr.id, Type::Void)
            return Ok()
        }

        let value_type_id = *self.load_type(ctx, let_expr.value)

        if self.get_type(value_type_id).equals(Type::Never) {
            self.store_type(ctx, let_expr.id, Type::Never)
        } else {
            self.store_type(ctx, let_expr.id, Type::Void)
        }

        let _ = self.define_local(
            ctx,
            &let_expr.name.repr,
            value_type_id,
            let_expr.name.loc,
            let_expr.name.id,
            false,
        )
        return Ok()
    }

    if match CodeExpr::Fn(_) = expr {
        @unreachable() // skipped in `type_code_block`
    }

    if match CodeExpr::IntrinsicCall(call) = expr {
        // TODO: port

        if call.fn_name.repr.equals("unreachable") {
            self.store_type(ctx, call.id, Type::Never)

            // TODO: port

            return Ok()
        }

        // TODO: port
    }

    if match CodeExpr::InfixOp(infix_op) = expr {
        let lhs_type_id_res = self.type_code_expr_and_load(ctx, infix_op.lhs)
        let rhs_type_id = self.type_code_expr_and_load(ctx, infix_op.rhs)?
        let lhs_type_id = lhs_type_id_res?

        if !self.is_type_compatible(self.get_type(lhs_type_id), self.get_type(rhs_type_id)) {
            let message = String::new_in(self.registry.error_arena, 16)
            do message.push_str(it) with (
                "Operands are not of the same type: lhs = ",
                self.registry.fmt(self.get_type(lhs_type_id)),
                ", rhs = ",
                self.registry.fmt(self.get_type(rhs_type_id)),
            )

            self.report_error(self.registry.error_arena.new!(Error {
                message: message,
                loc: infix_op.op_loc,
            }))
        }

        // TODO: port
        let result_type_id = lhs_type_id
        if infix_op.op_tag == InfixOpTag::Equal || infix_op.op_tag == InfixOpTag::NotEqual || infix_op.op_tag == InfixOpTag::Less || infix_op.op_tag == InfixOpTag::And || infix_op.op_tag == InfixOpTag::Or {
            result_type_id = self.intern_type(Type::Bool)
        }
        if infix_op.op_tag == InfixOpTag::AddAssign || infix_op.op_tag == InfixOpTag::SubAssign || infix_op.op_tag == InfixOpTag::MulAssign {
            result_type_id = self.intern_type(Type::Void)
        }

        let is_compound_assignment = false
        let base_op = infix_op.op_tag

        let base_op_result = self.get_compound_assignment_base_op(infix_op.op_tag)
        if base_op_result.err as u32 == 0 {
            is_compound_assignment = true
            base_op = base_op_result.ok

            self.process_var_write(ctx, infix_op.lhs)?
        }

        let op_kind = self.get_binary_op_kind(
            ctx,
            base_op,
            self.get_type(lhs_type_id),
            infix_op.op_loc,
        )?

        self.store_expr_info(ctx, infix_op.id, self.registry.binary_op_info.len)
        self.registry.binary_op_info.push!(BinaryOpInfo {
            is_compound_assignment: is_compound_assignment,
            op_kind: op_kind,
            result_type_id: result_type_id,
        })

        return Ok()
    }

    // TODO: port

    if match CodeExpr::FnCall(call) = expr {
        // TODO: port enum constructor calls

        self.type_fn_call(
            ctx,
            call.fn_name.repr,
            null,
            call.args.items,
            call.id,
            call.fn_name.loc,
        )?
        return Ok()
    }

    if match CodeExpr::MethodCall(call) = expr {
        let lhs_type_id = self.type_code_expr_and_load(ctx, call.lhs)?
        let fn_name = self.get_fn_name_from_method(self.get_type(lhs_type_id), call.field_name.repr)

        self.type_fn_call(
            ctx,
            fn_name,
            ref!(call.lhs),
            call.args.items,
            call.id,
            call.field_name.loc,
        )?
        return Ok()
    }

    // TODO: port

    if match CodeExpr::Return(return_expr) = expr {
        self.store_type(ctx, return_expr.id, Type::Never)

        let return_type = Type::Void
        if return_expr.expr != null {
            let return_type_id = self.type_code_expr_and_load(ctx, *return_expr.expr)?
            return_type = self.get_type(return_type_id)
        }

        if ctx.fn_index == null {
            self.report_error(self.registry.error_arena.new!(Error {
                message: String::from_str_in(
                    self.registry.error_arena,
                    "Cannot use `return` in const context",
                ),
                loc: return_expr.loc,
            }))
            return Ok()
        }

        let fn_return_type = self.get_type(self.registry.functions.at!(*ctx.fn_index).type_.output)
        if !self.is_type_compatible(fn_return_type, return_type) {
            let message = String::from_str_in(
                self.registry.error_arena,
                "Invalid return type: ",
            )
            message.push_str(self.registry.fmt(return_type))
            message.push_str(", expected: ")
            message.push_str(self.registry.fmt(fn_return_type))

            self.report_error(self.registry.error_arena.new!(Error {
                message: message,
                loc: return_expr.loc,
            }))
        }

        return Ok()
    }

    if match CodeExpr::If(if_expr) = expr {
        let then_ctx = self.child_ctx(ctx, ScopeKind::Block)

        // TODO: port
        if match IfCond::Expr(cond_expr) = if_expr.cond {
            self.report_if_err!(self.type_code_expr_and_load(ctx, *cond_expr))
        }

        let then_type = self.type_code_block(then_ctx, &if_expr.then_block, true)

        let else_type = Type::Void
        if match ElseBlock::Else(else_block) = if_expr.else_block {
            let else_ctx = self.child_ctx(ctx, ScopeKind::Block)
            else_type = self.type_code_block(else_ctx, else_block, true)
        }
        if match ElseBlock::ElseIf(code_expr) = if_expr.else_block {
            let else_ctx = self.child_ctx(ctx, ScopeKind::Block)

            self.report_if_err!(self.type_code_expr(else_ctx, *code_expr))
            let type_id = self.load_type(else_ctx, *code_expr)
            if type_id != null {
                else_type = self.get_type(*type_id)
            }
        }

        if then_type.equals(Type::Never) && else_type.equals(Type::Never) {
            self.store_type(ctx, if_expr.id, Type::Never)
        } else {
            self.store_type(ctx, if_expr.id, Type::Void)
        }
        return Ok()
    }

    if match CodeExpr::While(while_expr) = expr {
        let loop_ctx = self.child_ctx(ctx, ScopeKind::Loop)
        let _ = self.type_code_block(loop_ctx, &while_expr.body, true)

        if while_expr.cond != null {
            let cond_type = self.type_code_expr_and_load(ctx, *while_expr.cond)?

            if !self.get_type(cond_type).equals(Type::Bool) {
                let message = String::from_str_in(
                    self.registry.error_arena,
                    "Invalid condition type: ",
                )
                message.push_str(self.registry.fmt(self.get_type(cond_type)))
                message.push_str(", expected: ")
                message.push_str(self.registry.fmt(Type::Bool))

                self.report_error(self.registry.error_arena.new!(Error {
                    message: message,
                    loc: (*while_expr.cond).loc(),
                }))
            }
        }

        self.store_type(ctx, while_expr.id, Type::Void)

        return Ok()
    }

    if match CodeExpr::For(for_expr) = expr {
        let item_type_id = u32::MAX

        if match ForExprIterator::Range(range) = for_expr.iterator {
            let start_result = self.type_code_expr_and_load(ctx, range.start)
            if start_result.err as u32 != 0 {
                self.report_error(start_result.err)
            } else {
                item_type_id = start_result.ok
            }

            let range_end_type_id = u32::MAX
            let end_result = self.type_code_expr_and_load(ctx, range.end)
            if end_result.err as u32 != 0 {
                self.report_error(end_result.err)
            } else {
                range_end_type_id = end_result.ok
            }

            if item_type_id != u32::MAX {
                let is_wide_result = Typer::is_wide_int(self.get_type(item_type_id))
                if is_wide_result.err as u32 != 0 {
                    let message = String::from_str_in(
                        self.registry.error_arena,
                        "Invalid counter. Type must be an integer, got ",
                    )
                    message.push_str(self.registry.fmt(self.get_type(item_type_id)))
                    message.push_str(" instead")

                    self.report_error(self.registry.error_arena.new!(Error {
                        message: message,
                        loc: range.start.loc(),
                    }))
                }
            }

            if item_type_id != u32::MAX && range_end_type_id != u32::MAX && item_type_id != range_end_type_id {
                let message = String::from_str_in(
                    self.registry.error_arena,
                    "Invalid range end type: ",
                )
                message.push_str(self.registry.fmt(self.get_type(range_end_type_id)))
                message.push_str(", expected: ")
                message.push_str(self.registry.fmt(self.get_type(item_type_id)))

                self.report_error(self.registry.error_arena.new!(Error {
                    message: message,
                    loc: range.end.loc(),
                }))
            }
        }

        if match ForExprIterator::Segment(segment) = for_expr.iterator {
            let seg_type_result = self.type_code_expr_and_load(ctx, segment.expr)
            if seg_type_result.err as u32 != 0 {
                self.report_error(seg_type_result.err)
            } else {
                let iter_type_id = seg_type_result.ok
                let iter_type = self.get_type(iter_type_id)

                if match Type::Seg(seg) = iter_type {
                    if for_expr.ref_only {
                        item_type_id = self.intern_type(Type::Pointer(heap::new!(PointerType {
                            pointee: seg.item,
                            is_sequence: false,
                            is_nullable: false,
                        })))
                    } else {
                        item_type_id = seg.item
                    }
                } else {
                    let message = String::from_str_in(
                        self.registry.error_arena,
                        "Expected seg(T), found ",
                    )
                    message.push_str(self.registry.fmt(iter_type))

                    self.report_error(self.registry.error_arena.new!(Error {
                        message: message,
                        loc: segment.expr.loc(),
                    }))
                }
            }
        }

        let ctx = self.child_ctx(ctx, ScopeKind::ForLoop)

        if item_type_id != u32::MAX {
            let _ = self.define_local(
                ctx,
                &for_expr.item.repr,
                item_type_id,
                for_expr.item.loc,
                for_expr.item.id,
                true,
            )
        }

        let _ = self.type_code_block(ctx, &for_expr.body, true)

        self.store_type(ctx, for_expr.id, Type::Void)

        return Ok()
    }

    if match CodeExpr::Break(break_expr) = expr {
        let label_index = 1 // 0 = loop, 1 = loop wrapper block

        let current_ctx = ctx
        loop {
            if current_ctx.kind == ScopeKind::Loop {
                break
            }
            if current_ctx.kind == ScopeKind::ForLoop {
                label_index += 1
                break
            }
            if current_ctx.kind == ScopeKind::Block {
                label_index += 1
            }
            if current_ctx.kind == ScopeKind::Function || current_ctx.kind == ScopeKind::Global {
                return Err(self.registry.error_arena.new!(Error {
                    message: String::from_str_in(self.registry.error_arena, "Cannot break outside of a loop"),
                    loc: break_expr.loc,
                }))
            }

            if current_ctx.parent == null {
                break
            }
            current_ctx = current_ctx.parent
        }

        self.store_expr_info(ctx, break_expr.id, self.registry.breaks.len)
        self.registry.breaks.push!(BreakInfo {
            label_index: label_index,
            expr_type_id: self.intern_type(Type::Never),
        })

        return Ok()
    }

    if match CodeExpr::Continue(continue_expr) = expr {
        let label_index = 0 // 0 = loop, 1 = loop wrapper block

        let current_ctx = ctx
        loop {
            if current_ctx.kind == ScopeKind::Loop || current_ctx.kind == ScopeKind::ForLoop {
                break
            }
            if current_ctx.kind == ScopeKind::Block {
                label_index += 1
            }
            if current_ctx.kind == ScopeKind::Function || current_ctx.kind == ScopeKind::Global {
                return Err(self.registry.error_arena.new!(Error {
                    message: String::from_str_in(self.registry.error_arena, "Cannot continue outside of a loop"),
                    loc: continue_expr.loc,
                }))
            }

            if current_ctx.parent == null {
                break
            }
            current_ctx = current_ctx.parent
        }

        self.store_expr_info(ctx, continue_expr.id, self.registry.breaks.len)
        self.registry.breaks.push!(BreakInfo {
            label_index: label_index,
            expr_type_id: self.intern_type(Type::Never),
        })

        return Ok()
    }

    if match CodeExpr::Assign(assign) = expr {
        let lhs_result = self.type_code_expr_and_load(ctx, assign.lhs)
        if lhs_result.err as u32 != 0 {
            self.report_error(lhs_result.err)
        }

        let rhs_result = self.type_code_expr_and_load(ctx, assign.rhs)
        if rhs_result.err as u32 != 0 {
            self.report_error(rhs_result.err)
        }

        if lhs_result.err as u32 == 0 && rhs_result.err as u32 == 0 {
            if !self.is_type_compatible(self.get_type(lhs_result.ok), self.get_type(rhs_result.ok)) {
                let message = String::from_str_in(self.registry.error_arena, "Cannot assign ")
                do message.push_str(it) with (
                    self.registry.fmt(self.get_type(rhs_result.ok)),
                    " to variable of type ",
                    self.registry.fmt(self.get_type(lhs_result.ok)),
                )

                self.report_error(self.registry.error_arena.new!(Error {
                    message: message,
                    loc: assign.op_loc,
                }))
            }
        }

        self.store_type(ctx, assign.id, Type::Void)

        if lhs_result.err as u32 == 0 {
            self.process_var_write(ctx, assign.lhs)?
        }

        return Ok()
    }

    if match CodeExpr::PrefixOp(prefix_op) = expr {
        let is_ref_prev = ctx.is_expr_referenced
        if prefix_op.op_tag == PrefixOpTag::Reference {
            ctx.is_expr_referenced = true
        }

        let expr_type_id = self.type_code_expr_and_load(ctx, prefix_op.expr)?

        ctx.is_expr_referenced = is_ref_prev

        if prefix_op.op_tag == PrefixOpTag::Dereference {
            match Type::Pointer(ptr) = self.get_type(expr_type_id) else {
                let message = String::from_str_in(
                    self.registry.error_arena,
                    "Cannot dereference expr of type ",
                )
                message.push_str(self.registry.fmt(self.get_type(expr_type_id)))

                return Err(self.registry.error_arena.new!(Error {
                    message: message,
                    loc: prefix_op.expr.loc(),
                }))
            }

            self.process_memory_op(prefix_op.loc)

            // TODO: port inspection

            self.store_expr_info(ctx, prefix_op.id, ptr.pointee)
            return Ok()
        }

        if prefix_op.op_tag == PrefixOpTag::Positive || prefix_op.op_tag == PrefixOpTag::Negative {
            let expr_type = self.get_type(expr_type_id)

            if match Type::U8(_) = expr_type {
                self.store_type(ctx, prefix_op.id, Type::I8)
                return Ok()
            }
            if match Type::I8(_) = expr_type {
                self.store_type(ctx, prefix_op.id, Type::I8)
                return Ok()
            }
            if match Type::U16(_) = expr_type {
                self.store_type(ctx, prefix_op.id, Type::I16)
                return Ok()
            }
            if match Type::I16(_) = expr_type {
                self.store_type(ctx, prefix_op.id, Type::I16)
                return Ok()
            }
            if match Type::U32(_) = expr_type {
                self.store_type(ctx, prefix_op.id, Type::I32)
                return Ok()
            }
            if match Type::I32(_) = expr_type {
                self.store_type(ctx, prefix_op.id, Type::I32)
                return Ok()
            }
            if match Type::U64(_) = expr_type {
                self.store_type(ctx, prefix_op.id, Type::I64)
                return Ok()
            }
            if match Type::I64(_) = expr_type {
                self.store_type(ctx, prefix_op.id, Type::I64)
                return Ok()
            }

            let message = String::from_str_in(self.registry.error_arena, "Integer expected. Got ")
            message.push_str(self.registry.fmt(expr_type))

            return Err(self.registry.error_arena.new!(Error {
                message: message,
                loc: prefix_op.op_loc,
            }))
        }

        // TODO: port
        todo!()
    }

    if match CodeExpr::Cast(cast) = expr {
        let castee_result = self.type_code_expr_and_load(ctx, cast.expr)

        let casted_to_type_id = self.build_type(ctx, cast.casted_to)?
        let casted_to_type = self.get_type(casted_to_type_id)

        if castee_result.err as u32 != 0 {
            self.report_error(castee_result.err)
        } else {
            let castee_type = self.get_type(castee_result.ok)

            let castee_type_components = self.get_primitives(castee_type)
            let casted_to_type_components = self.get_primitives(casted_to_type)

            let noop_local_cast = Typer::is_noop_cast(castee_type_components, casted_to_type_components)

            let single_int_cast = false
            if castee_type_components.len == 1 && casted_to_type_components.len == 1 {
                let p1_wide = Typer::is_wide_int(castee_type_components.get!(0))
                let p2_wide = Typer::is_wide_int(casted_to_type_components.get!(0))
                single_int_cast = p1_wide.err as u32 == 0 && p2_wide.err as u32 == 0
            }

            if !(single_int_cast || noop_local_cast) {
                let message = String::from_str_in(self.registry.error_arena, "Cannot cast from ")
                do message.push_str(it) with (
                    self.registry.fmt(castee_type),
                    " to ",
                    self.registry.fmt(casted_to_type),
                )

                return Err(self.registry.error_arena.new!(Error {
                    message: message,
                    loc: cast.expr.loc(),
                }))
            }
        }

        self.store_type(ctx, cast.id, casted_to_type)

        return Ok()
    }

    if match CodeExpr::FieldAccess(field_access) = expr {
        let is_ref_prev = ctx.is_expr_referenced
        ctx.is_expr_referenced = false

        let lhs_type_id = self.type_code_expr_and_load(ctx, field_access.lhs)?

        ctx.is_expr_referenced = is_ref_prev

        if match Type::Pointer(_) = self.get_type(lhs_type_id) {
            if !ctx.is_expr_referenced {
                self.process_memory_op(field_access.field_name.loc)
            }
        }

        let field = Typer::get_struct_field_info(self.registry, self.get_type(lhs_type_id), field_access)?

        // TODO: port inspection

        self.store_type(ctx, field_access.id, self.get_type(field.field_type_id))
        return Ok()
    }

    if match CodeExpr::Paren(paren) = expr {
        self.type_code_expr(ctx, paren.expr)?

        let expr_type_id = self.load_type(ctx, paren.expr)
        if expr_type_id != null {
            self.store_expr_info(ctx, paren.id, *expr_type_id)
        }
        return Ok()
    }

    // TODO: port

    todo!()
}

fn Typer::get_compound_assignment_base_op(&self, op_tag: InfixOpTag): Result(InfixOpTag, &VoidError) {
    if op_tag == InfixOpTag::AddAssign {
        return Ok(InfixOpTag::Add)
    }
    if op_tag == InfixOpTag::SubAssign {
        return Ok(InfixOpTag::Sub)
    }
    if op_tag == InfixOpTag::MulAssign {
        return Ok(InfixOpTag::Mul)
    }

    // TODO: port other variants
    return Err(VoidError::VALUE)
}

fn Typer::get_binary_op_kind(
    &self,
    ctx: &TyContext,
    op_tag: InfixOpTag,
    operand_type: Type,
    op_loc: Loc,
): Result(WasmBinaryOpKind, &Error) {
    // TODO: port
    let signed = false
    let wasm_op_type = WasmType::I32

    if match Type::Null(_) = operand_type {
        // signed = false
    } else if match Type::Bool(_) = operand_type {
        // signed = false
    } else if match Type::U8(_) = operand_type {
        // signed = false
    } else if match Type::U16(_) = operand_type {
        // signed = false
    } else if match Type::U32(_) = operand_type {
        // signed = false
    } else if match Type::Pointer(_) = operand_type {
        // signed = false
    } else if match Type::I8(_) = operand_type {
        signed = true
    } else if match Type::I16(_) = operand_type {
        signed = true
    } else if match Type::I32(_) = operand_type {
        signed = true
    } else {
        // TODO: port
        todo!()
    }

    // TODO: port
    if wasm_op_type == WasmType::I32 {
        if op_tag == InfixOpTag::Equal {
            return Ok(WasmBinaryOpKind::I32_EQ)
        }
        if op_tag == InfixOpTag::NotEqual {
            return Ok(WasmBinaryOpKind::I32_NE)
        }
        if op_tag == InfixOpTag::Less {
            if signed {
                return Ok(WasmBinaryOpKind::I32_LT_S)
            }
            return Ok(WasmBinaryOpKind::I32_LT_U)
        }
        if op_tag == InfixOpTag::Add {
            return Ok(WasmBinaryOpKind::I32_ADD)
        }
        if op_tag == InfixOpTag::Sub {
            return Ok(WasmBinaryOpKind::I32_SUB)
        }
        if op_tag == InfixOpTag::Mul {
            return Ok(WasmBinaryOpKind::I32_MUL)
        }
        if op_tag == InfixOpTag::Mod {
            if signed {
                return Ok(WasmBinaryOpKind::I32_REM_S)
            }
            return Ok(WasmBinaryOpKind::I32_REM_U)
        }
        if op_tag == InfixOpTag::And {
            return Ok(WasmBinaryOpKind::I32_AND)
        }
        if op_tag == InfixOpTag::Or {
            return Ok(WasmBinaryOpKind::I32_OR)
        }
        if op_tag == InfixOpTag::ShiftRight {
            if signed {
                return Ok(WasmBinaryOpKind::I32_SHR_S)
            }
            return Ok(WasmBinaryOpKind::I32_SHR_U)
        }
    }

    // TODO: port
    todo!()
}

fn Typer::type_fn_call(
    &self,
    ctx: &TyContext,
    fn_name: str,
    receiver_arg: &?CodeExpr,
    args: &Vec(CodeExpr),
    call_expr_id: ExprId,
    loc: Loc,
): Result(void, &Error) {
    let all_good = true
    let arg_types = Vec::new!<TypeId>()

    if receiver_arg != null {
        let receiver_result = self.type_code_expr_and_load(ctx, *receiver_arg)
        if receiver_result.err as u32 != 0 {
            self.report_error(receiver_result.err)
            all_good = false
        } else {
            arg_types.push!(receiver_result.ok)
        }
    }

    for arg in args.iter!() {
        let type_id = self.type_code_expr_and_load(ctx, arg) catch err {
            self.report_error(err)
            all_good = false
            continue
        }
        arg_types.push!(type_id)
    }

    let fn_index = self.get_fn_index_for_call(ctx, fn_name, loc)?
    let fn_info = self.registry.functions.at!(fn_index)

    self.store_expr_info(ctx, call_expr_id, self.registry.call_info.len)
    self.registry.call_info.push!(CallInfo {
        value: CallInfoValue::FnCall(fn_index),
        return_type_id: fn_info.type_.output,
    })

    // TODO: port inspection

    if all_good && !self.is_types_compatible(fn_info.type_.inputs, arg_types) {
        // TODO: port
        todo!()
    }

    return Ok()
}

fn Typer::get_fn_index_for_call(
    &self,
    ctx: &TyContext,
    fn_name: str,
    loc: Loc,
): Result(u32, &Error) {
    let symbol = self.get_symbol(ctx, fn_name)
    if symbol == null {
        let message = String::from_str_in(self.registry.error_arena, "Unknown function: ")
        message.push_str(fn_name)

        return Err(self.registry.error_arena.new!(Error {
            message: message,
            loc: loc,
        }))
    }

    if symbol.kind != TySymbolKind::Function {
        let message = String::from_str_in(self.registry.error_arena, "Trying to call ")
        do message.push_str(it) with (
            fn_name,
            " which is not a function, defined at: ",
            symbol.loc.to_string_in(self.registry.error_arena, self.registry).as_str(),
        )

        return Err(self.registry.error_arena.new!(Error {
            message: message,
            loc: loc,
        }))
    }

    return Ok(symbol.col_index)
}

fn Typer::get_fn_name_from_method(&self, receiver_type: Type, method_name: str): str {
    let deref_receiver_type = self.deref_rec(receiver_type)

    // TODO: port Seg/Result/Container special cases

    let name = String::new_in(self.registry.error_arena, 16)
    name.push_str(self.registry.fmt(deref_receiver_type))
    name.push_str("::")
    name.push_str(method_name)

    return name.as_str()
}

fn Typer::deref_rec(&self, type_: Type): Type {
    if match Type::Pointer(ptr) = type_ {
        return self.deref_rec(self.get_type(ptr.pointee))
    }

    return type_
}

fn Typer::get_value_info(
    &self,
    ctx: &TyContext,
    var_name: IdentExpr,
): Result(ValueInfo, &Error) {
    let symbol = self.get_symbol(ctx, var_name.repr)
    if symbol == null {
        let message = String::from_str_in(self.registry.error_arena, "Unknown variable: ")
        message.push_str(var_name.repr)

        return Err(self.registry.error_arena.new!(Error {
            message: message,
            loc: var_name.loc,
        }))
    }

    if symbol.kind == TySymbolKind::Local {
        if symbol.defining_fn_index != ctx.fn_index {
            let message = String::from_str_in(
                self.registry.error_arena,
                "Forbidden access of a parent function's local `",
            )
            message.push_str(var_name.repr)
            message.push_str("`")

            return Err(self.registry.error_arena.new!(Error {
                message: message,
                loc: var_name.loc,
            }))
        }

        let local_def = self.registry.locals.at!(symbol.col_index)

        // TODO: port inspection

        return Ok(ValueInfo {
            kind: ValueKind::Local,
            col_index: symbol.col_index,
            type_id: local_def.local_type_id,
        })
    }

    if symbol.kind == TySymbolKind::Global {
        let global = self.registry.globals.at!(symbol.col_index)

        // TODO: port inspection

        return Ok(ValueInfo {
            kind: ValueKind::Global,
            col_index: symbol.col_index,
            type_id: global.type_id,
        })
    }

    if symbol.kind == TySymbolKind::Const {
        let const_def = self.registry.constants.at!(symbol.col_index)

        // TODO: port inspection

        return Ok(ValueInfo {
            kind: ValueKind::Const,
            col_index: symbol.col_index,
            type_id: const_def.type_id,
        })
    }

    // TODO: port
    todo!()
}

fn Typer::process_var_write(&self, ctx: &TyContext, lhs: CodeExpr): Result(void, &Error) {
    let var = self.get_variable_kind(ctx, lhs) catch _ {
        return Err(self.registry.error_arena.new!(Error {
            message: String::from_str_in(self.registry.error_arena, "Invalid lhs"),
            loc: lhs.loc(),
        }))
    }

    if var == VariableKind::ReadWriteStored {
        self.process_memory_op(lhs.loc())
    }

    if var == VariableKind::Readonly {
        return Err(self.registry.error_arena.new!(Error {
            message: String::from_str_in(self.registry.error_arena, "Cannot mutate a constant"),
            loc: lhs.loc(),
        }))
    }

    return Ok()
}

fn Typer::get_variable_kind(&self, ctx: &TyContext, expr: CodeExpr): Result(VariableKind, &VoidError) {
    if match CodeExpr::Ident(var_name) = expr {
        let expr_info = self.registry.get_expr_info(ctx.expr_id_offset, var_name.id)
        let value_info = self.registry.value_info.at!(*expr_info)

        if value_info.kind == ValueKind::Global || value_info.kind == ValueKind::Local {
            return Ok(VariableKind::ReadWrite)
        }

        return Ok(VariableKind::Readonly)
    }

    if match CodeExpr::PrefixOp(prefix_op) = expr {
        if prefix_op.op_tag == PrefixOpTag::Dereference {
            return Ok(VariableKind::ReadWriteStored)
        }
    }

    if match CodeExpr::FieldAccess(field_access) = expr {
        let lhs_type_id = self.load_type(ctx, field_access.lhs)
        let lhs_type = self.get_type(*lhs_type_id)

        if match Type::Pointer(ptr) = lhs_type {
            if !ptr.is_sequence {
                return Ok(VariableKind::ReadWriteStored)
            }
        }

        let var_result = self.get_variable_kind(ctx, field_access.lhs)
        if var_result.err as u32 == 0 {
            return Ok(var_result.ok)
        }
        return Ok(VariableKind::Readonly)
    }

    // TODO: port
    todo!()
}

fn Typer::process_memory_op(&self, loc: Loc) {
    if self.registry.memory_info != null {
        return
    }

    if self.forbid_memory_loc != null {
        let message = String::from_str_in(
            self.registry.error_arena,
            "Memory operations forbidden, see ",
        )
        message.push_str(
            (*self.forbid_memory_loc).to_string_in(self.registry.error_arena, self.registry).as_str(),
        )

        self.report_error(self.registry.error_arena.new!(Error {
            message: message,
            loc: loc,
        }))
        return
    }

    self.autodefine_memory = true
}

fn Typer::define_local(
    &self,
    ctx: &TyContext,
    name: &str,
    type_id: TypeId,
    loc: Loc,
    bind_id: ExprId,
    always_define: bool,
): bool {
    if self.reporter.in_inspection_mode {
        // TODO: port:
        // self.reporter.print_inspection(InspectInfo {
        //     message: format!("let {}: {}", name, self.registry.fmt(self.get_type(type_id))),
        //     loc: loc,
        //     linked_loc: None,
        // })
    }

    let defined = !(*name).equals("_") && self.define_symbol(ctx, *name, TySymbolKind::Local, loc)
    if defined || always_define {
        self.define_local_no_symbol(ctx, name, type_id, bind_id)
    }

    return defined
}

fn Typer::define_local_no_symbol(
    &self,
    ctx: &TyContext,
    local_name: &?str,
    type_id: TypeId,
    bind_id: ExprId,
) {
    let _ = self.registry.add_local(*ctx.fn_index, local_name, type_id)

    self.store_expr_info(ctx, bind_id, self.registry.value_info.len)
    self.registry.value_info.push!(ValueInfo {
        kind: ValueKind::Local,
        col_index: self.registry.locals.len - 1,
        type_id: type_id,
    })
}

fn Typer::build_type(&self, ctx: &TyContext, expr: TypeExpr): Result(TypeId, &Error) {
    self.type_type_expr(ctx, expr)?

    let expr_info = self.registry.get_expr_info(ctx.expr_id_offset, expr.id())
    if expr_info == null {
        self.reporter.abort_due_to_compiler_bug(
            "Type expression should only return ok if it stored a type",
            expr.loc(),
        )
    }

    return Ok(*expr_info)
}

fn Typer::type_type_expr(&self, ctx: &TyContext, expr: TypeExpr): Result(void, &Error) {
    if match TypeExpr::Named(ident) = expr {
        let type_id = self.get_type_id_or_err(ctx, ident.repr, ident.loc)?
        self.store_expr_info(ctx, ident.id, type_id)
        return Ok()
    }

    if match TypeExpr::Pointer(ptr) = expr {
        let pointee = self.build_type(ctx, ptr.pointee)?

        self.store_type(ctx, ptr.id, Type::Pointer(heap::new!(PointerType {
            pointee: pointee,
            is_sequence: ptr.is_sequence,
            is_nullable: ptr.is_nullable,
        })))
        return Ok()
    }

    if match TypeExpr::Container(ctr) = expr {
        if match TypeExpr::Named(ident) = ctr.container {
            if ident.repr.equals("seg") {
                if ctr.items.len != 1 {
                    todo!()
                }

                let item = self.build_type(ctx, ctr.items.get!(0))?

                self.store_type(ctx, ctr.id, Type::Seg(heap::new!(SegType { item: item })))
                return Ok()
            }
        }

        // TODO: port
        todo!()
    }

    @unreachable()
}

fn Typer::get_type_id_or_err(
    &self,
    ctx: &TyContext,
    type_name: str,
    loc: Loc,
): Result(TypeId, &Error) {
    let symbol = self.get_symbol(ctx, type_name)
    if symbol == null {
        let alloc = self.registry.error_arena

        let full_message = String::from_str_in(alloc, "Unknown type: ")
        full_message.push_str(type_name)

        return Err(alloc.new!(Error { message: full_message, loc: loc }))
    }

    if symbol.kind == TySymbolKind::Struct {
        // TODO: port inspection

        return Ok(self.intern_type(Type::Struct(heap::new!(StructType {
            struct_index: symbol.col_index,
        }))))
    }

    if symbol.kind == TySymbolKind::TypeAlias {
        let type_alias = self.type_aliases.get!(symbol.col_index)

        // don't print inspection for built-ins
        if self.reporter.in_inspection_mode && symbol.loc.module_id != 0 {
            // TODO: port:
            // self.reporter.print_inspection(InspectInfo {
            //     message: format!("type {type_name} = {}", self.registry.fmt(self.get_type(type_id))),
            //     loc: *loc,
            //     linked_loc: Some(symbol.loc),
            // })
        }

        return Ok(type_alias.type_id)
    }

    todo!()
}

fn Typer::add_builtin_type(&self, ctx: &TyContext, type_: Type) {
    self.define_type(
        ctx,
        type_.to_str().ok, // safe "unwrap"
        type_,
        Loc::internal(),
    )
}

fn Typer::define_type(&self, ctx: &TyContext, name: str, type_: Type, loc: Loc) {
    let _ = self.define_symbol(ctx, name, TySymbolKind::TypeAlias, loc)

    let type_id = self.intern_type(type_)
    self.type_aliases.push!(TyTypeAlias {
        ctx: ctx,
        type_id: type_id,
        expr: null as &TypeExpr, // shouldn't be accessed since alias is already resolved
        resolution: TypeResolution::Resolved,
    })
}

fn Typer::is_types_compatible(&self, slots: &Vec(TypeId), values: &Vec(TypeId)): bool {
    if slots.len != values.len {
        return false
    }

    for i in 0..slots.len {
        if !self.is_type_compatible(self.get_type(slots.get!(i)), self.get_type(values.get!(i))) {
            return false
        }
    }

    return true
}

fn Typer::is_type_compatible(&self, slot: Type, value: Type): bool {
    // TODO: port
    return true
}

fn Typer::extend_expr_info_storage(&self, expr_count: u32) {
    self.registry.expr_info.resize!(
        self.registry.expr_info.len + expr_count,
        EXPR_INFO_INVALID,
    )
}

fn Typer::define_symbol(
    &self,
    ctx: &TyContext,
    symbol_name: str,
    symbol_kind: TySymbolKind,
    symbol_loc: Loc,
): bool {
    let symbol_col_index = 0
    if TySymbolKind::Local == symbol_kind {
        symbol_col_index = self.registry.locals.len
    } else if TySymbolKind::Global == symbol_kind {
        symbol_col_index = self.registry.globals.len
    } else if TySymbolKind::Const == symbol_kind {
        symbol_col_index = self.registry.constants.len
    } else if TySymbolKind::InlineFn == symbol_kind {
        symbol_col_index = self.registry.inline_fns.len
    } else if TySymbolKind::Function == symbol_kind {
        symbol_col_index = self.registry.functions.len
    } else if TySymbolKind::TypeAlias == symbol_kind {
        symbol_col_index = self.type_aliases.len
    } else if TySymbolKind::Struct == symbol_kind {
        symbol_col_index = self.registry.structs.len
    } else if TySymbolKind::Enum == symbol_kind {
        symbol_col_index = self.registry.enums.len
    } else if TySymbolKind::EnumConstructor == symbol_kind {
        symbol_col_index = self.registry.enum_ctors.len
    } else {
        @unreachable()
    }

    let existing_symbol = self.get_symbol(ctx, symbol_name)
    if existing_symbol != null && existing_symbol.ctx_id == ctx.id {
        // TODO: port
    }

    ctx.add_symbol(TySymbol {
        ctx_id: ctx.id,
        name: symbol_name,
        kind: symbol_kind,
        col_index: symbol_col_index,
        loc: symbol_loc,
        defining_fn_index: ctx.fn_index,
    })

    return true
}

fn Typer::get_symbol(&self, ctx: &TyContext, symbol_name: str): &?TySymbol {
    // TODO: change to `ctx.symbols_lookup.get(symbol_name)`
    for &symbol in ctx.symbols.iter!() {
        if symbol.name.equals(symbol_name) {
            return symbol
        }
    }

    if ctx.parent != null {
        return self.get_symbol(ctx.parent, symbol_name)
    }

    return null
}

fn Typer::child_ctx(
    &self,
    parent: &TyContext,
    scope_kind: ScopeKind,
): &TyContext {
    return self.contexts.push!(TyContext {
        module_id: parent.module_id,
        id: self.contexts.len(),
        parent: parent,
        kind: scope_kind,
        fn_index: parent.fn_index,
        expr_id_offset: parent.expr_id_offset,
        symbols: Vec::new!<TySymbol>(),
        symbols_lookup: Map::new!<&str, u32>(),

        inline_fn_call_loc: parent.inline_fn_call_loc,
        is_expr_referenced: parent.is_expr_referenced,
    })
}

fn Typer::load_type(&self, ctx: &TyContext, expr: CodeExpr): &?TypeId {
    return self.registry.get_expr_type(ctx.expr_id_offset, expr)
}

fn Typer::get_const_value_or_err(&self, ctx: &TyContext, expr: CodeExpr): Result(CodeExpr, &VoidError) {
    if match CodeExpr::IntLiteral(_) = expr {
        return Ok(expr)
    }

    // TODO: port
    todo!()
}

fn Typer::store_type(&self, ctx: &TyContext, expr_id: ExprId, type_: Type) {
    let type_id = self.intern_type(type_)
    return self.store_expr_info(ctx, expr_id, type_id)
}

fn Typer::store_expr_info(&self, ctx: &TyContext, expr_id: ExprId, expr_info: ExprInfo) {
    let absolute_expr_id = ctx.expr_id_offset + expr_id
    *self.registry.expr_info.at!(absolute_expr_id) = expr_info
}

fn Typer::intern_type(&self, type_: Type): TypeId {
    return self.registry.intern_type(type_)
}

fn Typer::get_type(&self, type_id: TypeId): Type {
    return self.registry.get_type(type_id)
}

inline fn Typer::report_if_err!(&self, res: infer(T)) {
    if res.err as u32 != 0 {
        self.report_error(res.err)
    }
}

fn Typer::report_error(&self, err: &Error) {
    self.reporter.error(err)
}

// statics

fn Typer::count_primitive_components(registry: &Registry, type_: Type): u32 {
    let layout = ref!(TypeLayout::new())

    Typer::get_type_layout(registry, type_, layout)
    return layout.primitives_count
}

fn Typer::get_type_layout(registry: &Registry, type_: Type, layout: &TypeLayout) {
    if match Type::Never(_) = type_ {
        return
    }
    if match Type::Void(_) = type_ {
        return
    }

    // TODO: port

    if match Type::U32(_) = type_ {
        if layout.primitives != null {
            layout.primitives.push!(type_)
        }
        layout.primitives_count += 1
        layout.alignment = u32::max!(layout.alignment, 4)
        layout.byte_size = Typer::align(layout.byte_size, 4) + 4
        return
    }

    if match Type::I32(_) = type_ {
        if layout.primitives != null {
            layout.primitives.push!(type_)
        }
        layout.primitives_count += 1
        layout.alignment = u32::max!(layout.alignment, 4)
        layout.byte_size = Typer::align(layout.byte_size, 4) + 4
        return
    }

    if match Type::Null(_) = type_ {
        if layout.primitives != null {
            layout.primitives.push!(Type::U32)
        }
        layout.primitives_count += 1
        layout.alignment = u32::max!(layout.alignment, 4)
        layout.byte_size = Typer::align(layout.byte_size, 4) + 4
        return
    }

    if match Type::Pointer(_) = type_ {
        if layout.primitives != null {
            layout.primitives.push!(Type::U32)
        }
        layout.primitives_count += 1
        layout.alignment = u32::max!(layout.alignment, 4)
        layout.byte_size = Typer::align(layout.byte_size, 4) + 4
        return
    }

    if match Type::Seg(seg) = type_ {
        Typer::get_type_layout(registry, Type::U32, layout)
        Typer::get_type_layout(registry, Type::Pointer(heap::new!(PointerType {
            pointee: seg.item,
            is_sequence: true,
            is_nullable: false,
        })), layout)

        layout.byte_size = Typer::align(layout.byte_size, layout.alignment)
        return
    }

    if match Type::Struct(struct_type) = type_ {
        let struct_def = registry.structs.at!(struct_type.struct_index)

        for &field in struct_def.fields.iter!() {
            Typer::get_type_layout(registry, registry.get_type(field.field_type_id), layout)
        }

        layout.byte_size = Typer::align(layout.byte_size, layout.alignment)
        return
    }

    // TODO: port
    todo!()
}

fn Typer::align(value: u32, alignment: u32): u32 {
    return (value + alignment - 1) / alignment * alignment
}

fn Typer::is_naturally_divergent(expr: CodeExpr): bool {
    // TODO: port

    if match CodeExpr::IntLiteral(_) = expr {
        return false
    }

    if match CodeExpr::Ident(_) = expr {
        return false
    }

    if match CodeExpr::Let(_) = expr {
        return false
    }

    if match CodeExpr::If(_) = expr {
        return false
    }

    if match CodeExpr::While(_) = expr {
        return false
    }

    if match CodeExpr::For(_) = expr {
        return false
    }

    // TODO: port

    if match CodeExpr::Break(_) = expr {
        return true
    }

    if match CodeExpr::Continue(_) = expr {
        return true
    }

    if match CodeExpr::Return(_) = expr {
        return true
    }

    // TODO: port

    if match CodeExpr::IntrinsicCall(intrinsic) = expr {
        return intrinsic.fn_name.repr.equals("unreachable")
    }

    // TODO: port

    if match CodeExpr::InfixOp(infix) = expr {
        return Typer::is_naturally_divergent(infix.lhs) || Typer::is_naturally_divergent(infix.rhs)
    }

    // TODO: port

    if match CodeExpr::FnCall(_) = expr {
        return false
    }

    // TODO: port
    todo!()
}

fn Typer::get_primitives(&self, type_: Type): &Vec(Type) {
    let layout = ref!(TypeLayout::new())
    layout.primitives = Vec::new!<Type>()

    Typer::get_type_layout(self.registry, type_, layout)

    return layout.primitives
}

fn Typer::is_noop_cast(primitives1: &Vec(Type), primitives2: &Vec(Type)): bool {
    if primitives1.len != primitives2.len {
        return false
    }

    for i in 0..primitives1.len {
        let p1_wide = Typer::is_wide_int(primitives1.get!(i))
        let p2_wide = Typer::is_wide_int(primitives2.get!(i))

        if p1_wide.err as u32 != 0 || p2_wide.err as u32 != 0 {
            return false
        }

        if p1_wide.ok != p2_wide.ok {
            return false
        }
    }

    return true
}

fn Typer::is_wide_int(type_: Type): Result(bool, &VoidError) {
    if match Type::U64(_) = type_ {
        return Ok(true)
    }
    if match Type::I64(_) = type_ {
        return Ok(true)
    }

    if match Type::Bool(_) = type_ {
        return Ok(false)
    }
    if match Type::U8(_) = type_ {
        return Ok(false)
    }
    if match Type::I8(_) = type_ {
        return Ok(false)
    }
    if match Type::U16(_) = type_ {
        return Ok(false)
    }
    if match Type::I16(_) = type_ {
        return Ok(false)
    }
    if match Type::U32(_) = type_ {
        return Ok(false)
    }
    if match Type::I32(_) = type_ {
        return Ok(false)
    }
    if match Type::Null(_) = type_ {
        return Ok(false)
    }
    if match Type::Pointer(_) = type_ {
        return Ok(false)
    }

    return Err(VoidError::VALUE)
}

fn Typer::process_const_string(&self, value: str): BytesSlice {
    let string_len = value.len

    for pooled_str in self.registry.string_pool.iter!() {
        if pooled_str.value.as_str().equals(value) {
            return BytesSlice {
                ptr: pooled_str.ptr,
                len: string_len,
            }
        }
    }

    let bytes_slice = self.append_data(value.iter!())

    self.registry.string_pool.push!(PooledString {
        value: String::from_str(value),
        ptr: bytes_slice.ptr,
    })

    return bytes_slice
}

fn Typer::append_data(&self, bytes: seg(u8)): BytesSlice {
    let bytes_len = bytes.len
    let offset = self.registry.data_size

    let instrs = Vec::new!<WasmInstr>()
    instrs.push!(WasmInstr::I32Const(heap::new!(WasmInstrI32Const { value: offset as i32 })))

    self.registry.data_size += bytes.len

    let data_bytes = Vec::new!<u8>()
    data_bytes.push_all!(bytes)

    self.registry.datas.push!(WasmData::Active(heap::new!(WasmDataActive {
        offset: WasmExpr { instrs: instrs },
        bytes: data_bytes,
    })))

    return BytesSlice {
        ptr: offset,
        len: bytes_len,
    }
}

fn Typer::push_const_expr_bytes(
    &self,
    output: &Vec(u8),
    item: CodeExpr,
    item_type: Type,
): Result(void, &Error) {
    if match CodeExpr::IntLiteral(int) = item {
        match Type::U32(_) = item_type else {
            // TODO: port other Type variants
            todo!()
        }

        let value = int.value as u32
        output.push!(value as u8)
        output.push!((value >> 8) as u8)
        output.push!((value >> 16) as u8)
        output.push!((value >> 24) as u8)

        return Ok()
    }

    // TODO: port other CodeExpr variants
    todo!()
}

type IncludeInfo = struct {
    file_path: &StringLiteralExpr,
    alias: &?String,
    with_extern: bool,
}

fn get_include_info(arena: &Arena, expr: TopLevelExpr): Result(&?IncludeInfo, &Error) {
    match TopLevelExpr::Intrinsic(intrinsic) = expr else {
        return Ok(null)
    }

    if !intrinsic.fn_name.repr.equals("include") {
        return Ok(null)
    }

    if intrinsic.type_args.len != 0 {
        return Err(bad_signature(arena, intrinsic.fn_name))
    }

    let file_path = null as &?StringLiteralExpr
    let alias = null as &?String
    let with_extern = false

    for arg in intrinsic.args.items.iter!() {
        if match CodeExpr::StringLiteral(str_expr) = arg {
            file_path = str_expr
            continue
        }

        if match CodeExpr::Ident(ident) = arg {
            if ident.repr.equals("with_extern") {
                with_extern = true
                continue
            }
        }

        if match CodeExpr::Assign(assign) = arg {
            if match CodeExpr::Ident(lhs) = assign.lhs {
                if match CodeExpr::StringLiteral(rhs) = assign.rhs {
                    if lhs.repr.equals("alias") {
                        alias = heap::new!(rhs.value.clone())
                        continue
                    }
                }
            }
        }
    }

    if file_path == null {
        return Err(bad_signature(arena, intrinsic.fn_name))
    }

    return Ok(heap::new!(IncludeInfo {
        file_path: file_path,
        alias: alias,
        with_extern: with_extern,
    }))

    fn bad_signature(arena: &Arena, fn_name: IdentExpr): &Error {
        let message = String::from_str_in(arena, "Invalid call, expected signature: @")
        do message.push_str(it) with (
            fn_name.repr,
            "(<str-literal>, [with_extern, alias = <str-literal>])",
        )

        return arena.new!(Error {
            message: message,
            loc: fn_name.loc,
        })
    }
}

// utils

type StableVec = struct {
    chunks: &Vec(&Vec),
    chunk_size: u32,
}

inline fn StableVec::new!<T>(): StableVec(T) {
    StableVec {
        chunks: Vec::new!<&Vec>(),
        chunk_size: 8,
    }
}

inline fn StableVec::push!(self: infer(Self), item: itemof(Self)): &typeof(item) {
    if self.chunks.len == 0 \
        || self.chunks.get!(self.chunks.len - 1).len == self.chunk_size
    {
        self.chunks.push!(Vec::with_capacity!<typeof(item)>(self.chunk_size))
    }

    let last_chunk = self.chunks.get!(self.chunks.len - 1) as &Vec(typeof(item))
    last_chunk.push!(item)

    last_chunk.at!(last_chunk.len - 1)
}

fn StableVec::len(self): u32 {
    let chunks_len = self.chunks.len
    if chunks_len == 0 {
        return 0
    }

    return (chunks_len - 1) * self.chunk_size \
        + self.chunks.get!(chunks_len - 1).len
}

