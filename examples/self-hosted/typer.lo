fn Typer::type_code_block(
    &self,
    ctx: &TyContext,
    block: &CodeBlock,
    void_only: bool,
): Type {
    let diverges = false
    let diverges_naturally = false

    for expr in block.exprs.iter!() {
        if diverges {
            // TODO: port
        }

        let type_id = self.type_code_expr_and_load(ctx, expr) catch err {
            self.report_error(err)
            continue
        }

        let expr_type = self.get_type(type_id)

        if Typer::count_primitive_components(self.registry, expr_type) > 0 && void_only {
            // TODO: port
        }

        if expr_type.equals(Type::Never) {
            // TODO: port
        }
    }

    if !diverges_naturally && !diverges && ctx.kind == ScopeKind::Function {
        let fn_info = self.registry.functions.get!(*ctx.fn_index)

        // TODO: port
    }

    self.store_expr_info(ctx, block.block_expr_id, self.registry.block_info.len)
    self.registry.block_info.push!(BlockInfo {
        needs_explicit_trap: void_only && diverges && !diverges_naturally,
    })

    if diverges {
        return Type::Never
    }

    return Type::Void
}

fn Typer::type_code_expr_and_load(&self, ctx: &TyContext, expr: CodeExpr): Result(TypeId, &Error) {
    self.type_code_expr(ctx, expr)?

    let type_id = self.load_type(ctx, expr)
    if type_id == null {
        self.reporter.abort_due_to_compiler_bug(
            "Expression should only return ok if it stored a type",
            expr.loc(),
        )
    }

    return Ok(*type_id)
}

// TODO: port
fn Typer::type_code_expr(&self, ctx: &TyContext, expr: CodeExpr): Result(void, &Error) {
    // TODO: port

    if match CodeExpr::IntLiteral(int_literal) = expr {
        // TODO: port the full version
        self.store_type(ctx, int_literal.id, Type::U32)

        return Ok()
    }

    // TODO: port

    if match CodeExpr::Ident(ident) = expr {
        let value_info = self.get_value_info(ctx, *ident)?
        self.registry.value_info.push!(value_info)

        self.store_expr_info(ctx, ident.id, self.registry.value_info.len - 1)
        return Ok()
    }

    // TODO: port

    if match CodeExpr::BoolLiteral(bool_literal) = expr {
        self.store_type(ctx, bool_literal.id, Type::Bool)
        return Ok()
    }

    if match CodeExpr::Let(let_expr) = expr {
        self.type_code_expr(ctx, let_expr.value) catch err {
            self.report_error(err)
            self.store_type(ctx, let_expr.id, Type::Void)
            return Ok()
        }

        let value_type_id = *self.load_type(ctx, let_expr.value)

        if self.get_type(value_type_id).equals(Type::Never) {
            self.store_type(ctx, let_expr.id, Type::Never)
        } else {
            self.store_type(ctx, let_expr.id, Type::Void)
        }

        let _ = self.define_local(
            ctx,
            &let_expr.name.repr,
            value_type_id,
            let_expr.name.loc,
            let_expr.name.id,
            false,
        )
        return Ok()
    }

    if match CodeExpr::IntrinsicCall(call) = expr {
        // TODO: port

        if call.fn_name.repr.equals("unreachable") {
            self.store_type(ctx, call.id, Type::Never)

            // TODO: port

            return Ok()
        }

        // TODO: port
    }

    if match CodeExpr::InfixOp(infix_op) = expr {
        let lhs_type_id_res = self.type_code_expr_and_load(ctx, infix_op.lhs)
        let rhs_type_id = self.type_code_expr_and_load(ctx, infix_op.rhs)?
        let lhs_type_id = lhs_type_id_res?

        if !self.is_type_compatible(self.get_type(lhs_type_id), self.get_type(rhs_type_id)) {
            let message = String::new_in(self.registry.error_arena, 16)
            do message.push_str(it) with (
                "Operands are not of the same type: lhs = ",
                self.registry.fmt(self.get_type(lhs_type_id)),
                ", rhs = ",
                self.registry.fmt(self.get_type(rhs_type_id)),
            )

            self.report_error(self.registry.error_arena.new!(Error {
                message: message,
                loc: infix_op.op_loc,
            }))
        }

        // TODO: port
        let result_type_id = lhs_type_id
        if infix_op.op_tag == InfixOpTag::Less || infix_op.op_tag == InfixOpTag::And || infix_op.op_tag == InfixOpTag::Or {
            result_type_id = self.intern_type(Type::Bool)
        }
        if infix_op.op_tag == InfixOpTag::MulAssign {
            result_type_id = self.intern_type(Type::Void)
        }

        let is_compound_assignment = false
        let base_op = infix_op.op_tag

        // TODO: port
        if infix_op.op_tag == InfixOpTag::MulAssign {
            is_compound_assignment = true
            base_op = InfixOpTag::Mul

            // TODO: port
        }

        let op_kind = self.get_binary_op_kind(
            ctx,
            base_op,
            self.get_type(lhs_type_id),
            infix_op.op_loc,
        )?

        self.store_expr_info(ctx, infix_op.id, self.registry.binary_op_info.len)
        self.registry.binary_op_info.push!(BinaryOpInfo {
            is_compound_assignment: is_compound_assignment,
            op_kind: op_kind,
            result_type_id: result_type_id,
        })

        return Ok()
    }

    // TODO: port

    if match CodeExpr::FnCall(call) = expr {
        // TODO: port enum constructor calls

        self.type_fn_call(
            ctx,
            call.fn_name.repr,
            null,
            call.args.items,
            call.id,
            call.fn_name.loc,
        )?
        return Ok()
    }

    // TODO: port

    if match CodeExpr::Return(return_expr) = expr {
        self.store_type(ctx, return_expr.id, Type::Never)

        let return_type = Type::Void
        if return_expr.expr != null {
            let return_type_id = self.type_code_expr_and_load(ctx, *return_expr.expr)?
            return_type = self.get_type(return_type_id)
        }

        if ctx.fn_index == null {
            self.report_error(self.registry.error_arena.new!(Error {
                message: String::from_str_in(
                    self.registry.error_arena,
                    "Cannot use `return` in const context",
                ),
                loc: return_expr.loc,
            }))
            return Ok()
        }

        let fn_return_type = self.get_type(self.registry.functions.at!(*ctx.fn_index).type_.output)
        if !self.is_type_compatible(fn_return_type, return_type) {
            let message = String::from_str_in(
                self.registry.error_arena,
                "Invalid return type: ",
            )
            message.push_str(self.registry.fmt(return_type))
            message.push_str(", expected: ")
            message.push_str(self.registry.fmt(fn_return_type))

            self.report_error(self.registry.error_arena.new!(Error {
                message: message,
                loc: return_expr.loc,
            }))
        }

        return Ok()
    }

    if match CodeExpr::If(if_expr) = expr {
        let then_ctx = self.child_ctx(ctx, ScopeKind::Block)

        // TODO: port
        if match IfCond::Expr(cond_expr) = if_expr.cond {
            let _ = self.type_code_expr_and_load(ctx, *cond_expr)
        }

        let then_type = self.type_code_block(then_ctx, &if_expr.then_block, true)

        let else_type = Type::Void
        if match ElseBlock::Else(else_block) = if_expr.else_block {
            let else_ctx = self.child_ctx(ctx, ScopeKind::Block)
            else_type = self.type_code_block(else_ctx, else_block, true)
        }

        // TODO: port

        if then_type.equals(Type::Never) && else_type.equals(Type::Never) {
            self.store_type(ctx, if_expr.id, Type::Never)
        } else {
            self.store_type(ctx, if_expr.id, Type::Void)
        }
        return Ok()
    }

    // TODO: port

    todo!()
}

fn Typer::get_binary_op_kind(
    &self,
    ctx: &TyContext,
    op_tag: InfixOpTag,
    operand_type: Type,
    op_loc: Loc,
): Result(WasmBinaryOpKind, &Error) {
    // TODO: port
    let signed = false
    let wasm_op_type = WasmType::I32

    // TODO: port
    if !operand_type.equals(Type::Bool) {
        match Type::U32(_) = operand_type else {
            todo!()
        }
    }

    // TODO: port
    if wasm_op_type == WasmType::I32 {
        if op_tag == InfixOpTag::Less {
            if signed {
                return Ok(WasmBinaryOpKind::I32_LT_S)
            }
            return Ok(WasmBinaryOpKind::I32_LT_U)
        }
        if op_tag == InfixOpTag::Add {
            return Ok(WasmBinaryOpKind::I32_ADD)
        }
        if op_tag == InfixOpTag::Sub {
            return Ok(WasmBinaryOpKind::I32_SUB)
        }
        if op_tag == InfixOpTag::Mul {
            return Ok(WasmBinaryOpKind::I32_MUL)
        }
        if op_tag == InfixOpTag::And {
            return Ok(WasmBinaryOpKind::I32_AND)
        }
        if op_tag == InfixOpTag::Or {
            return Ok(WasmBinaryOpKind::I32_OR)
        }
    }

    // TODO: port
    todo!()
}

fn Typer::type_fn_call(
    &self,
    ctx: &TyContext,
    fn_name: str,
    receiver_arg: &?CodeExpr,
    args: &Vec(CodeExpr),
    call_expr_id: ExprId,
    loc: Loc,
): Result(void, &Error) {
    let all_good = true
    let arg_types = Vec::new!<TypeId>()

    // TODO: port
    if receiver_arg != null {
        todo!()
    }

    for arg in args.iter!() {
        let type_id = self.type_code_expr_and_load(ctx, arg) catch err {
            self.report_error(err)
            all_good = false
            continue
        }
        arg_types.push!(type_id)
    }

    let fn_index = self.get_fn_index_for_call(ctx, fn_name, loc)?
    let fn_info = self.registry.functions.at!(fn_index)

    self.store_expr_info(ctx, call_expr_id, self.registry.call_info.len)
    self.registry.call_info.push!(CallInfo {
        value: CallInfoValue::FnCall(fn_index),
        return_type_id: fn_info.type_.output,
    })

    // TODO: port inspection

    if all_good && !self.is_types_compatible(fn_info.type_.inputs, arg_types) {
        // TODO: port
        todo!()
    }

    return Ok()
}

fn Typer::get_fn_index_for_call(
    &self,
    ctx: &TyContext,
    fn_name: str,
    loc: Loc,
): Result(u32, &Error) {
    let symbol = self.get_symbol(ctx, fn_name)
    if symbol == null {
        let message = String::from_str_in(self.registry.error_arena, "Unknown function: ")
        message.push_str(fn_name)

        return Err(self.registry.error_arena.new!(Error {
            message: message,
            loc: loc,
        }))
    }

    if symbol.kind != TySymbolKind::Function {
        let message = String::from_str_in(self.registry.error_arena, "Trying to call ")
        do message.push_str(it) with (
            fn_name,
            " which is not a function, defined at: ",
            symbol.loc.to_string_in(self.registry.error_arena, self.registry).as_str(),
        )

        return Err(self.registry.error_arena.new!(Error {
            message: message,
            loc: loc,
        }))
    }

    return Ok(symbol.col_index)
}

fn Typer::get_value_info(
    &self,
    ctx: &TyContext,
    var_name: IdentExpr,
): Result(ValueInfo, &Error) {
    let symbol = self.get_symbol(ctx, var_name.repr)
    if symbol == null {
        let message = String::from_str_in(self.registry.error_arena, "Unknown variable: ")
        message.push_str(var_name.repr)

        return Err(self.registry.error_arena.new!(Error {
            message: message,
            loc: var_name.loc,
        }))
    }

    if symbol.kind == TySymbolKind::Local {
        let local_def = self.registry.locals.at!(symbol.col_index)

        // TODO: port inspection

        return Ok(ValueInfo {
            kind: ValueKind::Local,
            col_index: symbol.col_index,
            type_id: local_def.local_type_id,
        })
    }

    // TODO: port
    todo!()
}

fn Typer::define_local(
    &self,
    ctx: &TyContext,
    name: &str,
    type_id: TypeId,
    loc: Loc,
    bind_id: ExprId,
    always_define: bool,
): bool {
    if self.reporter.in_inspection_mode {
        // TODO: port:
        // self.reporter.print_inspection(InspectInfo {
        //     message: format!("let {}: {}", name, self.registry.fmt(self.get_type(type_id))),
        //     loc: loc,
        //     linked_loc: None,
        // })
    }

    let defined = !(*name).equals("_") && self.define_symbol(ctx, *name, TySymbolKind::Local, loc)
    if defined || always_define {
        self.define_local_no_symbol(ctx, name, type_id, bind_id)
    }

    return defined
}

fn Typer::define_local_no_symbol(
    &self,
    ctx: &TyContext,
    local_name: &?str,
    type_id: TypeId,
    bind_id: ExprId,
) {
    let _ = self.registry.add_local(*ctx.fn_index, local_name, type_id)

    self.store_expr_info(ctx, bind_id, self.registry.value_info.len)
    self.registry.value_info.push!(ValueInfo {
        kind: ValueKind::Local,
        col_index: self.registry.locals.len - 1,
        type_id: type_id,
    })
}

fn Typer::build_type(&self, ctx: &TyContext, expr: TypeExpr): Result(TypeId, &Error) {
    self.type_type_expr(ctx, expr)?

    let expr_info = self.registry.get_expr_info(ctx.expr_id_offset, expr.id())
    if expr_info == null {
        self.reporter.abort_due_to_compiler_bug(
            "Type expression should only return ok if it stored a type",
            expr.loc(),
        )
    }

    return Ok(*expr_info)
}

fn Typer::type_type_expr(&self, ctx: &TyContext, expr: TypeExpr): Result(void, &Error) {
    if match TypeExpr::Named(ident) = expr {
        let type_id = self.get_type_id_or_err(ctx, ident.repr, ident.loc)?
        self.store_expr_info(ctx, ident.id, type_id)
        return Ok()
    }

    if match TypeExpr::Pointer(e) = expr {
        todo!()
    }

    if match TypeExpr::Container(e) = expr {
        todo!()
    }

    @unreachable()
}

fn Typer::get_type_id_or_err(
    &self,
    ctx: &TyContext,
    type_name: str,
    loc: Loc,
): Result(TypeId, &Error) {
    let symbol = self.get_symbol(ctx, type_name)
    if symbol == null {
        let alloc = self.registry.error_arena

        let full_message = String::from_str_in(alloc, "Unknown type: ")
        full_message.push_str(type_name)

        return Err(alloc.new!(Error { message: full_message, loc: loc }))
    }

    if symbol.kind == TySymbolKind::TypeAlias {
        let type_alias = self.type_aliases.get!(symbol.col_index)

        // don't print inspection for built-ins
        if self.reporter.in_inspection_mode && symbol.loc.module_id != 0 {
            // TODO: port:
            // self.reporter.print_inspection(InspectInfo {
            //     message: format!("type {type_name} = {}", self.registry.fmt(self.get_type(type_id))),
            //     loc: *loc,
            //     linked_loc: Some(symbol.loc),
            // })
        }

        return Ok(type_alias.type_id)
    }

    todo!()
}

fn Typer::add_builtin_type(&self, ctx: &TyContext, type_: Type) {
    self.define_type(
        ctx,
        type_.to_str().ok, // safe "unwrap"
        type_,
        Loc::internal(),
    )
}

fn Typer::define_type(&self, ctx: &TyContext, name: str, type_: Type, loc: Loc) {
    let _ = self.define_symbol(ctx, name, TySymbolKind::TypeAlias, loc)

    let type_id = self.intern_type(type_)
    self.type_aliases.push!(TyTypeAlias {
        ctx: ctx,
        type_id: type_id,
        expr: null as &TypeExpr, // shouldn't be accessed since alias is already resolved
        resolution: TypeResolution::Resolved,
    })
}

fn Typer::is_types_compatible(&self, slots: &Vec(TypeId), values: &Vec(TypeId)): bool {
    if slots.len != values.len {
        return false
    }

    for i in 0..slots.len {
        if !self.is_type_compatible(self.get_type(slots.get!(i)), self.get_type(values.get!(i))) {
            return false
        }
    }

    return true
}

fn Typer::is_type_compatible(&self, slot: Type, value: Type): bool {
    // TODO: port
    return true
}

fn Typer::extend_expr_info_storage(&self, expr_count: u32) {
    self.registry.expr_info.resize!(
        self.registry.expr_info.len + expr_count,
        EXPR_INFO_INVALID,
    )
}

fn Typer::define_symbol(
    &self,
    ctx: &TyContext,
    symbol_name: str,
    symbol_kind: TySymbolKind,
    symbol_loc: Loc,
): bool {
    let symbol_col_index = 0
    if TySymbolKind::Local == symbol_kind {
        symbol_col_index = self.registry.locals.len
    } else if TySymbolKind::Global == symbol_kind {
        symbol_col_index = self.registry.globals.len
    } else if TySymbolKind::Const == symbol_kind {
        symbol_col_index = self.registry.constants.len
    } else if TySymbolKind::InlineFn == symbol_kind {
        symbol_col_index = self.registry.inline_fns.len
    } else if TySymbolKind::Function == symbol_kind {
        symbol_col_index = self.registry.functions.len
    } else if TySymbolKind::TypeAlias == symbol_kind {
        symbol_col_index = self.type_aliases.len
    } else if TySymbolKind::Struct == symbol_kind {
        symbol_col_index = self.registry.structs.len
    } else if TySymbolKind::Enum == symbol_kind {
        symbol_col_index = self.registry.enums.len
    } else if TySymbolKind::EnumConstructor == symbol_kind {
        symbol_col_index = self.registry.enum_ctors.len
    } else {
        @unreachable()
    }

    let existing_symbol = self.get_symbol(ctx, symbol_name)
    if existing_symbol != null && existing_symbol.ctx_id == ctx.id {
        // TODO: port
    }

    ctx.add_symbol(TySymbol {
        ctx_id: ctx.id,
        name: symbol_name,
        kind: symbol_kind,
        col_index: symbol_col_index,
        loc: symbol_loc,
    })

    return true
}

fn Typer::get_symbol(&self, ctx: &TyContext, symbol_name: str): &?TySymbol {
    // TODO: change to `ctx.symbols_lookup.get(symbol_name)`
    for &symbol in ctx.symbols.iter!() {
        if symbol.name.equals(symbol_name) {
            return symbol
        }
    }

    if ctx.parent != null {
        return self.get_symbol(ctx.parent, symbol_name)
    }

    return null
}

fn Typer::child_ctx(
    &self,
    parent: &TyContext,
    scope_kind: ScopeKind,
): &TyContext {
    return self.contexts.push!(TyContext {
        module_id: parent.module_id,
        id: self.contexts.len(),
        parent: parent,
        kind: scope_kind,
        fn_index: parent.fn_index,
        expr_id_offset: parent.expr_id_offset,
        symbols: Vec::new!<TySymbol>(),
        symbols_lookup: Map::new!<&str, u32>(),

        inline_fn_call_loc: parent.inline_fn_call_loc,
        is_expr_referenced: parent.is_expr_referenced,
    })
}

fn Typer::load_type(&self, ctx: &TyContext, expr: CodeExpr): &?TypeId {
    return self.registry.get_expr_type(ctx.expr_id_offset, expr)
}

fn Typer::store_type(&self, ctx: &TyContext, expr_id: ExprId, type_: Type) {
    let type_id = self.intern_type(type_)
    return self.store_expr_info(ctx, expr_id, type_id)
}

fn Typer::store_expr_info(&self, ctx: &TyContext, expr_id: ExprId, expr_info: ExprInfo) {
    let absolute_expr_id = ctx.expr_id_offset + expr_id
    *self.registry.expr_info.at!(absolute_expr_id) = expr_info
}

fn Typer::intern_type(&self, type_: Type): TypeId {
    return self.registry.intern_type(type_)
}

fn Typer::get_type(&self, type_id: TypeId): Type {
    return self.registry.get_type(type_id)
}

fn Typer::report_error(&self, err: &Error) {
    self.reporter.error(err)
}

// statics

fn Typer::count_primitive_components(registry: &Registry, type_: Type): u32 {
    let layout = ref!(TypeLayout::new())

    Typer::get_type_layout(registry, type_, layout)
    return layout.primitives_count
}

fn Typer::get_type_layout(registry: &Registry, type_: Type, layout: &TypeLayout) {
    // TODO: port

    if match Type::U32(_) = type_ {
        if layout.primitives != null {
            layout.primitives.push!(type_)
        }
        layout.primitives_count += 1
        layout.alignment = u32::max!(layout.alignment, 4)
        layout.byte_size = Typer::align(layout.byte_size, 4) + 4
        return
    }

    // TODO: port
}

fn Typer::align(value: u32, alignment: u32): u32 {
    return (value + alignment - 1) / alignment * alignment
}

type IncludeInfo = struct {
    file_path: &StringLiteralExpr,
    alias: &?String,
    with_extern: bool,
}

fn get_include_info(arena: &Arena, expr: TopLevelExpr): Result(&?IncludeInfo, &Error) {
    match TopLevelExpr::Intrinsic(intrinsic) = expr else {
        return Ok(null)
    }

    if !intrinsic.fn_name.repr.equals("include") {
        return Ok(null)
    }

    if intrinsic.type_args.len != 0 {
        return Err(bad_include_signature(arena, intrinsic.fn_name))
    }

    let file_path = null as &?StringLiteralExpr
    let alias = null as &?String
    let with_extern = false

    for arg in intrinsic.args.items.iter!() {
        if match CodeExpr::StringLiteral(str_expr) = arg {
            file_path = str_expr
            continue
        }

        if match CodeExpr::Ident(ident) = arg {
            if ident.repr.equals("with_extern") {
                with_extern = true
                continue
            }
        }

        if match CodeExpr::Assign(assign) = arg {
            if match CodeExpr::Ident(lhs) = assign.lhs {
                if match CodeExpr::StringLiteral(rhs) = assign.rhs {
                    if lhs.repr.equals("alias") {
                        alias = heap::new!(rhs.value.clone())
                        continue
                    }
                }
            }
        }
    }

    if file_path == null {
        return Err(bad_include_signature(arena, intrinsic.fn_name))
    }

    return Ok(heap::new!(IncludeInfo {
        file_path: file_path,
        alias: alias,
        with_extern: with_extern,
    }))
}

// TODO?: support nested functions?
fn bad_include_signature(arena: &Arena, fn_name: IdentExpr): &Error {
    let message = String::from_str_in(arena, "Invalid call, expected signature: @")
    do message.push_str(it) with (
        fn_name.repr,
        "(<str-literal>, [with_extern, alias = <str-literal>])",
    )

    return arena.new!(Error {
        message: message,
        loc: fn_name.loc,
    })
}

// utils

type StableVec = struct {
    chunks: &Vec(&Vec),
    chunk_size: u32,
}

inline fn StableVec::new!<T>(): StableVec(T) {
    StableVec {
        chunks: Vec::new!<&Vec>(),
        chunk_size: 8,
    }
}

inline fn StableVec::push!(self: infer(Self), item: itemof(Self)): &typeof(item) {
    if self.chunks.len == 0 \
        || self.chunks.get!(self.chunks.len - 1).len == self.chunk_size
    {
        self.chunks.push!(Vec::with_capacity!<typeof(item)>(self.chunk_size))
    }

    let last_chunk = self.chunks.get!(self.chunks.len - 1) as &Vec(typeof(item))
    last_chunk.push!(item)

    last_chunk.at!(last_chunk.len - 1)
}

fn StableVec::len(self): u32 {
    let chunks_len = self.chunks.len
    if chunks_len == 0 {
        return 0
    }

    return (chunks_len - 1) * self.chunk_size \
        + self.chunks.get!(chunks_len - 1).len
}

