fn Typer::process_top_level_exprs(&self, ctx: &TyContext) {
    let module = self.registry.modules.get!(ctx.module_id)

    for expr in module.parser.ast.iter!() {
        if match TopLevelExpr::Type(_) = expr {
            continue // skip, processed in previous passes
        }

        if match TopLevelExpr::Fn(fn_def) = expr {
            if fn_def.is_inline {
                continue // skip, processed in pass_collect_all_symbols
            }

            let symbol = self.get_symbol(ctx, fn_def.decl.fn_name.repr)
            if symbol == null {
                @unreachable()
            }
            if symbol.kind != TySymbolKind::Function {
                continue
            }

            let fn_info = self.registry.functions.get!(symbol.col_index)

            // TODO: implement
            // let self_type_id = ...

            if fn_def.decl.return_type != null {
                let type_id = self.build_type(ctx, fn_def.decl.return_type) catch err {
                    self.report_error(err)
                    continue
                }
                fn_info.type_.output = type_id
            }

            // TODO: implement
            // for fn_param in &fn_def.decl.param ...
        }

        // TODO: implement
    }
}

