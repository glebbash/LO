fn Typer::process_top_level_exprs(&self, ctx: &TyContext) {
    let module = self.registry.modules.get!(ctx.module_id)

    for expr in module.parser.ast.iter!() {
        if match TopLevelExpr::TypeDef(_) = expr {
            continue // skip, processed in previous passes
        }

        if match TopLevelExpr::Fn(fn_def) = expr {
            if fn_def.is_inline {
                continue // skip, processed in pass_collect_all_symbols
            }

            let symbol = self.get_symbol(ctx, fn_def.decl.fn_name.repr)
            if symbol == null {
                @unreachable()
            }
            if symbol.kind != TySymbolKind::Function {
                continue
            }

            let fn_info = self.registry.functions.at!(symbol.col_index)

            let self_type_id = self.get_fn_self_type(ctx, fn_def.decl.fn_name, fn_def.decl.params) catch err {
                self.report_error(err)
                continue
            }

            if fn_def.decl.return_type != null {
                let type_id = self.build_type(ctx, *fn_def.decl.return_type) catch err {
                    self.report_error(err)
                    continue
                }

                fn_info.type_.output = type_id
            }

            for &fn_param in fn_def.decl.params.iter!() {
                if fn_param.param_name.repr.equals("_") {
                    self.report_error(self.registry.error_arena.new!(Error {
                        message: String::from_str_in(
                            self.registry.error_arena,
                            "Invalid fn param name `_` is not allowed here",
                        ),
                        loc: fn_param.param_name.loc,
                    }))
                }

                let param_type_id = self.get_fn_param_type(ctx, fn_param, self_type_id, false) catch err {
                    self.report_error(err)
                    continue
                }

                fn_info.type_.inputs.push!(param_type_id)

                fn_info.params.push!(FnParameter {
                    param_name: &fn_param.param_name,
                    param_type_id: param_type_id,
                })
            }
        }

        // TODO: port
    }
}

fn Typer::get_fn_param_type(
    &self,
    ctx: &TyContext,
    fn_param: &FnParam,
    self_type_id: &?TypeId,
    infer_allowed: bool,
): Result(TypeId, &Error) {
    // TODO: port self and infer params

    if match FnParamType::Type(param_type) = fn_param.param_type {
        return self.build_type(ctx, param_type.expr)
    }

    todo!()
}

fn Typer::get_fn_self_type(
    &self,
    ctx: &TyContext,
    fn_name: IdentExpr,
    fn_params: &Vec(FnParam),
): Result(&?TypeId, &Error) {
    // TODO: port
    return Ok(null)
}

fn Typer::type_fns(&self) {
    for fn_def in self.registry.functions.iter!() {
        match FnSource::Guest(fn_info) = fn_def.source else {
            continue
        }

        let module_ctx = self.module_info.get!(fn_info.module_id).ctx

        let ctx = self.child_ctx(module_ctx, ScopeKind::Function)
        ctx.fn_index = &fn_info.lo_fn_index

        for param in fn_def.params.iter!() {
            let _ = self.define_local(
                ctx,
                &param.param_name.repr,
                param.param_type_id,
                param.param_name.loc,
                param.param_name.id,
                true,
            )
        }

        let _ = self.type_code_block(ctx, fn_info.body, true)
    }
}

