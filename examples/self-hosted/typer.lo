@include("./common.lo")

// TODO: implement module

type TypeId = u32

type Type = enum (&?void) {
    Never(&?void),
    Null(&?void),
    Void(&?void),
    Bool(&?void),
    U8(&?void),
    I8(&?void),
    U16(&?void),
    I16(&?void),
    U32(&?void),
    I32(&?void),
    U64(&?void),
    I64(&?void),
    F32(&?void),
    F64(&?void),
    Pointer(&PointerType),
    Struct(&StructType),
    Enum(&EnumType),
    Seg(&SegType),
    Result(&ResultType),
    Container(&ContainerType),
}

// TODO: implement
fn Type::to_str(self): Result(str, VoidError) {
    return Ok("")
}

type PointerType = struct {
    pointee: TypeId,
    is_sequence: bool,
    is_nullable: bool,
}

type StructType = struct {
    struct_index: u32,
}

type EnumType = struct {
    enum_index: u32,
}

type SegType = struct {
    item: TypeId,
}

type ResultType = struct {
    ok: TypeId,
    err: TypeId,
}

type ContainerType = struct {
    container: TypeId,
    items: &Vec(TypeId),
}

type ScopeKind = enum {
    Global,
    Function,
    Block,
    Loop,
    ForLoop,
    InlineFn,
}

type TySymbolKind = enum {
    TypeAlias,
    Struct,
    Enum,

    Local,
    Global,
    Const,

    InlineFn,
    Function,
    EnumConstructor,
}

type TySymbol = struct {
    ctx_id: u32,
    name: str,
    kind: TySymbolKind,
    col_index: u32,
    loc: Loc,
}

type TyContext = struct {
    module_id: u32,
    id: u32,
    parent: &?TyContext,
    kind: ScopeKind,
    fn_index: &?u32,
    expr_id_offset: u32,
    symbols: &Vec(TySymbol),
    symbols_lookup: &Map(&str, u32),

    inline_fn_call_loc: &?Loc,
    is_expr_referenced: bool,
}

// TODO: implement
fn TyContext::add_symbol(&self, symbol: TySymbol) {}

type TyModuleInfo = struct {
    ctx: &TyContext,
}

type Typer = struct {
    // context
    registry: &Registry,
    reporter: &Reporter,

    // state
    contexts: StableVec(TyContext),
    module_info: &Vec(TyModuleInfo),
    type_aliases: &Vec(TypeId),
    allocated_strings: &Vec(String),
    forbid_memory_loc: &?Loc,
    autodefine_memory: bool,
}

fn Typer::new(registry: &Registry): &Typer {
    return heap::new!(Typer {
        registry: registry,
        reporter: registry.reporter,

        contexts: StableVec::new!<TyContext>(),
        module_info: Vec::new!<TyModuleInfo>(),
        type_aliases: Vec::new!<TypeId>(),
        allocated_strings: Vec::new!<String>(),
        forbid_memory_loc: null,
        autodefine_memory: false,
    })
}

fn Typer::type_all(&self) {
    let global_ctx = self.contexts.push!(TyContext {
        module_id: u32::MAX, // global scope has no module
        id: 0,
        parent: null,
        kind: ScopeKind::Global,
        fn_index: null,
        expr_id_offset: 0,
        symbols: Vec::new!<TySymbol>(),
        symbols_lookup: Map::new!<&str, u32>(),

        inline_fn_call_loc: null,
        is_expr_referenced: false,
    })

    self.module_info.reserve(self.registry.modules.len)
    for module in self.registry.modules.iter!() {
        let module_ctx = self.child_context(global_ctx, ScopeKind::Global)
        module_ctx.module_id = module.id

        self.module_info.push!(TyModuleInfo { ctx: module_ctx })
    }

    self.extend_expr_info_storage(self.registry.expr_id_count)

    self.add_builtin_type(global_ctx, Type::Never(null))
    self.add_builtin_type(global_ctx, Type::Void(null))
    self.add_builtin_type(global_ctx, Type::Bool(null))
    self.add_builtin_type(global_ctx, Type::U8(null))
    self.add_builtin_type(global_ctx, Type::I8(null))
    self.add_builtin_type(global_ctx, Type::U16(null))
    self.add_builtin_type(global_ctx, Type::I16(null))
    self.add_builtin_type(global_ctx, Type::U32(null))
    self.add_builtin_type(global_ctx, Type::I32(null))
    self.add_builtin_type(global_ctx, Type::F32(null))
    self.add_builtin_type(global_ctx, Type::U64(null))
    self.add_builtin_type(global_ctx, Type::I64(null))
    self.add_builtin_type(global_ctx, Type::F64(null))

    // TODO: port
}

fn Typer::child_context(
    &self,
    parent: &TyContext,
    scope_kind: ScopeKind,
): &TyContext {
    return self.contexts.push!(TyContext {
        module_id: parent.module_id,
        id: self.contexts.len(),
        parent: parent,
        kind: scope_kind,
        fn_index: parent.fn_index,
        expr_id_offset: parent.expr_id_offset,
        symbols: Vec::new!<TySymbol>(),
        symbols_lookup: Map::new!<&str, u32>(),

        inline_fn_call_loc: parent.inline_fn_call_loc,
        is_expr_referenced: parent.is_expr_referenced,
    })
}

fn Typer::extend_expr_info_storage(&self, expr_count: u32) {
    self.registry.expr_info.resize!(
        self.registry.expr_info.len + expr_count,
        EXPR_INFO_INVALID,
    )
}

fn Typer::add_builtin_type(&self, ctx: &TyContext, type_: Type) {
    ctx.add_symbol(TySymbol {
        ctx_id: 0,
        name: type_.to_str().unwrap!(),
        kind: TySymbolKind::TypeAlias,
        col_index: self.type_aliases.len,
        loc: Loc::internal(),
    })

    let type_id = self.intern_type(type_)
    self.type_aliases.push!(type_id)
}

// TODO: implement
fn Typer::intern_type(&self, type_: Type): u32 {
    return 0
}

// utils

type StableVec = struct {
    chunks: &Vec(&Vec),
    chunk_size: u32,
}

inline fn StableVec::new!<T>(): StableVec(T) {
    StableVec {
        chunks: Vec::new!<&Vec>(),
        chunk_size: 8,
    }
}

// TODO: check why &typeof(item) in return type doesn't work
inline fn StableVec::push!(self, item: itemof(typeof(self))): &itemof(typeof(self)) {
    if self.chunks.len == 0 \
        || self.chunks.get!(self.chunks.len - 1).len == self.chunk_size
    {
        self.chunks.push!(Vec::with_capacity!<typeof(item)>(self.chunk_size))
    }

    let last_chunk = self.chunks.get!(self.chunks.len - 1)
    (last_chunk as &Vec(typeof(item))).push!(item)
    last_chunk
}

fn StableVec::len(self): u32 {
    let chunks_len = self.chunks.len
    if chunks_len == 0 {
        return 0
    }

    return (chunks_len - 1) * self.chunk_size \
        + self.chunks.get!(chunks_len - 1).len
}

