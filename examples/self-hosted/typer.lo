@include("./common.lo")
@include("./ast.lo")
@include("./registry.lo")
@include("./wasm.lo")

type Type = enum (&void) {
    Never,
    Null,
    Void,
    Bool,
    U8,
    I8,
    U16,
    I16,
    U32,
    I32,
    U64,
    I64,
    F32,
    F64,
    Pointer(&PointerType),
    Struct(&StructType),
    Enum(&EnumType),
    Seg(&SegType),
    Result(&ResultType),
    Container(&ContainerType),
}

// TODO: complete and maybe find a better way to do this
fn Type::equals(self, other): bool {
    if match Type::Never(_) = self {
        if match Type::Never(_) = other {
            return true
        }
    }

    if match Type::Void(_) = self {
        if match Type::Void(_) = other {
            return true
        }
    }

    if match Type::Bool(_) = self {
        if match Type::Bool(_) = other {
            return true
        }
    }

    if match Type::U32(_) = self {
        if match Type::U32(_) = other {
            return true
        }
    }

    return false
}

fn Type::to_str(self): Result(str, &VoidError) {
    if match Type::Never(_) = self {
        return Ok("never")
    }
    if match Type::Null(_) = self {
        return Ok("null")
    }
    if match Type::Void(_) = self {
        return Ok("void")
    }
    if match Type::Bool(_) = self {
        return Ok("bool")
    }
    if match Type::U8(_) = self {
        return Ok("u8")
    }
    if match Type::I8(_) = self {
        return Ok("i8")
    }
    if match Type::U16(_) = self {
        return Ok("u16")
    }
    if match Type::I16(_) = self {
        return Ok("i16")
    }
    if match Type::U32(_) = self {
        return Ok("u32")
    }
    if match Type::I32(_) = self {
        return Ok("i32")
    }
    if match Type::F32(_) = self {
        return Ok("f32")
    }
    if match Type::U64(_) = self {
        return Ok("u64")
    }
    if match Type::I64(_) = self {
        return Ok("i64")
    }
    if match Type::F64(_) = self {
        return Ok("f64")
    }
    return Err(VoidError::VALUE)
}

type TypeLayout = struct {
    primitives_count: u32,
    primitives: &?Vec(Type),
    byte_size: u32,
    alignment: u32,
}

fn TypeLayout::new(): TypeLayout {
    return TypeLayout {
        primitives_count: 0,
        primitives: null,
        byte_size: 0,
        alignment: 1,
    }
}

type PointerType = struct {
    pointee: TypeId,
    is_sequence: bool,
    is_nullable: bool,
}

type StructType = struct {
    struct_index: u32,
}

type EnumType = struct {
    enum_index: u32,
}

type SegType = struct {
    item: TypeId,
}

type ResultType = struct {
    ok: TypeId,
    err: TypeId,
}

type ContainerType = struct {
    container: TypeId,
    items: &Vec(TypeId),
}

type ScopeKind = enum {
    Global,
    Function,
    Block,
    Loop,
    ForLoop,
    InlineFn,
}

type TySymbolKind = enum {
    TypeAlias,
    Struct,
    Enum,

    Local,
    Global,
    Const,

    InlineFn,
    Function,
    EnumConstructor,
}

type VariableKind = enum {
    Readonly,
    ReadWrite,
    ReadWriteStored,
}

type TySymbol = struct {
    ctx_id: u32,
    name: str,
    kind: TySymbolKind,
    col_index: u32,
    loc: Loc,
    defining_fn_index: &?u32, // used for accidental capture checks
}

type TyContext = struct {
    module_id: u32,
    id: u32,
    parent: &?TyContext,
    kind: ScopeKind,
    fn_index: &?u32,
    expr_id_offset: u32,
    symbols: &Vec(TySymbol),
    symbols_lookup: &Map(&str, u32),

    inline_fn_call_loc: &?Loc,
    is_expr_referenced: bool,
}

fn TyContext::add_symbol(&self, symbol: TySymbol) {
    // TODO: port:
    // self.symbols_lookup.insert(symbol.name, self.symbols.len)

    self.symbols.push!(symbol)
}

type TyModuleInfo = struct {
    ctx: &TyContext,
}

type TypeResolution = enum {
    NotStarted,
    InProgress,
    Resolved,
}

type TyTypeAlias = struct {
    ctx: &TyContext,
    type_id: TypeId,
    expr: &TypeExpr,
    resolution: TypeResolution,
}

type Typer = struct {
    // context
    registry: &Registry,
    reporter: &Reporter,

    // state
    contexts: StableVec(TyContext),
    module_info: &Vec(TyModuleInfo),
    type_aliases: &Vec(TyTypeAlias),
    allocated_strings: &Vec(String),
    forbid_memory_loc: &?Loc,
    autodefine_memory: bool,
}

fn Typer::new(registry: &Registry): &Typer {
    return heap::new!(Typer {
        registry: registry,
        reporter: registry.reporter,

        contexts: StableVec::new!<TyContext>(),
        module_info: Vec::new!<TyModuleInfo>(),
        type_aliases: Vec::new!<TyTypeAlias>(),
        allocated_strings: Vec::new!<String>(),
        forbid_memory_loc: null,
        autodefine_memory: false,
    })
}

fn Typer::type_all(&self) {
    let global_ctx = self.contexts.push!(TyContext {
        module_id: u32::MAX, // global scope has no module
        id: 0,
        parent: null,
        kind: ScopeKind::Global,
        fn_index: null,
        expr_id_offset: 0,
        symbols: Vec::new!<TySymbol>(),
        symbols_lookup: Map::new!<&str, u32>(),

        inline_fn_call_loc: null,
        is_expr_referenced: false,
    })

    self.module_info.reserve(self.registry.modules.len)
    for module in self.registry.modules.iter!() {
        let module_ctx = self.child_ctx(global_ctx, ScopeKind::Global)
        module_ctx.module_id = module.id

        self.module_info.push!(TyModuleInfo { ctx: module_ctx })
    }

    self.extend_expr_info_storage(self.registry.expr_id_count)

    self.add_builtin_type(global_ctx, Type::Never)
    self.add_builtin_type(global_ctx, Type::Void)
    self.add_builtin_type(global_ctx, Type::Bool)
    self.add_builtin_type(global_ctx, Type::U8)
    self.add_builtin_type(global_ctx, Type::I8)
    self.add_builtin_type(global_ctx, Type::U16)
    self.add_builtin_type(global_ctx, Type::I16)
    self.add_builtin_type(global_ctx, Type::U32)
    self.add_builtin_type(global_ctx, Type::I32)
    self.add_builtin_type(global_ctx, Type::F32)
    self.add_builtin_type(global_ctx, Type::U64)
    self.add_builtin_type(global_ctx, Type::I64)
    self.add_builtin_type(global_ctx, Type::F64)

    for module_id in self.registry.module_import_order.iter!() {
        self.collect_own_symbols(self.module_info.get!(module_id).ctx)
    }

    for module_id in self.registry.module_import_order.iter!() {
        self.collect_included_symbols(self.module_info.get!(module_id).ctx)
    }

    for &type_alias in self.type_aliases.iter!() {
        self.resolve_type_alias(type_alias)
    }

    for &struct_def in self.registry.structs.iter!() {
        let _ = self.resolve_struct_layout(struct_def)
    }

    for &enum_def in self.registry.enums.iter!() {
        self.resolve_enum_body(enum_def)
    }

    self.resolve_str_literal_type()

    for module_id in self.registry.module_import_order.iter!() {
        self.process_top_level_exprs(self.module_info.get!(module_id).ctx)
    }

    self.type_fns()

    self.run_delayed_actions()
}

fn Typer::collect_own_symbols(&self, ctx: &TyContext) {
    let module = self.registry.modules.get!(ctx.module_id)

    for expr in module.parser.ast.iter!() {
        if match TopLevelExpr::Intrinsic(_) = expr {
            continue // skip, not interested
        }

        if match TopLevelExpr::TypeDef(type_def) = expr {
            if match TypeDefValue::Struct(struct_value) = type_def.value {
                let _ = self.define_symbol(
                    ctx,
                    type_def.name.repr,
                    TySymbolKind::Struct,
                    type_def.name.loc,
                )

                self.registry.structs.push!(StructDef {
                    ctx: ctx,
                    struct_name: type_def.name.repr,
                    fields: Vec::new!<StructField>(),
                    field_defs: struct_value.fields,
                    resolution: TypeResolution::NotStarted,
                })
            }

            // TODO: port TypeDefValue::Enum
            continue
        }

        if match TopLevelExpr::Fn(fn_def) = expr {
            if fn_def.is_inline {
                continue // TODO: port
            }

            let _ = self.define_symbol(
                ctx,
                fn_def.decl.fn_name.repr,
                TySymbolKind::Function,
                fn_def.decl.fn_name.loc,
            )

            if match FnExprValue::Body(body) = fn_def.value {
                let exported_as = Vec::new!<String>()
                if fn_def.exported {
                    exported_as.push!(String::from_str(fn_def.decl.fn_name.repr))
                }

                self.registry.functions.push!(FnInfo {
                    name: fn_def.decl.fn_name.repr,
                    type_: FnType {
                        inputs: Vec::new!<TypeId>(),
                        output: self.intern_type(Type::Void),
                    },
                    params: Vec::new!<FnParameter>(),
                    source: FnSource::Guest(heap::new!(FnSourceGuest {
                        module_id: module.id,
                        lo_fn_index: self.registry.functions.len,
                        body: body,
                    })),
                    exported_as: exported_as,
                    locals_ids: Vec::new!<u32>(),
                    wasm_fn_index: u32::MAX, // placeholder
                    wasm_locals_count: 0,
                    definition_loc: fn_def.decl.fn_name.loc,
                })
            }

            if match FnExprValue::ImportFrom(imported_from) = fn_def.value {
                let module_name = (*imported_from).get_value(module.source)
                let method_name = fn_def.decl.fn_name.parts.get!(fn_def.decl.fn_name.parts.len - 1u32)
                let external_fn_name = method_name.read_span(module.source)
                let placeholder_fn_output = self.intern_type(Type::Void)

                self.registry.functions.push!(FnInfo {
                    name: fn_def.decl.fn_name.repr,
                    type_: FnType {
                        inputs: Vec::new!<TypeId>(),
                        output: placeholder_fn_output,
                    },
                    params: Vec::new!<FnParameter>(),
                    source: FnSource::Host(heap::new!(FnSourceHost {
                        module_name: module_name.clone(),
                        external_fn_name: external_fn_name,
                    })),
                    exported_as: Vec::new!<String>(),
                    locals_ids: Vec::new!<u32>(),
                    wasm_fn_index: u32::MAX, // placeholder
                    wasm_locals_count: 0,
                    definition_loc: fn_def.decl.fn_name.loc,
                })
            }
        }

        if match TopLevelExpr::Let(let_expr) = expr {
            if let_expr.is_inline {
                let _ = self.define_symbol(
                    ctx,
                    let_expr.name.repr,
                    TySymbolKind::Const,
                    let_expr.name.loc,
                )

                self.registry.constants.push!(ConstDef {
                    type_id: self.intern_type(Type::Never), // placeholder
                    expr: let_expr.value,
                    inner_expr_id_offset: ctx.expr_id_offset,
                })
                continue
            }

            let _ = self.define_symbol(
                ctx,
                let_expr.name.repr,
                TySymbolKind::Global,
                let_expr.name.loc,
            )

            self.registry.globals.push!(GlobalDef {
                module_id: module.id,
                value: let_expr.value,
                type_id: self.intern_type(Type::Never), // placeholder
                wasm_global_index: 0, // placeholder
            })
        }

        // TODO: port
    }
}

fn Typer::collect_included_symbols(&self, ctx: &TyContext) {
    self.collect_included_symbols_(ctx, ctx, String::from_str(""), true)
}

fn Typer::collect_included_symbols_(
    &self,
    includer: &TyContext,
    includee: &TyContext,
    prefix: String,
    force_go_deeper: bool,
) {
    if includer.module_id != includee.module_id {
        for symbol in includee.symbols.iter!() {
            let included_symbol = symbol

            if prefix.len() != 0 {
                // TODO: port
            }

            // TODO: port (report redefinition if included_symbol conflicts with an existing one)

            includer.add_symbol(included_symbol)
        }
    }

    let original_prefix_len = prefix.len()
    for include in self.registry.modules.get!(includee.module_id).includes.iter!() {
        if !(include.with_extern || force_go_deeper) {
            continue
        }

        if include.alias != null {
            prefix.push_str((*include.alias).as_str())
            prefix.push_str("::")
        }

        let sub_includee = self.module_info.get!(include.module_id)
        self.collect_included_symbols_(includer, sub_includee.ctx, prefix, false)
        prefix.truncate(original_prefix_len)
    }
}

fn Typer::resolve_type_alias(&self, type_alias: &TyTypeAlias) {
    // TODO: port
}

fn Typer::resolve_struct_layout(&self, struct_def: &StructDef): bool {
    if struct_def.resolution == TypeResolution::Resolved {
        return true
    }

    if struct_def.resolution == TypeResolution::InProgress {
        struct_def.resolution = TypeResolution::Resolved
        return false
    }

    struct_def.resolution = TypeResolution::InProgress

    let struct_layout = TypeLayout::new()

    for field in struct_def.field_defs.iter!() {
        let is_redefined = false
        for existing_field in struct_def.fields.iter!() {
            if existing_field.field_name.equals(field.field_name.repr) {
                let message = String::from_str_in(
                    self.registry.error_arena,
                    "Cannot redefine struct field '",
                )
                do message.push_str(it) with (
                    field.field_name.repr,
                    "', previously defined at ",
                    existing_field.loc.to_string_in(self.registry.error_arena, self.registry).as_str(),
                )

                self.report_error(self.registry.error_arena.new!(Error {
                    message: message,
                    loc: field.field_name.loc,
                }))
                is_redefined = true
                break
            }
        }
        if is_redefined {
            continue
        }

        let field_type_result = self.build_type(struct_def.ctx, field.field_type)
        let field_type_id = self.intern_type(Type::Never)
        if field_type_result.err as u32 == 0 {
            field_type_id = field_type_result.ok
        } else {
            self.report_error(field_type_result.err)
        }

        // TODO: port inspection

        let ok = self.resolve_type_size(struct_def.ctx, field_type_id)
        if !ok {
            self.report_error(self.registry.error_arena.new!(Error {
                message: String::from_str_in(
                    self.registry.error_arena,
                    "Cannot determite size of recursive type",
                ),
                loc: field.field_type.loc(),
            }))
            continue
        }

        let field_layout = ref!(TypeLayout::new())
        Typer::get_type_layout(self.registry, self.get_type(field_type_id), field_layout)

        let field_index = struct_layout.primitives_count
        struct_layout.primitives_count += field_layout.primitives_count
        struct_layout.alignment = u32::max!(struct_layout.alignment, field_layout.alignment)

        struct_def.fields.push!(StructField {
            field_name: field.field_name.repr,
            field_type_id: field_type_id,
            field_layout: *field_layout,
            field_index: field_index,
            byte_offset: 0, // placeholder, updated when fields are aligned
            loc: field.field_name.loc,
        })
    }

    // align fields
    for &field in struct_def.fields.iter!() {
        struct_layout.byte_size = Typer::align(struct_layout.byte_size, field.field_layout.alignment)

        field.byte_offset = struct_layout.byte_size
        struct_layout.byte_size += field.field_layout.byte_size
    }

    struct_def.resolution = TypeResolution::Resolved
    return true
}

fn Typer::resolve_type_size(&self, ctx: &TyContext, type_id: TypeId): bool {
    let type_ = self.get_type(type_id)

    if match Type::Result(result) = type_ {
        return self.resolve_type_size(ctx, result.ok) && self.resolve_type_size(ctx, result.err)
    }

    if match Type::Container(ctr) = type_ {
        return self.resolve_type_size(ctx, ctr.container)
    }

    if match Type::Struct(struct_type) = type_ {
        let struct_def = self.registry.structs.at!(struct_type.struct_index)
        return self.resolve_struct_layout(struct_def)
    }

    return true
}

