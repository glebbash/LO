type Point2D = struct {
    x: i32,
    y: i32,
}

type Point2DPair = struct {
    p1: Point2D,
    p2: Point2D,
}

export fn main(): i32 {
    let res = +0
    res += Point2D { x: +1, y: +2 }.x // +1
    res += get_pos().y // +4
    let tmp = get_point_pair().p1
    res += tmp.y // +6
    res += get_point_pair().p2.x // +7
    return res // = 18
}

fn get_point_pair(): Point2DPair {
    return Point2DPair {
        p1: Point2D { x: +5, y: +6 },
        p2: Point2D { x: +7, y: +8 },
    }
}

fn get_pos(): Point2D {
    return Point2D { x: +3, y: +4 }
}
