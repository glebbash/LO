@include("./std.lo")
@include("./wasi.lo")
@include("./print.lo")

// fs expects host to preopen "." on fd 3
inline let fs::CWD_PREOPEN_FD = 3

inline fn fs::read_file!(file_name: str): String {
    fs::read_file(file_name) catch err {
        eprint("Error reading file '")
        eprint(file_name)
        eprint("': code ")
        eprint(err.to_tmp_str!())
        eprint("\n")
        wasi::proc_exit(1)
    }
}

fn fs::read_file(file_name: str): Result(String, wasi::Err) {
    fs::_unlock()
    let fd = fs::open(file_name)?
    defer let _ = wasi::fd_close(fd)
    return Ok(String::from_chars(fs::read_fd(fd)?))
}

let fs::unlocked = false

// https://github.com/microsoft/vscode-wasm/issues/161
fn fs::_unlock() {
    if fs::unlocked {
        return
    }
    let err = 0
    defer if err != 0 {
        eprint("Error unlocking fs: code ")
        eprint(err.to_tmp_str!())
        eprint("\n")
        wasi::proc_exit(1)
    }
    let prestat = tmp_alloc!<wasi::prestat>()
    err = wasi::fd_prestat_get(fs::CWD_PREOPEN_FD, prestat)
    if err != wasi::Err::SUCCESS {
        return
    }
    let dir_path = tmp_alloc_many!<u8>(prestat.pr_name_len)
    err = wasi::fd_prestat_dir_name(
        fs::CWD_PREOPEN_FD,
        dir_path,
        prestat.pr_name_len,
    )
    if err != wasi::Err::SUCCESS {
        return
    }

    stack::align_for_wasmtime!(8)
    let fdstat = tmp_alloc!<wasi::fdstat>()
    err = wasi::fd_fdstat_get(fs::CWD_PREOPEN_FD, fdstat)
    if err != wasi::Err::SUCCESS {
        return
    }
    let prestat2 = tmp_alloc!<wasi::prestat>()
    let _ = wasi::fd_prestat_get(fs::CWD_PREOPEN_FD + 1, prestat2)
    fs::unlocked = true
}

fn fs::open(file_path: str): Result(u32, wasi::Err) {
    let fd_ref = tmp_alloc!<u32>()
    let err = wasi::path_open(
        fs::CWD_PREOPEN_FD,
        1,
        file_path.ptr,
        file_path.len,
        0,
        264_240_830u64,
        268_435_455u64,
        0,
        fd_ref,
    )
    if err != wasi::Err::SUCCESS {
        return Err(err)
    }
    return Ok(*fd_ref)
}

fn fs::read_fd(fd: u32): Result(&Vec(u8), wasi::Err) {
    let output = Vec::with_capacity!<u8>(256)
    let chunk = tmp_alloc_many!<u8>(256)
    let in_vec = tmp_alloc!<wasi::IOVec>()
    *in_vec = wasi::IOVec {
        base: chunk,
        size: 256,
    }
    let nread_ref = tmp_alloc!<u32>()
    loop {
        let err = wasi::fd_read(fd, in_vec as &[]wasi::IOVec, 1, nread_ref)
        if err != wasi::Err::SUCCESS {
            // stdin is empty
            if fd == 0 && err == wasi::Err::AGAIN {
                break
            }

            return Err(err)
        }
        let nread = *nread_ref
        if nread == 0 {
            break
        }
        output.push_all(chunk, nread)
    }
    return Ok(output)
}

fn fs::pipe(fd_in: u32, fd_out: u32, chunk_size: u32): Result(void, wasi::Err) {
    let chunk = tmp_alloc_many!<u8>(chunk_size)
    let iov = tmp_alloc!<wasi::IOVec>()
    *iov = wasi::IOVec { base: chunk, size: 0 }

    let iovs = iov as &[]wasi::IOVec
    let nread_ref = tmp_alloc!<u32>()
    loop {
        iov.size = chunk_size
        let err = wasi::fd_read(fd_in, iovs, 1, nread_ref)
        if err != wasi::Err::SUCCESS {
            return Err(err)
        }
        let nread = *nread_ref
        if nread == 0 {
            break
        }
        iov.size = nread
        err = wasi::fd_write(fd_out, iovs, 1, nread_ref)
        if err != wasi::Err::SUCCESS {
            return Err(err)
        }
    }
    return Ok()
}

fn fs::close(fd: u32): Result(void, wasi::Err) {
    let err = wasi::fd_close(fd)
    if err != wasi::Err::SUCCESS {
        return Err(err)
    }
    return Ok()
}

fn fs::create_dir(dir_path: str): Result(void, wasi::Err) {
    let err = wasi::path_create_directory(fs::CWD_PREOPEN_FD, dir_path.ptr, dir_path.len)
    if err != wasi::Err::SUCCESS && err != wasi::Err::EXIST {
        return Err(err)
    }
    return Ok()
}

// creates every directory segment of `file_path`, except the file name itself
fn fs::create_parent_dirs(file_path: str): Result(void, wasi::Err) {
    let parts = file_path.split('/', Vec::new!<str>())
    defer parts.free()

    let dir_path = String::new(file_path.len)
    defer dir_path.free()

    for i in 0..(parts.len - 1) {
        if i != 0 {
            dir_path.push_str("/")
        }
        dir_path.push_str(parts.get!(i))
        fs::create_dir(dir_path.as_str())?
    }

    return Ok()
}

fn fs::create_file_exclusive(file_path: str): Result(u32, wasi::Err) {
    let fd_ref = tmp_alloc!<u32>()
    let err = wasi::path_open(
        fs::CWD_PREOPEN_FD,
        1,
        file_path.ptr,
        file_path.len,
        wasi::OFLAGS_CREAT | wasi::OFLAGS_EXCL,
        268_435_455u64,
        268_435_455u64,
        0,
        fd_ref,
    )
    if err != wasi::Err::SUCCESS {
        return Err(err)
    }
    return Ok(*fd_ref)
}

fn fs::write_fd(fd: u32, data: seg(u8)): Result(void, wasi::Err) {
    let iovs = tmp_alloc_many!<wasi::IOVec>(1)
    let nwritten_ref = tmp_alloc!<u32>()

    let offset = 0u32
    while offset < data.len {
        *(iovs as &wasi::IOVec) = wasi::IOVec {
            base: (data.ptr as u32 + offset) as &[]u8,
            size: data.len - offset,
        }
        let err = wasi::fd_write(fd, iovs, 1, nwritten_ref)
        if err != wasi::Err::SUCCESS {
            return Err(err)
        }
        offset += *nwritten_ref
    }

    return Ok()
}

// writes `content` to `file_path`, creates parent dirs,
// does nothing and does not error if the file already exists
fn fs::write_new_file(file_path: str, content: seg(u8)): Result(void, wasi::Err) {
    fs::_unlock()
    fs::create_parent_dirs(file_path)?

    let fd = fs::create_file_exclusive(file_path) catch err {
        if err == wasi::Err::EXIST {
            return Ok()
        }
        return Err(err)
    }
    defer let _ = wasi::fd_close(fd)

    return fs::write_fd(fd, content)
}

// directory listing

type fs::DirEntry = struct {
    name: String,
    is_dir: bool,
}

fn fs::DirEntry::free(self) {
    self.name.free()
}

// lists the immediate (non-recursive) entries of a directory
fn fs::list_dir(dir_path: str): Result(&Vec(fs::DirEntry), wasi::Err) {
    fs::_unlock()

    let fd = fs::open(dir_path)?
    defer let _ = wasi::fd_close(fd)

    let entries = Vec::new!<fs::DirEntry>()

    // each entry is a `wasi::dirent` header followed by `d_namlen` bytes of the file name
    let header_size = sizeof wasi::dirent
    let cookie = 0u64
    let buf_cap = 4096u32
    loop {
        // TODO?: try a version where inline fns always bind their arguments to locals before call
        // snapshotted into its own immutable local because `tmp_alloc_many!`'s `defer`
        // re-reads this expression at flush time (`continue` below), not at alloc time -
        // mutating `buf_cap` itself before that flush would free the wrong size
        let this_cap = buf_cap
        let bufused_ref = tmp_alloc!<u32>()
        let buf = tmp_alloc_many!<u8>(this_cap)

        let err = wasi::fd_readdir(fd, buf, this_cap, cookie, bufused_ref)
        if err != wasi::Err::SUCCESS {
            return Err(err)
        }

        let bufused = *bufused_ref
        let data = str { ptr: buf, len: bufused }

        let offset = 0u32
        let truncated = false
        while offset < bufused {
            if offset + header_size > bufused {
                truncated = true
                break
            }

            let entry = (data.ptr as u32 + offset) as &wasi::dirent
            let name_len = entry.d_namlen

            if offset + header_size + name_len > bufused {
                truncated = true
                break
            }

            let entry_name = data.slice(offset + header_size, offset + header_size + name_len)

            if !entry_name.equals(".") && !entry_name.equals("..") {
                entries.push!(fs::DirEntry {
                    name: String::from_str(entry_name),
                    is_dir: entry.d_type as u32 == wasi::FILETYPE_DIRECTORY,
                })
            }

            cookie = entry.d_next
            offset += header_size + name_len
        }

        if truncated {
            // last entry didn't fit: grow the buffer and retry from the same `cookie`
            buf_cap = this_cap * 2
            continue
        }

        if bufused < this_cap {
            break // reached the end of the directory
        }
    }

    return Ok(entries)
}

// recursively lists paths of all regular files found under `dir_path` (relative to `dir_path`)
fn fs::list_files_recursive(dir_path: str): Result(&Vec(String), wasi::Err) {
    let output = Vec::new!<String>()
    fs::_list_files_recursive_into(dir_path, "", output)?
    return Ok(output)
}

fn fs::_list_files_recursive_into(
    base_dir: str,
    rel_dir: str,
    output: &Vec(String),
): Result(void, wasi::Err) {
    let current_dir = String::new(base_dir.len + 1 + rel_dir.len)
    defer current_dir.free()
    current_dir.push_str(base_dir)
    if rel_dir.len != 0 {
        current_dir.push_str("/")
        current_dir.push_str(rel_dir)
    }

    let entries = fs::list_dir(current_dir.as_str())?
    defer entries.free_deep!()

    for entry in entries.iter!() {
        let rel_path = String::new(rel_dir.len + 1 + entry.name.len())
        if rel_dir.len != 0 {
            rel_path.push_str(rel_dir)
            rel_path.push_str("/")
        }
        rel_path.push_str(entry.name.as_str())

        if entry.is_dir {
            fs::_list_files_recursive_into(base_dir, rel_path.as_str(), output)?
            rel_path.free()
        } else {
            output.push!(rel_path)
        }
    }

    return Ok()
}
