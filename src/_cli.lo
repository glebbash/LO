// NOTE: this file is the project entry point. '_' prefix is used to
//   force it to the top of `ls` output

@include("../lib/args.lo")
@include("../lib/wasi.lo")

@include("./common.lo")
@include("./lexer.lo")
@include("./registry.lo")
@include("./printer.lo")
@include("./typer.lo")
@include("./codegen.lo")

@use_memory(min_pages = 20, exported)

inline let ASSETS_SRC = @embed_files("../src")
inline let ASSETS_LIB = @embed_files("../lib")
inline let ASSETS_TEST = @embed_files("../test")

inline let USAGE = "Usage:
  lo compile <input.lo> // compiles source file to a WASM binary
  lo inspect <input.lo> // emits JSON inspections
  lo format  <input.lo> // prints formatted version of the source
  lo flatten <input.lo> // prints the source with all includes inlined
  lo eject              // unpacks bundled compiler sources and tests, never overwrites files"

export fn _start() {
    let args = Args::load()
    defer args.free()

    let registry = Registry::new()
    defer registry.free()

    add_embedded_folder!(registry, ASSETS_SRC, "src")
    add_embedded_folder!(registry, ASSETS_LIB, "lib")
    add_embedded_folder!(registry, ASSETS_TEST, "test")

    if args.argc == 2 && args.get(1).equals("eject") {
        for file in registry.embedded_files.iter!() {
            let file_path = file.path.skip_chars(Registry::EMBEDDED_PREFIX.len)

            fs::write_new_file(file_path, file.content.iter!()) catch err {
                eprint("Error writing file '")
                eprint(file_path)
                eprint("': code ")
                eprint(err.to_tmp_str!())
                eprint("\n")
                wasi::proc_exit(1)
            }
        }
        return
    }

    if args.argc < 3 {
        stderr_writeln(USAGE)
        wasi::proc_exit(1)
    }

    let command = args.get(1)
    let file_name = args.get(2)
    if file_name.equals("-i") {
        file_name = "<stdin>"
    }

    if command.equals("format") {
        registry.in_single_file_mode = true

        let module_id = registry.include(file_name, Loc::internal()) catch _ {
            wasi::proc_exit(1)
        }

        let printer = Printer::new(registry.modules.get!(module_id).parser)
        defer printer.free()

        printer.print_file()

        return
    }

    if command.equals("inspect") {
        registry.reporter.begin_inspection()
    }

    let _ = registry.include(file_name, Loc::internal())

    if command.equals("flatten") {
        for module in registry.modules.iter!() {
            if module.id == 0 {
                continue
            }

            if module.id > 1 {
                stdout_write("\n")
            }

            stdout_write("//// file: ")
            stdout_write(module.absolute_path.as_str())
            stdout_write("\n\n")

            let printer = Printer::new(registry.modules.get!(module.id).parser)
            printer.comment_includes = true
            printer.print_file()
            printer.free()
        }

        return
    }

    let typer = Typer::new(registry)
    typer.type_all()

    if registry.reporter.in_inspection_mode {
        registry.reporter.end_inspection()

        if registry.reporter.error_count == 0 {
            return
        }
    }

    if registry.reporter.error_count > 0 {
        wasi::proc_exit(1)
    }

    let codegen = Codegen::new(registry)
    codegen.codegen_all()

    if command.equals("compile") {
        let binary = Vec::new!<u8>()
        codegen.wasm_module.dump(binary)
        stdout_write(String::from_chars(binary).as_str())
        return
    }

    do stderr_write(it) with (
        "Unknown command: ", \\ command, \\ "\n",
        USAGE, \\ "\n",
    )
    wasi::proc_exit(1)
}

inline fn add_embedded_folder!(registry: &Registry, files: infer(T), dir_name: str) {
    for file in files {
        registry.add_embedded_file(dir_name, file.name, file.content as str)
    }
}
