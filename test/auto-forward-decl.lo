export fn main(): u32 {
    // auto forward decl
    let a = A {
        // auto forward decl
        b: B { x: 42, a: null as &A },
    }
    // auto forward decl
    return calc_answer(a)
}

// auto forward decl for parameters (including struct values)
fn calc_answer(a: A): u32 {
    return a.b.x
}

type A = struct {
    // auto forward decl
    b: B,
}

type B = struct {
    x: u32,
    // auto forward decl (allowed for struct pointers)
    a: &A,
}
